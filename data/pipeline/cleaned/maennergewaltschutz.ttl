cdp:maennergewaltschutz-10569 cdp:fromSource cdp:maennergewaltschutzSource;
    cdp:targetSchema cdp:angebotSchema;
    xyz:id "10569";
    xyz:angebotstyp "geschlechtsunabhängige Schutzwohnungen";
    xyz:description "Die AWO Fachstelle Vera bietet anonyme Schutzwohnungen für hochgefährdete von Zwangsverheiratung und ehrbezogener Gewalt betroffene Frauen* und Paare mit Kindern an. Die Mitarbeiterinnen der Schutzwohnungen beraten, begleiten und unterstützen unter anderem bei der psychischen Stabilisierung, der Anonymisierung und der Erarbeitung einer Zukunftsperspektive. Die Gewährleistung der Sicherheit und des Schutzes haben höchste Priorität. Aufgrund dessen unterliegt der Aufenthalt in den Schutzwohnungen hohen Sicherheitsvorkehrungen und verpflichtenden Maßnahmen zur Wahrung der Anonymität.";
    xyz:name "Vera – Fachstelle gegen Frauenhandel, Zwangsverheiratung und ehrbezogene Gewalt";
    xyz:streetAddress "Seepark 7";
    xyz:postalCode "39116";
    xyz:addressLocality "Magdeburg";
    xyz:telephone "039199977868";
    xyz:url "https://www.awo-sachsenanhalt.de/fachstelle-vera";
    cdp:providedBy <https://civic-data.de/pipeline#maennergewaltschutz-traeger-awo%20landesverband%20sachsen%20anhalt>;
    xyz:email "vera.schutzwohnung@awo-sachsenanhalt.de".
