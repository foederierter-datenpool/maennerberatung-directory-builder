cdp:emr-michael-steiner-weitsinn cdp:fromSource cdp:echteMaennerRedenSource;
    cdp:targetSchema cdp:angebotSchema;
    xyz:id "michael-steiner-weitsinn";
    xyz:person "Michael Steiner";
    xyz:description "Mein Name ist Michael Steiner. Ich bin systemischer Coach sowie Krisenberater für Jungen und Männer. Zudem arbeite ich seit vielen Jahren als Trainer für gewaltfreie Kommunikation und als Kursleiter für konstruktive Konfliktbearbeitung. Für verschiedene Weiterbildungsträger verantworte ich Workshop- und Kursangebote zu vielfältigen Themen der Persönlichkeitsentwicklung.";
    xyz:email "info@beratung-mit-weitsinn.de";
    xyz:category "Phaemoberater®", "Coach System und Spiritualität";
    cdp:providedBy cdp:emr-traeger-weitsinn.
