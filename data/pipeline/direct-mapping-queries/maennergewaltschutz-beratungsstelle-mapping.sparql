PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX cdf: <https://civic-data.de/federated-directory#>
PREFIX schema: <http://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>

INSERT {
    GRAPH <urn:mapped> {
        ?entity a cdf:CounselingCentre ; cdp:fromSource cdp:maennergewaltschutzSource .
        ?entity schema:identifier ?id .
        ?entity schema:name ?name .
        ?entity schema:description ?description .
        ?entity schema:streetAddress ?streetAddress .
        ?entity schema:postalCode ?postalCode .
        ?entity schema:addressLocality ?addressLocality .
        ?entity schema:telephone ?telephone .
        ?entity schema:email ?email .
        ?entity foaf:homepage ?url .
        ?entity schema:category ?angebotstyp .
    }
} WHERE {
    GRAPH <urn:source:maennergewaltschutz> {
        ?entity cdp:fromSource cdp:maennergewaltschutzSource .
        OPTIONAL { ?entity cdp:targetSchema ?_ts }
        FILTER(!bound(?_ts) || ?_ts = cdp:beratungsstelleSchema)
        OPTIONAL { ?entity xyz:id ?id . FILTER(isLiteral(?id) && REPLACE(STR(?id), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:name ?name . FILTER(isLiteral(?name) && REPLACE(STR(?name), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:description ?description . FILTER(isLiteral(?description) && REPLACE(STR(?description), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:streetAddress ?streetAddress . FILTER(isLiteral(?streetAddress) && REPLACE(STR(?streetAddress), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:postalCode ?postalCode . FILTER(isLiteral(?postalCode) && REPLACE(STR(?postalCode), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:addressLocality ?addressLocality . FILTER(isLiteral(?addressLocality) && REPLACE(STR(?addressLocality), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:telephone ?telephone . FILTER(isLiteral(?telephone) && REPLACE(STR(?telephone), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:email ?email . FILTER(isLiteral(?email) && REPLACE(STR(?email), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:url ?url . FILTER(isLiteral(?url) && REPLACE(STR(?url), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:angebotstyp ?angebotstyp . FILTER(isLiteral(?angebotstyp) && REPLACE(STR(?angebotstyp), "\\s+", "") != "") }
    }
}