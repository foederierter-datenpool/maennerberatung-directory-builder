PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX cdf: <https://civic-data.de/federated-directory#>
PREFIX schema: <http://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>

INSERT {
    GRAPH <urn:mapped> {
        ?entity a schema:Service ; cdp:fromSource cdp:echteMaennerRedenSource .
        ?entity schema:identifier ?id .
        ?entity schema:name ?person .
        ?entity schema:description ?description .
        ?entity schema:email ?email .
        ?entity schema:category ?category .
    }
} WHERE {
    GRAPH <urn:source:echteMaennerReden> {
        ?entity cdp:fromSource cdp:echteMaennerRedenSource .
        OPTIONAL { ?entity cdp:targetSchema ?_ts }
        FILTER(!bound(?_ts) || ?_ts = cdp:angebotSchema)
        OPTIONAL { ?entity xyz:id ?id . FILTER(isLiteral(?id) && REPLACE(STR(?id), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:person ?person . FILTER(isLiteral(?person) && REPLACE(STR(?person), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:description ?description . FILTER(isLiteral(?description) && REPLACE(STR(?description), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:email ?email . FILTER(isLiteral(?email) && REPLACE(STR(?email), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:category ?category . FILTER(isLiteral(?category) && REPLACE(STR(?category), "\\s+", "") != "") }
    }
}