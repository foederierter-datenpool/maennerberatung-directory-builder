PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX cdf: <https://civic-data.de/federated-directory#>
PREFIX schema: <http://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>

INSERT {
    GRAPH <urn:mapped> {
        ?entity a cdf:CounselingCentre ; cdp:fromSource cdp:maennerberatungsnetzSource .
        ?entity schema:identifier ?id .
        ?entity schema:name ?name .
        ?entity schema:telephone ?telefon .
        ?entity schema:email ?email .
        ?entity foaf:homepage ?website .
        ?entity schema:areaServed ?bundeslaender .
        ?entity schema:addressCountry ?land .
        ?entity schema:mainEntityOfPage ?permalink .
        ?entity schema:description ?beschreibung .
    }
} WHERE {
    GRAPH <urn:source:maennerberatungsnetz> {
        ?entity cdp:fromSource cdp:maennerberatungsnetzSource .
        OPTIONAL { ?entity cdp:targetSchema ?_ts }
        FILTER(!bound(?_ts) || ?_ts = cdp:beratungsstelleSchema)
        OPTIONAL { ?entity xyz:id ?id . FILTER(isLiteral(?id) && REPLACE(STR(?id), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:name ?name . FILTER(isLiteral(?name) && REPLACE(STR(?name), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:telefon ?telefon . FILTER(isLiteral(?telefon) && REPLACE(STR(?telefon), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:email ?email . FILTER(isLiteral(?email) && REPLACE(STR(?email), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:website ?website . FILTER(isLiteral(?website) && REPLACE(STR(?website), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:bundeslaender ?bundeslaender . FILTER(isLiteral(?bundeslaender) && REPLACE(STR(?bundeslaender), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:land ?land . FILTER(isLiteral(?land) && REPLACE(STR(?land), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:permalink ?permalink . FILTER(isLiteral(?permalink) && REPLACE(STR(?permalink), "\\s+", "") != "") }
        OPTIONAL { ?entity xyz:beschreibung ?beschreibung . FILTER(isLiteral(?beschreibung) && REPLACE(STR(?beschreibung), "\\s+", "") != "") }
    }
}