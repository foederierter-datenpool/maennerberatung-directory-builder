    prov:wasDerivedFrom cdp:maennerberatungsnetz-523.
_:n3-672 rdf:reifies <<(cdf:org-d6dfa9a57990 schema:description "<p data-start=\"0\" data-end=\"419\"><strong data-start=\"0\" data-end=\"33\">Deutsch </strong>Zigmal e.V. bietet vertrauliche und kostenlose Einzelgespräche für Männer mit Hans, systemischem Berater mit Heilpraktikererlaubnis. Im Pangea Haus finden sie in Kooperation mit <em data-start=\"608\" data-end=\"628\">Systemik im Dialog</em> statt, das den Raum stellt. Die Gespräche bieten einen geschützten Rahmen für Klärung, Reflexion und Orientierung – live an jedem 2. Dienstag im Monat, oder flexibel online.</p>\r\n<p data-start=\"0\" data-end=\"419\"><strong data-start=\"0\" data-end=\"33\">English </strong>Zigmal e.V. offers confidential and free of charge one-to-one sessions for men, led by Hans, a systemic counsellor licensed for psychotherapy. When held at Pangea Haus, the sessions take place in cooperation with <em data-start=\"230\" data-end=\"250\">Systemik im Dialog</em>, which provides the space. They offer a safe setting for personal clarity, reflection, and orientation — in person on the second Tuesday of the month, or for flexible online appointments.</p>")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-11648.
