_:n3-4776 rdf:reifies <<(cdf:org-2c153c9485d7 schema:name "Anstoß - Fachberatungsstelle gegen sexualisierte Gewalt an Jungen")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-405.
_:n3-4777 rdf:reifies <<(cdf:org-2c153c9485d7 schema:description "Die Beratungsstelle Anstoß ist eine Fachberatungsstelle zum Thema sexualisierte Gewalt an Jungen und männlichen Jugendlichen in Hannover. Wir beraten und unterstützen von sexualisierter Gewalt betroffene Jungen und deren Angehörige, bieten Fachberatung, Fortbildungen, Workshops und Präventionsveranstaltungen sowie Unterstützung für Selbsthilfegruppen an.")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-405.
