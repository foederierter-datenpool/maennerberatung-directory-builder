_:n3-7549 rdf:reifies <<(cdf:org-5229d9df3fd5 schema:description "Unser Beratungsangebot richtet sich an Jungen und Männer ab 14 Jahren, die sich z.B. in einer Lebenskrise befinden, eigene Gewaltwiderfahrnisse erlebt haben oder sich anlassbezogen in einem Gespräch von Mann zu Mann austauschen und beraten lassen wollen.")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-576.
_:n3-755 rdf:reifies <<(cdf:org-c1e43f82b0f7 schema:description "Ich berate Männer im Themenfeld der Sexualität. Typische Themen sind z.B. Potenzprobleme, Erektionsprobleme, vorzeitiger Samenerguss, Schmerzen beim Geschlechtsverkehr, Pornosucht, Chemsex, Fragen zur sexuellen Orientierung und Identität, Polysexualität, Safersex im BDSM,  usw.\r\n\r\n&nbsp;")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-12614.
