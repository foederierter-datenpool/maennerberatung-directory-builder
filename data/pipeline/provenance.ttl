_:n3-5952 rdf:reifies <<(cdf:org-c14a88b8cbd6 schema:name "PTBS Männergruppe")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-472.
_:n3-5953 rdf:reifies <<(cdf:org-c14a88b8cbd6 schema:description "\"Wir sind eine Gruppe Männer, die an einer komplexen posttraumatischen Belastungsstörung leiden. Wir verstehen uns als Selbsthilfegruppe. Die Gruppe trifft sich in verschiedenen Orten in Deutschland, meistens treffen wir uns in Goslar.\r\nDesweiteren setzt sich die Gruppe auf kommunaler, Landes- und auf Bundesebene für eine geschlechtsspezifische Traumabehandlung für Männer ein. Jeder Mann, der an einer komplexen posttraumatischen Belastungsstörung leidet, ist herzlich willkommen. Uns ist es egal welche Herkunft, Hautfarbe, Religion und sexuelle Identität der Betroffene hat.\"")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-472.
_:n3-5954 rdf:reifies <<(cdf:org-c14a88b8cbd6 schema:email "info@ptbs-maennergruppe.de")>>;
