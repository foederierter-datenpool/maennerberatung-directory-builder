_:n3-7381 rdf:reifies <<(cdf:org-d6b1a12655b8 schema:name "Psychotherapeutische Praxis Matthias Stinn")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-564.
_:n3-7382 rdf:reifies <<(cdf:org-d6b1a12655b8 schema:description "In meiner Praxis biete ich ambulante Psychotherapie für Menschen ab 18 Jahren an. Ich habe meinen Behandlungsschwerpunkt auf männerspezifische Psychotherapie gelegt. Ebenso habe ich mich auf die Beratung in Bezug auf die Themen „männliche Rollenbilder“ und „männliche Identität“ spezialisiert. Auf <a href=\"https://www.psychotherapie-matthias-stinn.de\">www.psychotherapie-matthias-stinn.de</a> finden Sie ausführliche Informationen bezüglich des Behandlungsschwerpunkts, zu meiner Person sowie meiner Haltung.")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-564.
_:n3-7383 rdf:reifies <<(cdf:org-d6b1a12655b8 schema:email "psychotherapie.matthias.stinn@gmail.com")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-564.
