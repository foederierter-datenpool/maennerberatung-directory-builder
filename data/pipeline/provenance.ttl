_:n3-7737 rdf:reifies <<(cdf:org-9a4d7b97d695 schema:name "esperanza - Schwangerschafts-, Eltern- und Väterberatung - Caritasverband für den OBK e.V.")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-590.
_:n3-7738 rdf:reifies <<(cdf:org-9a4d7b97d695 schema:description "Kostenfreies und vertrauliches Beratungsangebot im Rahmen der Schwangerschafts-, Eltern- und Väterberatung, bis zum dritten Lebensjahr des Kindes für den oberbergischen Kreis.\r\nWir bieten (werdenden) Vätern/Paaren vor und nach Geburt des Kindes psychosoziale Beratung an.\r\nWir unterstützen (werdende) Väter in schwierigen Situationen.\r\nWir informieren Sie zu Fragen rund um Schwangerschaft, Geburt, Vaterschaft, Unterhalt, Umgangspflichten und - rechten und über staatliche Hilfen.\r\nWir bieten sexualpädagogische Projekte an und beraten zu diesem Thema.")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-590.
_:n3-7739 rdf:reifies <<(cdf:org-9a4d7b97d695 schema:email "esperanza@caritas-oberberg.de")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-590.
