_:n3-7220 rdf:reifies <<(cdf:org-e7ff6d7f3c07 schema:name "Systemische Beratung | Martin Präßler")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-554.
_:n3-7221 rdf:reifies <<(cdf:org-e7ff6d7f3c07 schema:description "<div id=\"comp-mepy6hqr9\" class=\"N8MGzv _v6ohL ZS_qLz PO9MfV comp-mepy6hqr9 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Klarheit und neue Perspektiven</span></p>\r\n<p class=\"font_8 wixui-rich-text__text\"><br class=\"wixui-rich-text__text\" /><span class=\"wixui-rich-text__text\">Männer stehen heute oft vor der Herausforderung, unterschiedlichen Rollen und Erwartungen gerecht zu werden – im Beruf, in der Partnerschaft, in der Familie und im eigenen Selbstbild. In der Männerberatung biete ich Ihnen einen sicheren Raum, um über Themen zu sprechen, die Sie bewegen – offen, ohne Bewertung und auf Augenhöhe.</span></p>\r\n\r\n</div>\r\n<div id=\"comp-mepy6hqt4\" class=\"N8MGzv _v6ohL ZS_qLz PO9MfV comp-mepy6hqt4 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">​Einige Themenbeispiele aus der Praxis:</span></p>\r\n\r\n<ul class=\"font_8 wixui-rich-text__text\">\r\n \t<li class=\"wixui-rich-text__text\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Umgang mit Gefühlen und Emotionen (z.B. Einsamkeit, Trauer, Angst,...)</span></p>\r\n</li>\r\n \t<li class=\"wixui-rich-text__text\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Rollenkonflikte – \"Was für ein Mann will ich sein?\"</span></p>\r\n</li>\r\n \t<li class=\"wixui-rich-text__text\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Balance zwischen Partnerschaft, Beruf, Vaterschaft und eigenen Bedürfnissen</span></p>\r\n</li>\r\n \t<li class=\"wixui-rich-text__text\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Schwierigkeiten bei Dating und Partnerfindung </span></p>\r\n</li>\r\n \t<li class=\"wixui-rich-text__text\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Konflikte am Arbeitsplatz</span></p>\r\n</li>\r\n \t<li class=\"wixui-rich-text__text\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Körperbild und Selbstwahrnehmung</span></p>\r\n</li>\r\n \t<li class=\"wixui-rich-text__text\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Leistungsdruck</span></p>\r\n</li>\r\n</ul>\r\n</div>\r\n<div id=\"comp-mepy6hqv7\" class=\"N8MGzv _v6ohL ZS_qLz PO9MfV comp-mepy6hqv7 wixui-rich-text\" data-testid=\"richTextElement\">\r\n<p class=\"font_8 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Ob es um berufliche Belastung, Beziehungsthemen, Vaterschaft, Selbstwert oder persönliche Orientierung geht – wir entwickeln gemeinsam Lösungen, die zu Ihnen passen und Ihre eigenen Ressourcen stärken.</span></p>\r\n\r\n</div>")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-554.
