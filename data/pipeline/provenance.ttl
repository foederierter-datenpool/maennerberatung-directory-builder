_:n3-7583 rdf:reifies <<(cdf:org-3689f923ad38 schema:name "Berliner Zentrum für Gewaltprävention (BZfG) e.V. / Beratungszentrum zum Schutz vor Gewalt in Familien und im sozialen Nahfeld")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-580.
_:n3-7584 rdf:reifies <<(cdf:org-3689f923ad38 schema:description "Wir beraten alle Menschen, die im Zusammenhang mit ihren Familien, ihren Partnerschaften, ihren Kindern oder ihrem sozialen Nahfeld, Gewalt ausgeübt haben.\r\nDarüber hinaus bieten wir ein Unterstützungsangebot für die von häuslicher Gewalt mitbetroffenen Kinder und Jugendlichen.")>>;
    prov:wasDerivedFrom cdp:maennerberatungsnetz-580.
