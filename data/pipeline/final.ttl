    schema:postalCode "06884";
    schema:addressLocality "Dessau-Roßlau";
    schema:telephone "4915788118884";
    foaf:homepage "https://www.dfv-lsa.de/index.php?article_id=23";
    schema:areaServed "Sachsen-Anhalt";
    schema:addressCountry "Deutschland";
    schema:availableService "Einzelberatung", "Partner- / Gruppenberatung", "Täterberatung";
