cdf:org-b5f51fec0da1 a cdf:CounselingCentre;
    schema:name "Männerberatung Fleischer";
    schema:description "Ein Beratungsangebot <strong>Dietmar Fleischer </strong>für Jungen und Männer\r\n\r\nUnsere Gespräche finden in einer offenen Atmosphäre statt.\r\nAls Berater will ich Sie und Ihre Handlungen nicht bewerten. Im Prozess entwickeln wir gemeinsam Schritte, um Probleme zu bewältigen. Dabei ist es nicht wesentlich, mit welchen Themen Sie zu mir kommen.\r\n\r\n<strong> </strong>\r\n\r\n<strong>Das ist mein Job</strong>\r\n<ul>\r\n \t<li>Ich berate Männer, die sich in einer Krise befinden.</li>\r\n \t<li>Ich suche mit dem Klienten gemeinsam nach Verbesserungen</li>\r\n \t<li>Ich begleite den Klienten aus der Sprachlosigkeit</li>\r\n \t<li>Ich biete Einzelgespräche an.</li>\r\n</ul>\r\nIch berate Sie, wenn Sie sich in einer persönlichen Krise befinden.\r\n\r\nZum Beispiel:\r\n<ul>\r\n \t<li>Sie wissen nicht mehr weiter.</li>\r\n \t<li>Sie sind im Privatleben oder Beruf überfordert.</li>\r\n \t<li>Sie fühlen sich gemobbt.</li>\r\n \t<li>Sie sind gewalttätig oder haben Angst gewalttätig zu werden</li>\r\n</ul>";
    schema:email "maennerkraft@gmx.de";
    schema:mainEntityOfPage "https://maennerberatungsnetz.de/beratung/maennerberatung-fleischer/";
    schema:streetAddress "August Schmidt Straße 7";
    schema:postalCode "45327";
    schema:addressLocality "Essen";
    schema:telephone "+4915733127474";
    foaf:homepage "https://echte-männer-reden.de/berater/dietmar-fleischer/";
    schema:areaServed "Nordrhein-Westfalen";
    schema:addressCountry "Deutschland";
    schema:availableService "Einzelberatung".
