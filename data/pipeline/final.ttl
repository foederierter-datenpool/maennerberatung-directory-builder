    schema:areaServed "Niedersachsen";
    schema:addressCountry "Deutschland";
    schema:availableService "Einzelberatung", "Online-/ Telefonberatung", "Partner- / Gruppenberatung", "Psychologische Beratung";
    schema:parentOrganization cdf:traeger-bb0a1e2749a7.
cdf:org-6ee86c39293e a cdf:CounselingCentre;
    schema:name "Mann wird Vater";
    schema:description "Mann wird Vater ist ein Projekt für Kassel und den Landkreis Kassel, um Angebote für Väter im Rahmen der frühen Hilfen aufzubauen. Beratung für werdende Väter und Väter mit Kindern bis 3 Jahren, Crashkurse für werdende und frisch gebackene Väter. Aufbau von Angeboten für Väter im Wohnort. Strategieberatung bei Krisen.";
    schema:email "christoph.lyding@ekkw.de";
