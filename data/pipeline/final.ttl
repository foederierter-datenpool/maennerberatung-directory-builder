    schema:addressLocality "Osnabrück";
    schema:telephone "+4954120511397";
    foaf:homepage "https://www.skm-osnabrueck.de/maennerberatung";
    schema:areaServed "Niedersachsen";
    schema:addressCountry "Deutschland";
    schema:availableService "Einzelberatung", "Online-/ Telefonberatung", "Opferberatung", "Partner- / Gruppenberatung", "Gesprächskreis / Selbsthilfegruppe".
cdf:org-c14a88b8cbd6 a cdf:CounselingCentre;
    schema:name "PTBS Männergruppe";
    schema:description "\"Wir sind eine Gruppe Männer, die an einer komplexen posttraumatischen Belastungsstörung leiden. Wir verstehen uns als Selbsthilfegruppe. Die Gruppe trifft sich in verschiedenen Orten in Deutschland, meistens treffen wir uns in Goslar.\r\nDesweiteren setzt sich die Gruppe auf kommunaler, Landes- und auf Bundesebene für eine geschlechtsspezifische Traumabehandlung für Männer ein. Jeder Mann, der an einer komplexen posttraumatischen Belastungsstörung leidet, ist herzlich willkommen. Uns ist es egal welche Herkunft, Hautfarbe, Religion und sexuelle Identität der Betroffene hat.\"";
    schema:email "info@ptbs-maennergruppe.de";
    schema:mainEntityOfPage "https://maennerberatungsnetz.de/beratung/beratung-ptbs-maennergruppe/";
