    schema:addressLocality "Rüsselsheim";
    schema:telephone "4961429136724";
    foaf:homepage "https://ev-dekanat-gross-gerau-ruesselsheim.ekhn.de/ueber-uns/agg-beauftragter.html";
    schema:areaServed "Hessen";
    schema:addressCountry "Deutschland";
    schema:availableService "Einzelberatung", "Gesprächskreis / Selbsthilfegruppe", "Treff";
