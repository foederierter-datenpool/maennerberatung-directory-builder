    foaf:homepage "https://www.schutzraum-ev.de/cms/p/Beratungsstelle/";
    schema:addressCountry "Deutschland";
    schema:availableService "Einzelberatung", "Opferberatung", "Täterberatung", "Gesprächskreis / Selbsthilfegruppe";
    schema:parentOrganization cdf:traeger-f8ea34eef6e7.
