    schema:telephone "0383479830";
    foaf:homepage "https://www.caritas-vorpommern.de";
    schema:areaServed "Mecklenburg-Vorpommern";
    schema:addressCountry "Deutschland";
    schema:availableService "Einzelberatung", "Partner- / Gruppenberatung", "Psychologische Beratung".
