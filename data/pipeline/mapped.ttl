cdp:emr-achim-ja-gers-fundamentes-mobile-ma-nnerberatung-berlin cdp:fromSource cdp:echteMaennerRedenSource;
    a schema:Service;
    schema:identifier "achim-ja-gers-fundamentes-mobile-ma-nnerberatung-berlin";
    schema:name "Achim Jägers";
    schema:description "Ich bin Achim Jägers. Ich arbeite als Diplom Sozialarbeiter, Sexualpädagoge und zertifizierter Männerberater mit Jugendlichen und Erwachsenen. Meine Schwerpunkte sind: Beratung von jungen als auch älteren Männern/Vätern, die sich in Krisen befinden; allgemeine Beratung rund um das Thema Sexualität; Begleitung bei Missbrauchserfahrungen; Präventionskonzepte.";
    schema:email "acjaegers@gmx.de";
    schema:category "Sozialarbeiter/Sozialpädagoge", "Sexualpädagoge";
    schema:provider <https://civic-data.de/pipeline#emr-traeger-fundamentes%20mobile%20maennerberatung%20berlin>.
