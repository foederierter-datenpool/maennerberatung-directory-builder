cdp:maennerberatungsnetz-346 cdp:fromSource cdp:maennerberatungsnetzSource;
    a <https://civic-data.de/federated-directory#CounselingCentre>;
    schema:identifier "346";
    schema:name "Fachstelle Väter von Kindern mit Behinderung";
    schema:description "Väter von Kindern mit Behinderung fühlen sich oft von Angeboten der Behindertenhilfe nur wenig angesprochen. Wir entwickeln spezifische Angebote für Väter von Kindern mit Behinderung und führen diese mit Kooperationspartnern durch. Für Einrichtungen der Eingliederungshilfe stehen wir gerne beratend zur Seite, wenn diese Ihre Konzeptionen gendersensibel fortschreiben möchten.\r\nWir freuen uns über Ihr Interesse!";
    schema:email "vaeter@langau.de";
    schema:streetAddress "Langau 1";
    schema:postalCode "86989";
    schema:addressLocality "Steingaden";
    schema:telephone "+498862910213";
    foaf:homepage "https://www.fachstelle-vaeter.de";
    schema:areaServed "Bayern";
