cdp:maennerberatungsnetz-590 cdp:fromSource cdp:maennerberatungsnetzSource;
    a <https://civic-data.de/federated-directory#CounselingCentre>;
    schema:identifier "590";
    schema:name "esperanza - Schwangerschafts-, Eltern- und Väterberatung - Caritasverband für den OBK e.V.";
    schema:description "Kostenfreies und vertrauliches Beratungsangebot im Rahmen der Schwangerschafts-, Eltern- und Väterberatung, bis zum dritten Lebensjahr des Kindes für den oberbergischen Kreis.\r\nWir bieten (werdenden) Vätern/Paaren vor und nach Geburt des Kindes psychosoziale Beratung an.\r\nWir unterstützen (werdende) Väter in schwierigen Situationen.\r\nWir informieren Sie zu Fragen rund um Schwangerschaft, Geburt, Vaterschaft, Unterhalt, Umgangspflichten und - rechten und über staatliche Hilfen.\r\nWir bieten sexualpädagogische Projekte an und beraten zu diesem Thema.";
    schema:email "esperanza@caritas-oberberg.de";
    schema:telephone "2261306140";
    foaf:homepage "https://www.caritas-oberberg.de/hilfen-angebote/schwangerschaft/ueberblick/";
    schema:areaServed "Nordrhein-Westfalen";
