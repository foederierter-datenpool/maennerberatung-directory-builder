    a schema:Service;
    schema:identifier "norbert-pla-wilm-skf-hochsauerland";
    schema:name "Norbert Plaßwilm";
    schema:description "Ich bin Norbert Plaßwilm und arbeite als Heilpädagoge in der Familien- und Erziehungsberatungsstelle. Hier arbeite ich auch als Männerberater. Meine Schwerpunkte in der Väter- und Männerberatung sind: Täter und Opferberatung. Männer in Krisen nach Jobverlust, Trennung und Scheidung und alle anderen Problemlagen in denen Männer Unterstützung bedürfen.";
    schema:email "Eb.arnsberg@skf-hochsauerland.de";
    schema:category "Systemischer Familienberater", "Heilpädagoge";
    schema:provider <https://civic-data.de/pipeline#emr-traeger-skf%20hochsauerland>.
