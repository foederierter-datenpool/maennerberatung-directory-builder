cdp:maennerberatungsnetz-10452 cdp:fromSource cdp:maennerberatungsnetzSource;
    a <https://civic-data.de/federated-directory#CounselingCentre>;
    schema:identifier "10452";
    schema:name "Männercoaching Lübeck";
    schema:description "Mein Life Coaching bezieht sich auf Herausforderungen von Männern jeden Alters im Job (Führungskompetenz, Burnout, Entlassung), in Beziehungen (konstruktives Streiten, Sexualität, Krisenbegleitung) und die Begleitung bei der Suche und der Verwirklichung eigener Lebensentwürfe (Was willst Du wirklich?, nachhaltige Entscheidungsfindung, Selbstannahme).\r\n\r\nDabei lege ich auf eine ganzheitliche Beratung Wert, die neben der Ratio auch den Körper und die Emotionen mit einbezieht.";
    schema:email "info@maennercoaching-hl.de";
    schema:streetAddress "Forstmeisterweg 33";
    schema:postalCode "23568";
    schema:addressLocality "Lübeck";
    schema:telephone "+4915737273113";
    foaf:homepage "https://maennercoaching-hl.de";
    schema:areaServed "Schleswig-Holstein";
    schema:addressCountry "Deutschland";
    schema:mainEntityOfPage "https://maennerberatungsnetz.de/beratung/maennercoaching-luebeck/";
