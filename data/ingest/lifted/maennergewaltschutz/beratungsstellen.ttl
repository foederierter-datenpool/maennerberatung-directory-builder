                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Kiel</small>\n  <br>\n  Männerberatung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Frauennotruf Kiel e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Dänische Straße 3–5</span>\n   <br>\n   <span itemprop=\"postalCode\">24103</span><span itemprop=\"addressLocality\">Kiel</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0431-9%2011%2024\" itemprop=\"telephone\">0431-9 11 24</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6959 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6959\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerberatung-6959\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerberatung-6959\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Das Angebot richtet sich an Männer ab 16 Jahren, die als Junge oder als Erwachsener Opfer von sexueller oder häuslicher Gewalt wurden. Auch telefonische Beratung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.frauennotruf-kiel.de/maennerberatung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.frauennotruf-kiel.de/maennerberatung/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Kiel Männerberatung Adresse d. Beratungsstelle Frauennotruf Kiel e. V. Dänische Straße 3–5 24103 Kiel Telefon 0431-9 11 24 Mehr erfahren Das Angebot richtet sich an Männer ab 16 Jahren, die als Junge oder als Erwachsener Opfer von sexueller oder häuslicher Gewalt wurden. Auch telefonische Beratung möglich. Internet https://www.frauennotruf-kiel.de/maennerberatung/"
                                                                                                ];
