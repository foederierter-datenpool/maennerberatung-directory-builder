                                                              rdf:_7    [ rdf:type  <http://www.w3.org/1999/xhtml#div>;
                                                                          <http://www.w3.org/1999/xhtml#class>
                                                                                  "list-content-container clearfix type-beratungsstelle  "
                                                                        ];
                                                              <http://www.w3.org/1999/xhtml#class>
                                                                      "content-main";
                                                              <http://www.w3.org/1999/xhtml#id>
                                                                      "content-main";
                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                      "<h2>Beratung und Schutzwohnungen für von häuslicher Gewalt betroffene Männer</h2>\n<p>Sie können telefonisch oder per eMail Kontakt aufnehmen. Die Sucheregebnisse unter der Karte umfassen auch Beratungsstellen für Männer, die von sexualisierter Gewalt betroffen sind.</p>\n<p>Zögern Sie nicht, sich Unterstützung zu holen. Es gibt professionelle Berater*innen, die Ihnen weiterhelfen können.</p>\n<pre>* <a href=\"https://www.maennergewaltschutz.de/ueber-uns/wie-wir-gendern/\" target=\"_blank\" rel=\"noopener\">Wie wir gendern.</a>\r\n\r\n</pre>\n<!-- Header -->\n<section class=\"list-container clearfix mse-list-container\" id=\"mse-filter\">\n <!-- map -->\n <header class=\"content-header list-header filter-search\" id=\"filter-container\">\n  <h2 class=\"likeh3\">Suche und Filtern nach</h2>\n  <label class=\"row\"> <span class=\"col-xs-4\">Name, Träger, Stadt, PLZ</span> <span class=\"col-xs-8\"><input type=\"text\" id=\"searchword\" autocomplete=\"off\" data-target=\".mse-list-container .list-inner-container .item-container\" name=\"searchword\" class=\"w-100\" value=\"\" minlength=\"3\"></span> </label><!-- <label class=\"row\">\n\t\t\t\t\t<span class=\"col-xs-4\">Adresse<br><small>der Beratungsstelle / des Trägers</small></span>\n\t\t\t\t\t<span class=\"col-xs-8\"><input type=\"text\" name=\"address\" class=\"w-100\" value=\"\" minlength=\"3\"></span>\n\t\t\t\t</label> -->\n  <div class=\"row\">\n   <span class=\"col-xs-4 text-right\">Angebotstyp</span><span class=\"col-xs-8\"> <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"\" checked data-filter-target=\".item-container\" data-filter-relation=\"OR\" data-show=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> Alle Angebotstypen </label> \n    <br>\n    <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"1\" data-filter-target=\".filtered-angebotstyp-1\" data-filter-relation=\"OR\" data-show=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> Männerschutzwohnung </label> \n    <br> \n    <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"3\" data-filter-target=\".filtered-angebotstyp-3\" data-filter-relation=\"OR\" data-clear=\"#filter-freie-plaetze\" data-hide=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> geschlechtsunabhängige Schutzwohnungen </label> \n    <br> \n    <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"2\" data-filter-target=\".filtered-angebotstyp-2\" data-filter-relation=\"OR\" data-clear=\"#filter-freie-plaetze\" data-hide=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> Beratungsstelle </label> </span>\n  </div>\n  <!-- freie plaetze filter -->\n  <!-- Kategorien -->\n  <!-- <div class=\"col-xs-45 position-relative\">\n\t\t\t\t\t<button class=\"filter-toggle collapsed btn\"\n\t\t\t\t\t\tdata-toggle=\"collapse\" data-target=\"#filter-taxonomy\" aria-controls=\"filter-taxonomy\" aria-expanded=\"false\" aria-label=\"Kategorie\"\n\t\t\t\t\t><span class=\"icon-list-alt\"></span> Kategorie</button>\n\t\t\t\t\t<ul class=\"filter-menu collapse transition list-unstyled px-2 py-3 w-100\" id=\"filter-taxonomy\">\n\t\t\t\t\t\t<li class=\"text-uppercase current-cat\"><a class=\"\" href=\"https://www.maennergewaltschutz.de/beratungsangebote/maennerschutzeinrichtungen/\">Alle anzeigen</a></li>\n\t\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t</div> -->\n  <!-- submit -->\n  <!-- <button type=\"submit\" class=\"btn btn-lg w-100\" title=\"Suchen\"><span class=\"icon-search\" aria-hidden=\"true\"></span></button> -->\n  <p class=\"text-right\"><a href=\"https://www.maennergewaltschutz.de/beratungsangebote/maennerschutzeinrichtungen/#mse-filter\" class=\"reset-link\" onclick=\"location.reload()\" style=\"display: none;\">Filter zurücksetzen</a></p>\n </header>\n <!-- reset -->\n <h2 class=\"likeh3 found-posts\"><span class=\"found-nr\">157</span> <span class=\"found-text text-plural\">Einträge gefunden</span> <span class=\"found-text text-singular\" style=\"display: none;\">Eintrag gefunden</span></h2>\n <div class=\"embedconsent-wrapper text-center small\">\n  <div class=\"embedconsent-after d-none\">\n   <div class=\"embedconsent-shortcode\">&lt;div id=\"js-wpv-addon-maps-render-map-bs\" style=\"width:100%; height:50vh;\" class=\"wpv-addon-maps-render js-wpv-addon-maps-render js-wpv-addon-maps-render-map-bs \" data-map=\"map-bs\" data-generalzoom=\"5\" data-generalcenterlat=\"0\" data-generalcenterlon=\"0\" data-fitbounds=\"on\" data-singlezoom=\"14\" data-singlecenter=\"on\" data-osmlayer=\"standard\" data-maptype=\"roadmap\" data-showlayerinterests=\"false\" data-markericon=\"\" data-markericonhover=\"\" data-draggable=\"on\" data-scrollwheel=\"on\" data-doubleclickzoom=\"on\" data-maptypecontrol=\"off\" data-fullscreencontrol=\"on\" data-zoomcontrol=\"on\" data-streetviewcontrol=\"off\" data-backgroundcolor=\"\" data-cluster=\"on\" data-clustergridsize=\"60\" data-clustermaxzoom=\"12\" data-clusterclickzoom=\"on\" data-clusterminsize=\"2\" data-stylejson=\"//www.maennergewaltschutz.de/wp-content/plugins/toolset-maps/resources/json/Standard.json\" data-spiderfy=\"off\" data-streetview=\"off\" data-markerid=\"\" data-location=\"\" data-lat=\"0\" data-long=\"0\" data-heading=\"\" data-pitch=\"\"&gt;&lt;/div&gt;</div>\n   <footer class=\"embedconsent-footer bg-light\">\n    <button type=\"button\" class=\"btn _btn-secondary btn-link _btn-sm embedconsent-btn m-1\" style=\"font-size: 100%\" data-consent-action=\"hide\">externe Inhalte verbergen</button>\n    <a href=\"https://www.maennergewaltschutz.de/service/datenschutz/\" target=\"_blank\" class=\"m-1 d-inline-block\">Datenschutzerklärung</a>\n    <br>\n    <p class=\"embedconsent-reload d-none pb-1\">Sollte der Inhalte fehlerhaft angezeigt werden: <a href=\"javascript:window.location.href=window.location.href\" class=\"\">laden Sie die Seite bitte neu</a></p>\n   </footer>\n  </div>\n  <div class=\"embedconsent-before card bg-light d-none\">\n   <div class=\"card-header font-weight-bold\">An dieser Stelle finden Sie externen Inhalt von GoogleMaps.</div>\n   <div class=\"card-body\">\n    <noscript>Bitte aktivieren Sie JavaScript damit Sie diesen Inhalt anzeigen können.</noscript>\n    <p class=\"\">Sie können sich hier alle externen Inhalte mit einem Klick anzeigen lassen oder wieder ausblenden.\n     <br>\n     Wenn Sie sich nachfolgend einverstanden erklären, werden Ihnen die externe Inhalte angezeigt und personenbezogene Daten an Drittplattformen übermittelt. <a href=\"https://www.maennergewaltschutz.de/service/datenschutz/\" target=\"_blank\">Mehr dazu in unserer Datenschutzerklärung.</a></p>\n    <a href=\"javascript:CookieScript.instance.acceptAction(['functionality'])\" class=\"btn btn-primary embedconsent-btn\" data-consent-action=\"show\">Ja, externe Inhalte anzeigen</a>\n   </div>\n  </div>\n </div>\n <!-- order -->\n <div class=\"_row order-list-container\">\n  Sortieren nach&nbsp;&nbsp;\n  <button type=\"button\" data-ordername=\"post_name\" data-orderitems=\".mse-list-container .list-inner-container .item-container\" class=\"btn btn-sm order order-title active\">Name</button>\n  <button type=\"button\" data-ordername=\"filtered-plz\" data-orderitems=\".mse-list-container .list-inner-container .item-container\" class=\"btn btn-sm order order-plz\">PLZ / Stadt</button>\n </div>\n <!-- list -->\n <div class=\"list-inner-container\">\n  <!-- Entry -->\n  <div id=\"mse-maenner-wohn-hilfe-e-v-4370\" class=\"\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container position-relative transition\n\t\t filtered-plz-26131\t\t filtered-freie-plaetze-z \t\t filtered-angebotstyp-1\t\tpost_name-maenner-wohn-hilfe-e-v-4370\t\" itemscope itemtype=\"h