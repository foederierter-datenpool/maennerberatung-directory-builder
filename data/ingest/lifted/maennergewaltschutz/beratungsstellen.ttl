                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Chemnitz</small>\n  <br>\n  IKOS Chemnitz</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Frauenhilfe Chemnitz e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Hainstraße 125</span>\n   <br>\n   <span itemprop=\"postalCode\">09130</span><span itemprop=\"addressLocality\">Chemnitz</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:+49%20(0)%20371%20/%2091%2085%20354\" itemprop=\"telephone\">+49 (0) 371 / 91 85 354</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8794 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8794\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-ikos-chemnitz-8794\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-ikos-chemnitz-8794\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Das Angebot richtet sich an Männer und Frauen ab dem 18. Lebensjahr, die von häuslicher Gewalt und Stalking betroffen sind/waren</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.ikos-chemnitz.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.ikos-chemnitz.de/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Chemnitz IKOS Chemnitz Adresse d. Beratungsstelle Frauenhilfe Chemnitz e.V. Hainstraße 125 09130 Chemnitz Telefon +49 (0) 371 / 91 85 354 Mehr erfahren Das Angebot richtet sich an Männer und Frauen ab dem 18. Lebensjahr, die von häuslicher Gewalt und Stalking betroffen sind/waren Internet https://www.ikos-chemnitz.de/"
                                                                                                ];
