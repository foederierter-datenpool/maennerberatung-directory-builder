                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Jena</small>\n  <br>\n  Projekt A4 Männerberatung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Vereint gegen Gewalt e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">August-Bebel-Str. 10</span>\n   <br>\n   <span itemprop=\"postalCode\">07743</span><span itemprop=\"addressLocality\">Jena</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:(0)%20151%20–%20288%20156%2018\" itemprop=\"telephone\">(0) 151 – 288 156 18</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6844 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6844\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-projekt-a4-maennerberatung-6844\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-projekt-a4-maennerberatung-6844\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Männerberatung für Betroffene von Beziehungsgewalt und Stalking.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://maennerberatung-thueringen.de/maennerberatung/kontakt-maennerberatung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://maennerberatung-thueringen.de/maennerberatung/kontakt-maennerberatung/</a>\n  </div>\n </div>\n</div>";
