                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Bielefeld</small>\n  <br>\n  Beratungsstelle Hafen e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Beratungsstelle Hafen e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Detmolder Straße 38a</span>\n   <br>\n   <span itemprop=\"postalCode\">33604</span><span itemprop=\"addressLocality\">Bielefeld</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:info@bshafen.de\" itemprop=\"email\">info@bshafen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:+49%20(0)%20176%202470%208573\" itemprop=\"telephone\">+49 (0) 176 2470 8573</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-11576 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-11576\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-hafen-e-v-11576\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-hafen-e-v-11576\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratungsstelle für Männer und Jungen ab 14 Jahren, die Gewalt erfahren haben.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.bshafen.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.bshafen.de/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Bielefeld Beratungsstelle Hafen e.V. Adresse d. Beratungsstelle Beratungsstelle Hafen e.V. Detmolder Straße 38a 33604 Bielefeld E-Mail info@bshafen.de Telefon +49 (0) 176 2470 8573 Mehr erfahren Beratungsstelle für Männer und Jungen ab 14 Jahren, die Gewalt erfahren haben. Internet https://www.bshafen.de/"
                                                                                                ];
