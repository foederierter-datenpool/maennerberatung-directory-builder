                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                              "<h2 class=\"likeh3\">Suche und Filtern nach</h2>\n<label class=\"row\"> <span class=\"col-xs-4\">Name, Träger, Stadt, PLZ</span> <span class=\"col-xs-8\"><input type=\"text\" id=\"searchword\" autocomplete=\"off\" data-target=\".mse-list-container .list-inner-container .item-container\" name=\"searchword\" class=\"w-100\" value=\"\" minlength=\"3\"></span> </label><!-- <label class=\"row\">\n\t\t\t\t\t<span class=\"col-xs-4\">Adresse<br><small>der Beratungsstelle / des Trägers</small></span>\n\t\t\t\t\t<span class=\"col-xs-8\"><input type=\"text\" name=\"address\" class=\"w-100\" value=\"\" minlength=\"3\"></span>\n\t\t\t\t</label> -->\n<div class=\"row\">\n <span class=\"col-xs-4 text-right\">Angebotstyp</span><span class=\"col-xs-8\"> <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"\" checked data-filter-target=\".item-container\" data-filter-relation=\"OR\" data-show=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> Alle Angebotstypen </label> \n  <br>\n  <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"1\" data-filter-target=\".filtered-angebotstyp-1\" data-filter-relation=\"OR\" data-show=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> Männerschutzwohnung </label> \n  <br> \n  <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"3\" data-filter-target=\".filtered-angebotstyp-3\" data-filter-relation=\"OR\" data-clear=\"#filter-freie-plaetze\" data-hide=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> geschlechtsunabhängige Schutzwohnungen </label> \n  <br> \n  <label> <input type=\"radio\" autocomplete=\"off\" name=\"angebotstyp\" value=\"2\" data-filter-target=\".filtered-angebotstyp-2\" data-filter-relation=\"OR\" data-clear=\"#filter-freie-plaetze\" data-hide=\"#filter-freie-plaetze\" data-filter-items=\".mse-list-container .list-inner-container .item-container\"> Beratungsstelle </label> </span>\n</div>\n<!-- freie plaetze filter -->\n<!-- Kategorien -->\n<!-- <div class=\"col-xs-45 position-relative\">\n\t\t\t\t\t<button class=\"filter-toggle collapsed btn\"\n\t\t\t\t\t\tdata-toggle=\"collapse\" data-target=\"#filter-taxonomy\" aria-controls=\"filter-taxonomy\" aria-expanded=\"false\" aria-label=\"Kategorie\"\n\t\t\t\t\t><span class=\"icon-list-alt\"></span> Kategorie</button>\n\t\t\t\t\t<ul class=\"filter-menu collapse transition list-unstyled px-2 py-3 w-100\" id=\"filter-taxonomy\">\n\t\t\t\t\t\t<li class=\"text-uppercase current-cat\"><a class=\"\" href=\"https://www.maennergewaltschutz.de/beratungsangebote/maennerschutzeinrichtungen/\">Alle anzeigen</a></li>\n\t\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t</div> -->\n<!-- submit -->\n<!-- <button type=\"submit\" class=\"btn btn-lg w-100\" title=\"Suchen\"><span class=\"icon-search\" aria-hidden=\"true\"></span></button> -->\n<p class=\"text-right\"><a href=\"https://www.maennergewaltschutz.de/beratungsangebote/maennerschutzeinrichtungen/#mse-filter\" class=\"reset-link\" onclick=\"location.reload()\" style=\"display: none;\">Filter zurücksetzen</a></p>";
                                                                                      <https://html.spec.whatwg.org/#innerText>
