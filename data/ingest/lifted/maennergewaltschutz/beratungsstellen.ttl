                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Rostock</small>\n  <br>\n  BeLa Rostock</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">STARK MACHEN e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Heiligengeisthof 3</span>\n   <br>\n   <span itemprop=\"postalCode\">18055</span><span itemprop=\"addressLocality\">Rostock</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0176%2043%2032%2069%2023\" itemprop=\"telephone\">0176 43 32 69 23</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8596 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8596\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-bela-rostock-8596\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-bela-rostock-8596\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung und Unterstützung bei der Bewältigung aktueller oder zurückliegender Gewalterfahrungen in Partnerschaft und familiärem Umfeld.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.stark-machen.de/das-team-rostock-2/kontakt-rostock\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.stark-machen.de/das-team-rostock-2/kontakt-rostock</a>\n  </div>\n </div>\n</div>";
