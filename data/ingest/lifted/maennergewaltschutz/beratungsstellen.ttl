                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Mönchengladbach-Rheydt</small>\n  <br>\n  Freiraum</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Rheydt e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Waisenhausstr. 22</span>\n   <br>\n   <span itemprop=\"postalCode\">41236</span><span itemprop=\"addressLocality\">Mönchengladbach-Rheydt</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">4</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:02166/130%2097%2033\" itemprop=\"telephone\">02166/130 97 33</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7016 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7016\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-freiraum-7016\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-freiraum-7016\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Männer* in Krisen und bei Gewalterfahrungen. Schutzwohnung bei Bedarf auch für Kinder. Auch telefonische- und Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.skm-ry.de/angebote-projekte/maennerarbeit-2/freiraum/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.skm-ry.de/angebote-projekte/maennerarbeit-2/freiraum/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Mönchengladbach-Rheydt Freiraum Adresse d. Träger SKM Rheydt e.V. Waisenhausstr. 22 41236 Mönchengladbach-Rheydt Plätze 4 Telefon 02166/130 97 33 Mehr erfahren Beratung für Männer* in Krisen und bei Gewalterfahrungen. Schutzwohnung bei Bedarf auch für Kinder. Auch telefonische- und Onlineberatung möglich. Internet https://www.skm-ry.de/angebote-projekte/maennerarbeit-2/freiraum/"
                                                                                                ];
