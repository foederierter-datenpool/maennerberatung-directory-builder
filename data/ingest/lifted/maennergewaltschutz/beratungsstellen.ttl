                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Torgau</small>\n  <br>\n  Beratungsstellegegen häusliche Gewalt und Stalking Nordsachsen</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Deutscher Kinderschutzbund OV Torgau e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Dommitzscher Straße 7</span>\n   <br>\n   <span itemprop=\"postalCode\">04860</span><span itemprop=\"addressLocality\">Torgau</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:015223689437\" itemprop=\"telephone\">015223689437</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8802 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8802\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstellegegen-haeusliche-gewalt-und-stalking-nordsachsen-8802\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstellegegen-haeusliche-gewalt-und-stalking-nordsachsen-8802\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Unterstützung für Betroffene von häuslicher Gewalt und Stalking</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.hilf-dir.info/hilf-dir.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.hilf-dir.info/hilf-dir.html</a>\n  </div>\n </div>\n</div>";
