                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Träger </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Sozialberatung Stuttgart e.V.</span>\n  <br>\n  <span itemprop=\"streetAddress\">Olgastraße 19</span>\n  <br>\n  <span itemprop=\"postalCode\">70182</span><span itemprop=\"addressLocality\">Stuttgart</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">Plätze</div>\n <div class=\"col-xs-8\">2</div>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:(0711)%2033%2050%2087-84\" itemprop=\"telephone\">(0711) 33 50 87-84</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-4396 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-4396\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-schutzwohnung-4396\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
