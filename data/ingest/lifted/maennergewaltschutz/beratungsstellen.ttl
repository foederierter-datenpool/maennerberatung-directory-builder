                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Ansbach</small>\n  <br>\n  Rauhreif - Hilfe bei sexualisierter Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Rauh­reif e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Platenstraße 28</span>\n   <br>\n   <span itemprop=\"postalCode\">91522</span><span itemprop=\"addressLocality\">Ansbach</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:info@rauhreif-ansbach.de\" itemprop=\"email\">info@rauhreif-ansbach.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0981%2098848\" itemprop=\"telephone\">0981 98848</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9019 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9019\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-rauhreif-hilfe-bei-sexualisierter-gewalt-9019\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-rauhreif-hilfe-bei-sexualisierter-gewalt-9019\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von sexualisierter Gewalt. Auch Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://rauhreif-ansbach.de/beratung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://rauhreif-ansbach.de/beratung/</a>\n  </div>\n </div>\n</div>";
