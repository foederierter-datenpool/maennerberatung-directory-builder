                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Hannover</small>\n  <br>\n  Gewaltschutzwohnung für Männer</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Männerbüro Hannover e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Ilse-ter-Meer-Weg 7</span>\n   <br>\n   <span itemprop=\"postalCode\">30449</span><span itemprop=\"addressLocality\">Hannover</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">3</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:gewaltschutzwohnung@maennerbuero-hannover.de\" itemprop=\"email\">gewaltschutzwohnung@maennerbuero-hannover.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0511-1235890\" itemprop=\"telephone\">0511-1235890</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12148 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12148\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-gewaltschutzwohnung-fuer-maenner-12148\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-gewaltschutzwohnung-fuer-maenner-12148\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.maennerbuero-hannover.de/seite/735649/zufluchtswohnung.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.maennerbuero-hannover.de/seite/735649/zufluchtswohnung.html</a>\n  </div>\n </div>\n</div>";
