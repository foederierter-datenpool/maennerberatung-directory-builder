                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Gießen</small>\n  <br>\n  Interventionsstelle gegen häusliche Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SkF e.V. Gießen</span>\n   <br>\n   <span itemprop=\"streetAddress\">Wartweg 17</span>\n   <br>\n   <span itemprop=\"postalCode\">35392</span><span itemprop=\"addressLocality\">Gießen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0641%202001-750\" itemprop=\"telephone\">0641 2001-750</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7053 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7053\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-interventionsstelle-gegen-haeusliche-gewalt-7053\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-interventionsstelle-gegen-haeusliche-gewalt-7053\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt. Auch Telefon- und Videoberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.skf-giessen.de/hilfe-und-beratung/1/2/2\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.skf-giessen.de/hilfe-und-beratung/1/2/2</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Gießen Interventionsstelle gegen häusliche Gewalt Adresse d. Beratungsstelle SkF e.V. Gießen Wartweg 17 35392 Gießen Telefon 0641 2001-750 Mehr erfahren Beratung für Betroffene von häuslicher Gewalt. Auch Telefon- und Videoberatung möglich. Internet https://www.skf-giessen.de/hilfe-und-beratung/1/2/2"
                                                                                                ];
