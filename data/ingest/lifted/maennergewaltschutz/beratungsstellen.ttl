                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Paderborn</small>\n  <br>\n  Beratungsstelle Belladonna</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Sozialdienst katholischer Frauen e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Westernstraße 28</span>\n   <br>\n   <span itemprop=\"postalCode\">33098</span><span itemprop=\"addressLocality\">Paderborn</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:belladonna@skf-paderborn.de\" itemprop=\"email\">belladonna@skf-paderborn.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:05251%2012196-19\" itemprop=\"telephone\">05251 12196-19</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-10556 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-10556\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-belladonna-10556\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-belladonna-10556\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Hilfe und Beratung bei häuslicher Gewalt und bei sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://skf-paderborn.de/beratungsdienstleistungen/belladonna/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://skf-paderborn.de/beratungsdienstleistungen/belladonna/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Paderborn Beratungsstelle Belladonna Adresse d. Beratungsstelle Sozialdienst katholischer Frauen e.V. Westernstraße 28 33098 Paderborn E-Mail belladonna@skf-paderborn.de Telefon 05251 12196-19 Mehr erfahren Hilfe und Beratung bei häuslicher Gewalt und bei sexualisierter Gewalt. Internet https://skf-paderborn.de/beratungsdienstleistungen/belladonna/"
                                                                                                ];
