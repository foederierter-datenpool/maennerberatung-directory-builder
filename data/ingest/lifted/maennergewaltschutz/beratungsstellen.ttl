                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Diakonieverband Reutlingen</span>\n  <br>\n  <span itemprop=\"streetAddress\">Planie 17</span>\n  <br>\n  <span itemprop=\"postalCode\">72764</span><span itemprop=\"addressLocality\">Reutlingen</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:07121-94860\" itemprop=\"telephone\">07121-94860</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8123 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8123\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungs-und-interventionsstelle-8123\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
