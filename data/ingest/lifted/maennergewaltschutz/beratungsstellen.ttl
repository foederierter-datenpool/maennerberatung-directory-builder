                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Alexianer St. Josefs-Krankenhaus Potsdam</span>\n  <br>\n  <span itemprop=\"streetAddress\">Zimmerstraße 6</span>\n  <br>\n  <span itemprop=\"postalCode\">14471</span><span itemprop=\"addressLocality\">Potsdam</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">E-Mail</div>\n <div class=\"col-xs-8\">\n  <a href=\"mailto:gyn-potsdam@alexianer.de\" itemprop=\"email\">gyn-potsdam@alexianer.de</a>\n </div>\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:+4933196824004\" itemprop=\"telephone\">+4933196824004</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12474 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12474\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-vertrauliche-spurensicherung-12474\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Adresse d. Beratungsstelle Alexianer St. Josefs-Krankenhaus Potsdam Zimmerstraße 6 14471 Potsdam E-Mail gyn-potsdam@alexianer.de Telefon +4933196824004 Mehr erfahren"
