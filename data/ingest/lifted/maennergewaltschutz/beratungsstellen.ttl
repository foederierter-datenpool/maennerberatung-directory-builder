                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Neuruppin</small>\n  <br>\n  Opferberatung Neuruppin</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Opferhilfe Land Brandenburg e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Karl-Marx-Str. 33/34</span>\n   <br>\n   <span itemprop=\"postalCode\">16816</span><span itemprop=\"addressLocality\">Neuruppin</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03391%20512%20300\" itemprop=\"telephone\">03391 512 300</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7047 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7047\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-opferberatung-neuruppin-7047\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-opferberatung-neuruppin-7047\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung von Opfern von Gewalt. Auch Telefon- und Videoberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.opferhilfe-brandenburg.de/kontakt/neuruppin/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.opferhilfe-brandenburg.de/kontakt/neuruppin/</a>\n  </div>\n </div>\n</div>";
