                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Hof</small>\n  <br>\n  Männer*Beratung Oberfranken</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Schutzhöhle e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Am Bürgerheim 7</span>\n   <br>\n   <span itemprop=\"postalCode\">95030</span><span itemprop=\"addressLocality\">Hof</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:09281%207798682\" itemprop=\"telephone\">09281 7798682</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6956 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6956\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerberatung-oberfranken-6956\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerberatung-oberfranken-6956\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Eine Beratungsstelle für Männer*, die in Kindheit und Jugend sexualisierte Gewalt und Missbrauch erfahren haben. Auch Telefonberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.männerberatung-oberfranken.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.männerberatung-oberfranken.de/</a>\n  </div>\n </div>\n</div>";
