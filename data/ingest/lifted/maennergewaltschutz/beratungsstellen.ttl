                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Berlin</small>\n  <br>\n  MUT Traumahilfe für Männer</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">HILFE-FÜR-JUNGS e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Leinestr. 49</span>\n   <br>\n   <span itemprop=\"postalCode\">12049</span><span itemprop=\"addressLocality\">Berlin</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:(030)%20236%2033%20978\" itemprop=\"telephone\">(030) 236 33 978</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8287 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8287\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-mut-traumahilfe-fuer-maenner-8287\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-mut-traumahilfe-fuer-maenner-8287\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Begleitung für Männer*, die sexualisierte Gewalt (sexuelle Gewalt, Missbrauch, Vergewaltigung) erleben oder erlebt haben</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://mut-traumahilfe.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://mut-traumahilfe.de/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
