                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Offenburg</small>\n  <br>\n  Aufschrei!</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Aufschrei e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Hindenburgstraße 28</span>\n   <br>\n   <span itemprop=\"postalCode\">77654</span><span itemprop=\"addressLocality\">Offenburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:offenburg@aufschrei-ortenau.de\" itemprop=\"email\">offenburg@aufschrei-ortenau.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0781%2031000\" itemprop=\"telephone\">0781 31000</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9008 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9008\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-aufschrei-9008\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-aufschrei-9008\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://aufschrei-ortenau.de/beratung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://aufschrei-ortenau.de/beratung/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Offenburg Aufschrei! Adresse d. Beratungsstelle Aufschrei e. V. Hindenburgstraße 28 77654 Offenburg E-Mail offenburg@aufschrei-ortenau.de Telefon 0781 31000 Mehr erfahren Beratung für Betroffene von sexualisierter Gewalt. Internet https://aufschrei-ortenau.de/beratung/"
