                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Waren</small>\n  <br>\n  Beratungsstelle KLARA</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Diakonie Mecklenburgische Seenplatte gGmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Lange Str. 35</span>\n   <br>\n   <span itemprop=\"postalCode\">17192</span><span itemprop=\"addressLocality\">Waren</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:klara@diakonie-mse.de\" itemprop=\"email\">klara@diakonie-mse.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03991%20165111\" itemprop=\"telephone\">03991 165111</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9058 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9058\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-klara-9058\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-klara-9058\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene häuslicher Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.diakonie-mse.de/einrichtungen/beratungsstelle-klara\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.diakonie-mse.de/einrichtungen/beratungsstelle-klara</a>\n  </div>\n </div>\n</div>";
