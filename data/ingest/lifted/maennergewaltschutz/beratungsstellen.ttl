                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Schwerin</small>\n  <br>\n  Beratungsstelle gegen sexualisierte Gewalt Schwerin</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Kreisverband Schwerin-Parchim e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Platz der Jugend 8</span>\n   <br>\n   <span itemprop=\"postalCode\">19053</span><span itemprop=\"addressLocality\">Schwerin</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:bgsg@awo-schwerin.de\" itemprop=\"email\">bgsg@awo-schwerin.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0385%20-%20555%2073%2052\" itemprop=\"telephone\">0385 - 555 73 52</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9062 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9062\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-gegen-sexualisierte-gewalt-schwerin-9062\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-gegen-sexualisierte-gewalt-schwerin-9062\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für betroffene von sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.awo-schwerin.de/fachbereiche/beratung-erziehung-lebensbewaeltigung/beratung/beratungsstelle-gegen-sexualisierte-gewalt\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.awo-schwerin.de/fachbereiche/beratung-erziehung-lebensbewaeltigung/beratung/beratungsstelle-gegen-sexualisierte-gewalt</a>\n  </div>\n </div>\n</div>";
