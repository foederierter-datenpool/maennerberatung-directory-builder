                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>geschlechtsunabhängige Schutzwohnungen</small> <small>in Bruchsal</small>\n  <br>\n  Geschütztes Wohnen</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SopHiE gGmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Prinz-Wilhelm-Straße 3 im 4. OG</span>\n   <br>\n   <span itemprop=\"postalCode\">76646</span><span itemprop=\"addressLocality\">Bruchsal</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">1</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:geschuetztes-wohnen@sophie-ggmbh.de\" itemprop=\"email\">geschuetztes-wohnen@sophie-ggmbh.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:07251%20-%2071%2030%20-324\" itemprop=\"telephone\">07251 - 71 30 -324</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9438 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9438\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-geschuetztes-wohnen-9438\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-geschuetztes-wohnen-9438\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnungen für von häuslicher Gewalt betroffene Personen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.sophie-ggmbh.de/schutzh%C3%A4user/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.sophie-ggmbh.de/schutzh%C3%A4user/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "geschlechtsunabhängige Schutzwohnungen in Bruchsal Geschütztes Wohnen Adresse d. Träger SopHiE gGmbH Prinz-Wilhelm-Straße 3 im 4. OG 76646 Bruchsal Plätze 1 E-Mail geschuetztes-wohnen@sophie-ggmbh.de Telefon 07251 - 71 30 -324 Mehr erfahren Schutzwohnungen für von häuslicher Gewalt betroffene Personen. Internet https://www.sophie-ggmbh.de/schutzh%C3%A4user/"
