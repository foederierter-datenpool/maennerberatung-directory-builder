                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Bielefeld</small>\n  <br>\n  man-o-mann Maennerberatung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">VSGB e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Teutoburger Str. 106</span>\n   <br>\n   <span itemprop=\"postalCode\">33607</span><span itemprop=\"addressLocality\">Bielefeld</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">4</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:mse@man-o-mann.de\" itemprop=\"email\">mse@man-o-mann.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:01522.8256243;%2001525.1764336\" itemprop=\"telephone\">01522.8256243; 01525.1764336</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7744 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7744\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-man-o-mann-maennerberatung-7744\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-man-o-mann-maennerberatung-7744\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung und bei Bedarf Schutzwohnung für von häuslicher Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://man-o-mann.de/maennerschutzeinrichtung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://man-o-mann.de/maennerschutzeinrichtung/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Bielefeld man-o-mann Maennerberatung Adresse d. Träger VSGB e.V. Teutoburger Str. 106 33607 Bielefeld Plätze 4 E-Mail mse@man-o-mann.de Telefon 01522.8256243; 01525.1764336 Mehr erfahren Beratung und bei Bedarf Schutzwohnung für von häuslicher Gewalt betroffene Männer. Internet https://man-o-mann.de/maennerschutzeinrichtung/"
                                                                                                ];
