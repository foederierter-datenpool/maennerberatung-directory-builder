                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Augsburg</small>\n  <br>\n  Beratungs- und Interventionsstelle via</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Augsburg</span>\n   <br>\n   <span itemprop=\"streetAddress\">Am Katzenstadel 32</span>\n   <br>\n   <span itemprop=\"postalCode\">86152</span><span itemprop=\"addressLocality\">Augsburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0821%20–%20450%20339%20–%2020\" itemprop=\"telephone\">0821 – 450 339 – 20</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6953 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6953\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungs-und-interventionsstelle-via-6953\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungs-und-interventionsstelle-via-6953\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">via ist Anlaufstelle, Beratungsstelle und Interventionsstelle bei häuslicher Gewalt, sexueller Gewalt, bei psychischer und physischer Gewalt und bei Stalking.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://awo-augsburg.de/via-beratung-fuer-maenner/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://awo-augsburg.de/via-beratung-fuer-maenner/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Augsburg Beratungs- und Interventionsstelle via Adresse d. Beratungsstelle AWO Augsburg Am Katzenstadel 32 86152 Augsburg Telefon 0821 – 450 339 – 20 Mehr erfahren via ist Anlaufstelle, Beratungsstelle und Interventionsstelle bei häuslicher Gewalt, sexueller Gewalt, bei psychischer und physischer Gewalt und bei Stalking. Internet https://awo-augsburg.de/via-beratung-fuer-maenner/"
                                                                                                ];
