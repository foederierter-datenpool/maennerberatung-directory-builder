                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Neuss</small>\n  <br>\n  Echte Männer reden</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Neuss e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Hammer Landstr. 5</span>\n   <br>\n   <span itemprop=\"postalCode\">41460</span><span itemprop=\"addressLocality\">Neuss</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:02131%209248-0\" itemprop=\"telephone\">02131 9248-0</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7019 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7019\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-echte-maenner-reden-7019\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-echte-maenner-reden-7019\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung bei Männern in Krisen und bei Gewalterfahrungen. Auch telefonische Beratung und Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://skm-neuss.de/beratungsstellen/beratung-fuer-maenner/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://skm-neuss.de/beratungsstellen/beratung-fuer-maenner/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Neuss Echte Männer reden Adresse d. Beratungsstelle SKM Neuss e.V. Hammer Landstr. 5 41460 Neuss Telefon 02131 9248-0 Mehr erfahren Beratung bei Männern in Krisen und bei Gewalterfahrungen. Auch telefonische Beratung und Onlineberatung möglich. Internet https://skm-neuss.de/beratungsstellen/beratung-fuer-maenner/"
