                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Stuttgart</small>\n  <br>\n  Gewaltschutz für Männer</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Sozialberatung Stuttgart e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Olgastraße 19</span>\n   <br>\n   <span itemprop=\"postalCode\">70182</span><span itemprop=\"addressLocality\">Stuttgart</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:gewaltschutz@sozialberatung-stuttgart.de\" itemprop=\"email\">gewaltschutz@sozialberatung-stuttgart.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0711-33508784\" itemprop=\"telephone\">0711-33508784</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9823 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9823\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-gewaltschutz-fuer-maenner-9823\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-gewaltschutz-fuer-maenner-9823\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für von häuslicher Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.sozialberatung-stuttgart.de/seite/394985/gewaltschutz-f%C3%BCr-m%C3%A4nner-bei-h%C3%A4uslicher-gewalt.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.sozialberatung-stuttgart.de/seite/394985/gewaltschutz-f%C3%BCr-m%C3%A4nner-bei-h%C3%A4uslicher-gewalt.html</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
