                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Freiburg</small>\n  <br>\n  Freiburger Fachstelle Intervention gegen Häusliche Gewalt (FRIG)</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Frauen- und Kinderschutzhaus Freiburg e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Rimsinger Weg 15a</span>\n   <br>\n   <span itemprop=\"postalCode\">79111</span><span itemprop=\"addressLocality\">Freiburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0761/8973520\" itemprop=\"telephone\">0761/8973520</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7864 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7864\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-freiburger-fachstelle-intervention-gegen-haeusliche-gewalt-frig-7864\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-freiburger-fachstelle-intervention-gegen-haeusliche-gewalt-frig-7864\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Hilfe und Beratung bei häuslicher Gewalt. Auch Online-Beratung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://frig-freiburg.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://frig-freiburg.de/</a>\n  </div>\n </div>\n</div>";
