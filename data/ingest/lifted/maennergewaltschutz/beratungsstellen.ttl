                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Zwickau</small>\n  <br>\n  Interventions- und Koordinierungsstelle Zwickau</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Wildwasser ZWICKAUer Land e.V</span>\n   <br>\n   <span itemprop=\"streetAddress\">Casparistraße 5</span>\n   <br>\n   <span itemprop=\"postalCode\">08056</span><span itemprop=\"addressLocality\">Zwickau</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:+49%20375%20447%20915%2051\" itemprop=\"telephone\">+49 375 447 915 51</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8801 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8801\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-interventions-und-koordinierungsstelle-zwickau-8801\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-interventions-und-koordinierungsstelle-zwickau-8801\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Unterstützung in der Krisensituation und bei der Suche nach Wegen aus der Gewalt\n   <br>\n   Beratung in Fällen von häuslicher Gewalt und Stalking</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.wildwasser-zwickauer-land.de/interventionsstelle---iks\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.wildwasser-zwickauer-land.de/interventionsstelle---iks</a>\n  </div>\n </div>\n</div>";
