                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Berlin-Moabit</small>\n  <br>\n  Beratungsstelle für Opfer von Straftaten - Opferhilfe Berlin e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Opferhilfe Berlin e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Oldenburger Straße 38</span>\n   <br>\n   <span itemprop=\"postalCode\">10551</span><span itemprop=\"addressLocality\">Berlin-Moabit</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:030%20/%20395%2028%2067\" itemprop=\"telephone\">030 / 395 28 67</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7057 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7057\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-fuer-opfer-von-straftaten-opferhilfe-berlin-e-v-7057\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-fuer-opfer-von-straftaten-opferhilfe-berlin-e-v-7057\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Opfer von Straftaten.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.opferhilfe-berlin.de/beratungsstelle\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.opferhilfe-berlin.de/beratungsstelle</a>\n  </div>\n </div>\n</div>";
