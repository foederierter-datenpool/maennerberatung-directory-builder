                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Nürnberg</small>\n  <br>\n  Riposo</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Caritas Nürnberg e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Obstmarkt 28</span>\n   <br>\n   <span itemprop=\"postalCode\">90403</span><span itemprop=\"addressLocality\">Nürnberg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">5</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:riposo@caritas-nuernberg.de\" itemprop=\"email\">riposo@caritas-nuernberg.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0911/23%2054%20137\" itemprop=\"telephone\">0911/23 54 137</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-4395 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-4395\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-riposo-4395\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-riposo-4395\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von häuslicher Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.caritas-nuernberg.de/ich-suche-hilfe/hilfe-fuer-menschen-in-besonderen-lagen/riposo.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.caritas-nuernberg.de/ich-suche-hilfe/hilfe-fuer-menschen-in-besonderen-lagen/riposo.html</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Nürnberg Riposo Adresse d. Träger Caritas Nürnberg e.V. Obstmarkt 28 90403 Nürnberg Plätze 5 E-Mail riposo@caritas-nuernberg.de Telefon 0911/23 54 137 Mehr erfahren Schutzwohnung für von häuslicher Gewalt betroffene Männer. Internet https://www.caritas-nuernberg.de/ich-suche-hilfe/hilfe-fuer-menschen-in-besonderen-lagen/riposo.html"
                                                                                                ];
