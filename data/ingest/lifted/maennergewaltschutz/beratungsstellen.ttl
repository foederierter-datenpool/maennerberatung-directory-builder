                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Grimma</small>\n  <br>\n  Beratungsstelle gegen häuslicher Gewalt und Stalking</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Wegweiser e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Lange Str. 50</span>\n   <br>\n   <span itemprop=\"postalCode\">04668</span><span itemprop=\"addressLocality\">Grimma</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03437%20—%2070%2084%2078\" itemprop=\"telephone\">03437 — 70 84 78</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8796 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8796\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-gegen-haeuslicher-gewalt-und-stalking-8796\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-gegen-haeuslicher-gewalt-und-stalking-8796\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung bei häuslicher Gewalt und Stalking\n   <br></p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://wegweiser-boehlen.de/frauen-und-kinderschutzhaus/haeusliche-gewalt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://wegweiser-boehlen.de/frauen-und-kinderschutzhaus/haeusliche-gewalt/</a>\n  </div>\n </div>\n</div>";
