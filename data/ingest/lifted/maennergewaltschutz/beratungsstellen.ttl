                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Tübingen</small>\n  <br>\n  AGIT</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Pfunzkerle e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Unter dem Holz 3</span>\n   <br>\n   <span itemprop=\"postalCode\">72072</span><span itemprop=\"addressLocality\">Tübingen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:agit@pfunzkerle.org\" itemprop=\"email\">agit@pfunzkerle.org</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:07071/79%20111%2001\" itemprop=\"telephone\">07071/79 111 01</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9011 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9011\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-agit-9011\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-agit-9011\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für betroffene von sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.pfunzkerle.org/sexualisierte-gewalt/kontaktansprechpartner/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.pfunzkerle.org/sexualisierte-gewalt/kontaktansprechpartner/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
