                      "<meta charset=\"utf-8\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Kontaktlandkarte - Männergewaltschutz</title>\n<meta name=\"description\" content=\"Beratung und Schutzwohnungen für von häuslicher Gewalt betroffene Männer\r\nSie können telefonisch oder per eMail Kontakt aufnehmen. Die Sucheregebnisse unter der Karte umfassen auch Beratungsstellen für Männer, die von sexualisierter  [...]\">\n<meta name=\"referrer\" content=\"strict-origin-when-cross-origin\">\n<meta name=\"robots\" content=\"index,follow\">\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon-180x180.png\">\n<meta name=\"robots\" content=\"max-image-preview:large\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://www.maennergewaltschutz.de/beratungsangebote/maennerschutzeinrichtungen/\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://www.maennergewaltschutz.de/en/advice-services/mensrefuges/\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://www.maennergewaltschutz.de/beratungsangebote/maennerschutzeinrichtungen/\">\n<link rel=\"dns-prefetch\" href=\"//cdn.cookie-script.com\">\n<link rel=\"dns-prefetch\" href=\"//unpkg.com\">\n<link rel=\"alternate\" title=\"oEmbed (JSON)\" type=\"application/json+oembed\" href=\"https://www.maennergewaltschutz.de/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.maennergewaltschutz.de%2Fberatungsangebote%2Fmaennerschutzeinrichtungen%2F\">\n<link rel=\"alternate\" title=\"oEmbed (XML)\" type=\"text/xml+oembed\" href=\"https://www.maennergewaltschutz.de/wp-json/oembed/1.0/embed?url=https%3A%2F%2Fwww.maennergewaltschutz.de%2Fberatungsangebote%2Fmaennerschutzeinrichtungen%2F&amp;format=xml\">\n<style id=\"wp-img-auto-sizes-contain-inline-css\">\nimg:is([sizes=auto i],[sizes^=\"auto,\" i]){contain-intrinsic-size:3000px 1500px}\n/*# sourceURL=wp-img-auto-sizes-contain-inline-css */\n</sty