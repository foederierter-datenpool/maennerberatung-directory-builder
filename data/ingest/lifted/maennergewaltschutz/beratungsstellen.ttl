                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Bergen auf Rügen</small>\n  <br>\n  Beratungsstelle \"Ankerlicht\"</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Kinder-, Jugend- und Familienhilfe Rügen e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Ringstraße 25</span>\n   <br>\n   <span itemprop=\"postalCode\">18528</span><span itemprop=\"addressLocality\">Bergen auf Rügen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:ankerlicht@kjfh-ruegen.de\" itemprop=\"email\">ankerlicht@kjfh-ruegen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03838%20-%20201793\" itemprop=\"telephone\">03838 - 201793</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8997 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8997\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-ankerlicht-8997\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-ankerlicht-8997\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt ab dem 18. Lebensjahr. Entlastende Gespräche und Beratung zur individuellen Situation Begleitung zu Ämtern und Institutionen. Weitervermittlung nach Bedarf.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.jugendhilfe-ruegen.de/ankerlicht\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.jugendhilfe-ruegen.de/ankerlicht</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
