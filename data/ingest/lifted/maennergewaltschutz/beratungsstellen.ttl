                                                                                                          "\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container position-relative transition\n\t\t filtered-plz-04277\t\t filtered-freie-plaetze-z \t\t filtered-angebotstyp-2\t\tpost_name-maennerberatung-7716\t";
