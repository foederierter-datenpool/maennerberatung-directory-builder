                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Chemnitz</small>\n  <br>\n  Stadtmission Chemnitz</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Stadtmission Chemnitz e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Rembrandtstr. 13b</span>\n   <br>\n   <span itemprop=\"postalCode\">09111</span><span itemprop=\"addressLocality\">Chemnitz</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">3</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:mse@stadtmission-chemnitz.de\" itemprop=\"email\">mse@stadtmission-chemnitz.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:+49%20371%2060048%2058\" itemprop=\"telephone\">+49 371 60048 58</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9725 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9725\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-stadtmission-chemnitz-9725\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-stadtmission-chemnitz-9725\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Männerschutzwohnung Chemnitz</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.stadtmission-chemnitz.de/unsere-angebote/angebote-fuer-menschen-in-notlagen/maennerschutz\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.stadtmission-chemnitz.de/unsere-angebote/angebote-fuer-menschen-in-notlagen/maennerschutz</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Chemnitz Stadtmission Chemnitz Adresse d. Träger Stadtmission Chemnitz e.V. Rembrandtstr. 13b 09111 Chemnitz Plätze 3 E-Mail mse@stadtmission-chemnitz.de Telefon +49 371 60048 58 Mehr erfahren Männerschutzwohnung Chemnitz Internet https://www.stadtmission-chemnitz.de/unsere-angebote/angebote-fuer-menschen-in-notlagen/maennerschutz"
