                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Institut für Soziale und Kulturelle Arbeit (ISKA) gemeinnützige GmbH</span>\n  <br>\n  <span itemprop=\"streetAddress\">Bauerngasse 46</span>\n  <br>\n  <span itemprop=\"postalCode\">97421</span><span itemprop=\"addressLocality\">Schweinfurt</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">E-Mail</div>\n <div class=\"col-xs-8\">\n  <a href=\"mailto:bhgm-unterfranken@iska-nuernberg.de\" itemprop=\"email\">bhgm-unterfranken@iska-nuernberg.de</a>\n </div>\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:(09%2031)%2079%2062%2057%2049\" itemprop=\"telephone\">(09 31) 79 62 57 49</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12650 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12650\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-haeusliche-gewalt-gegen-maenner-unterfranken-12650\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
