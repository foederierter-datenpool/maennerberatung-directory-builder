                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Trier</small>\n  <br>\n  Jungen- und Männerberatung Trier</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM- Katholischer Verein für soziale Dienste e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Röntgenstraße 4</span>\n   <br>\n   <span itemprop=\"postalCode\">54292</span><span itemprop=\"addressLocality\">Trier</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:machetanz@skm-trier.de\" itemprop=\"email\">machetanz@skm-trier.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0651-1478819\" itemprop=\"telephone\">0651-1478819</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9547 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9547\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-jungen-und-maennerberatung-trier-9547\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-jungen-und-maennerberatung-trier-9547\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Jungen und Männerberatung u.a. auch bei eigenen (häuslichen) Gewalterfahrungen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"http://skm-trier.de/jungen-und-maennerberatung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">http://skm-trier.de/jungen-und-maennerberatung/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Trier Jungen- und Männerberatung Trier Adresse d. Beratungsstelle SKM- Katholischer Verein für soziale Dienste e.V. Röntgenstraße 4 54292 Trier E-Mail machetanz@skm-trier.de Telefon 0651-1478819 Mehr erfahren Jungen und Männerberatung u.a. auch bei eigenen (häuslichen) Gewalterfahrungen. Internet http://skm-trier.de/jungen-und-maennerberatung/"
