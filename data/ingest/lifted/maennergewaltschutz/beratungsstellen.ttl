                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Oelde</small>\n  <br>\n  Beratungsstelle für Betroffene von häuslicher Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Warendorf e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Wibbeltstraße 2</span>\n   <br>\n   <span itemprop=\"postalCode\">59302</span><span itemprop=\"addressLocality\">Oelde</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:mail@skm-warendorf.de\" itemprop=\"email\">mail@skm-warendorf.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:02522%2083434720\" itemprop=\"telephone\">02522 83434720</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9577 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9577\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-fuer-betroffene-von-haeuslicher-gewalt-9577\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-fuer-betroffene-von-haeuslicher-gewalt-9577\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratungsstelle für Betroffene von häuslicher Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://skm-warendorf.de/fachbereiche/krisen-und-gewaltberatung/betroffene-von-haeuslicher-gewalt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://skm-warendorf.de/fachbereiche/krisen-und-gewaltberatung/betroffene-von-haeuslicher-gewalt/</a>\n  </div>\n </div>\n</div>";
