                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Potsdam</small>\n  <br>\n  Opferberatung/ Traumaambulanz Potsdam</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Opferhilfe Land Brandenburg e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Jägerstr. 36</span>\n   <br>\n   <span itemprop=\"postalCode\">14467</span><span itemprop=\"addressLocality\">Potsdam</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0331%20280%202725\" itemprop=\"telephone\">0331 280 2725</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7028 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7028\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-opferberatung-traumaambulanz-potsdam-7028\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-opferberatung-traumaambulanz-potsdam-7028\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung von Opfern von Gewalt. Auch Telefon- und Videoberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.opferhilfe-brandenburg.de/kontakt/potsdam/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.opferhilfe-brandenburg.de/kontakt/potsdam/</a>\n  </div>\n </div>\n</div>";
