                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Chemnitz</small>\n  <br>\n  WILDWASSER Chemnitz, Erzgebirge und Umland e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">WILDWASSER Chemnitz, Erzgebirge und Umland e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Uferstraße 46</span>\n   <br>\n   <span itemprop=\"postalCode\">09126</span><span itemprop=\"addressLocality\">Chemnitz</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0371%20/%2035%2005%2034\" itemprop=\"telephone\">0371 / 35 05 34</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8993 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8993\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-wildwasser-chemnitz-erzgebirge-und-umland-e-v-8993\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-wildwasser-chemnitz-erzgebirge-und-umland-e-v-8993\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Jugendliche ab 12 Jahre und Frauen und Männer, die von sexualisierter Gewalt betroffen sind.</p>\