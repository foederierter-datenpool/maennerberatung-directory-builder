                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Hanau</small>\n  <br>\n  Opfer- und Zeugenberatung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">HANAUER HILFE e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Salzstraße 11</span>\n   <br>\n   <span itemprop=\"postalCode\">63450</span><span itemprop=\"addressLocality\">Hanau</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:(06181)%2024871\" itemprop=\"telephone\">(06181) 24871</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6906 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6906\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-opfer-und-zeugenberatung-6906\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-opfer-und-zeugenberatung-6906\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Opfer und Zeugen von Straftaten. Auch telefonische Beratung und Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.hanauer-hilfe.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.hanauer-hilfe.de/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
