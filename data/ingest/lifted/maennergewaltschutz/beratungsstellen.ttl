                                                                                                              <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Diözese Rottenburg-Stuttgart</span>\n  <br>\n  <span itemprop=\"streetAddress\">Hospitalstraße 26</span>\n  <br>\n  <span itemprop=\"postalCode\">70174</span><span itemprop=\"addressLocality\">Stuttgart</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">E-Mail</div>\n <div class=\"col-xs-8\">\n  <a href=\"mailto:beratungszentrum@ruf-und-rat.de\" itemprop=\"email\">beratungszentrum@ruf-und-rat.de</a>\n </div>\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:0711%20226%2020%2055\" itemprop=\"telephone\">0711 226 20 55</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9010 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9010\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-ruf-und-rat-9010\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Adresse d. Beratungsstelle Diözese Rottenburg-Stuttgart Hospitalstraße 26 70174 Stuttgart E-Mail beratungszentrum@ruf-und-rat.de Telefon 0711 226 20 55 Mehr erfahren"
