                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Freital</small>\n  <br>\n  IKS zur Beratung und Hilfe bei häuslicher Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">DRK Kreisverband Pirna e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Dresdner Straße 207</span>\n   <br>\n   <span itemprop=\"postalCode\">01705</span><span itemprop=\"addressLocality\">Freital</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03501%205764988\" itemprop=\"telephone\">03501 5764988</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8805 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8805\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-iks-zur-beratung-und-hilfe-bei-haeuslicher-gewalt-8805\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-iks-zur-beratung-und-hilfe-bei-haeuslicher-gewalt-8805\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Unterstzüung für Betroffene von häuslicher Gewalt</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"http://www.drkpirna.de/angebote/interventions-und-koordinierungsstelle-fuer-opfer-von-haeuslicher-gewalt.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">http://www.drkpirna.de/angebote/interventions-und-koordinierungsstelle-fuer-opfer-von-haeuslicher-gewalt.html</a>\n  </div>\n </div>\n</div>";
