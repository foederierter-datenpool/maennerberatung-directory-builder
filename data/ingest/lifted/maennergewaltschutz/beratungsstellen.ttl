                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Neubrandenburg</small>\n  <br>\n  Interventionsstelle gegen häusliche Gewalt und Stalking Neubrandenburg</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Quo vadis e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Helmut- Just- Straße 4</span>\n   <br>\n   <span itemprop=\"postalCode\">17036</span><span itemprop=\"addressLocality\">Neubrandenburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:interventionsstelle-nb@web.de\" itemprop=\"email\">interventionsstelle-nb@web.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:(0395)%205584384\" itemprop=\"telephone\">(0395) 5584384</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9056 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9056\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-interventionsstelle-gegen-haeusliche-gewalt-und-stalking-neubrandenburg-9056\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-interventionsstelle-gegen-haeusliche-gewalt-und-stalking-neubrandenburg-9056\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt und Stalking</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.quovadis-neubrandenburg.de/interventionsstelle-neubrandenburg/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.quovadis-neubrandenburg.de/interventionsstelle-neubrandenburg/</a>\n  </div>\n </div>\n</div>";
