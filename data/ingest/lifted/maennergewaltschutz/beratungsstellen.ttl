                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Kassel</small>\n  <br>\n  faX</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Verein gegen sexualisierte Gewalt Kassel e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Untere Karlsstr. 16</span>\n   <br>\n   <span itemprop=\"postalCode\">34117</span><span itemprop=\"addressLocality\">Kassel</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0561%2031749116\" itemprop=\"telephone\">0561 31749116</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8627 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8627\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-fax-8627\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-fax-8627\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Fachberatungsstelle bei sexualisierter Gewalt in Stadt und Landkreis Kassel</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://fax-kassel.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://fax-kassel.de/</a>\n  </div>\n </div>\n</div>";
