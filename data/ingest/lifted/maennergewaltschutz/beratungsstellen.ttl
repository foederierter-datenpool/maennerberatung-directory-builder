                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Löbau</small>\n  <br>\n  IKS gegen häusliche Gewalt im Landkreis Görlitz</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Deutscher Kinderschutzbund Ortsverband Zittau e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Bahnhofstraße 8</span>\n   <br>\n   <span itemprop=\"postalCode\">02708</span><span itemprop=\"addressLocality\">Löbau</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03585%20213%20980%203\" itemprop=\"telephone\">03585 213 980 3</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8806 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8806\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-iks-gegen-haeusliche-gewalt-im-landkreis-goerlitz-8806\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-iks-gegen-haeusliche-gewalt-im-landkreis-goerlitz-8806\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffenen von häuslicher Gewalt im Landkreis Görlitz.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://kinderschutzbund-zittau.de/iks-haeusliche-gewalt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://kinderschutzbund-zittau.de/iks-haeusliche-gewalt/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
