                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Sigmaringen</small>\n  <br>\n  Männerberatung SKM Sigmaringen</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Landkreis Sigmaringen</span>\n   <br>\n   <span itemprop=\"streetAddress\">Fidelisstr. 6</span>\n   <br>\n   <span itemprop=\"postalCode\">72488</span><span itemprop=\"addressLocality\">Sigmaringen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:maennerberatung@skm-sigmaringen.de\" itemprop=\"email\">maennerberatung@skm-sigmaringen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:07571%2072892-0\" itemprop=\"telephone\">07571 72892-0</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12395 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12395\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerberatung-skm-sigmaringen-12395\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerberatung-skm-sigmaringen-12395\">\n <div class=\"\" itemprop=\"description\"></div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://sigmaringen.skmdivfreiburg.de/angebote/maennerberatung\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://sigmaringen.skmdivfreiburg.de/angebote/maennerberatung</a>\n  </div>\n </div>\n</div>";
