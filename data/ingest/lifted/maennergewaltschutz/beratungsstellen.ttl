                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Rostock</small>\n  <br>\n  Interventionsstellen gegen häusliche Gewalt &amp; Stalking Rostock</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">STARK MACHEN e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Heiligengeisthof 3</span>\n   <br>\n   <span itemprop=\"postalCode\">18055</span><span itemprop=\"addressLocality\">Rostock</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:interventionsstelle.rostock@stark-machen.de\" itemprop=\"email\">interventionsstelle.rostock@stark-machen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0381%20/%20458%2029%2038\" itemprop=\"telephone\">0381 / 458 29 38</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9054 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9054\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-interventionsstellen-gegen-haeusliche-gewalt-stalking-rostock-9054\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-interventionsstellen-gegen-haeusliche-gewalt-stalking-rostock-9054\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt und Stalking.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.stark-machen.de/das-team-rostock/kontakt-rostock\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.stark-machen.de/das-team-rostock/kontakt-rostock</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Rostock Interventionsstellen gegen häusliche Gewalt & Stalking Rostock Adresse d. Beratungsstelle STARK MACHEN e.V. Heiligengeisthof 3 18055 Rostock E-Mail interventionsstelle.rostock@stark-machen.de Telefon 0381 / 458 29 38 Mehr erfahren Beratung für Betroffene von häuslicher Gewalt und Stalking. Internet https://www.stark-machen.de/das-team-rostock/kontakt-rostock"
                                                                                                ];
