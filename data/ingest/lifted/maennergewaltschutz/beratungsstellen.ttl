                                                                                                          "\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container position-relative transition\n\t\t filtered-plz-03044\t\t filtered-freie-plaetze-z \t\t filtered-angebotstyp-2\t\tpost_name-opferberatung-cottbus-7044\t";
