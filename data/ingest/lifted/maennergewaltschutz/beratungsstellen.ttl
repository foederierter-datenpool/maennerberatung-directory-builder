                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Leipzig</small>\n  <br>\n  Männerhaus Leipzig</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">LEMANN e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Bernhard-Göring-Str. 152</span>\n   <br>\n   <span itemprop=\"postalCode\">04277</span><span itemprop=\"addressLocality\">Leipzig</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">4</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0176%20-%2042%20902%20888\" itemprop=\"telephone\">0176 - 42 902 888</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-4394 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-4394\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerhaus-leipzig-4394\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerhaus-leipzig-4394\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von Gewalt bedrohten und betroffenen Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.maennerhaus-leipzig.de/kontakt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.maennerhaus-leipzig.de/kontakt/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Leipzig Männerhaus Leipzig Adresse d. Träger LEMANN e.V. Bernhard-Göring-Str. 152 04277 Leipzig Plätze 4 Telefon 0176 - 42 902 888 Mehr erfahren Schutzwohnung für von Gewalt bedrohten und betroffenen Männer. Internet https://www.maennerhaus-leipzig.de/kontakt/"
