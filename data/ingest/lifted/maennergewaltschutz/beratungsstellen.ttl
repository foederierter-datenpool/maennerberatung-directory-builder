                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Herford</small>\n  <br>\n  Echte Männer reden</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Herford e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Steintorwall 17</span>\n   <br>\n   <span itemprop=\"postalCode\">32052</span><span itemprop=\"addressLocality\">Herford</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:05221%20-%202%20777%20812\" itemprop=\"telephone\">05221 - 2 777 812</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7021 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7021\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-echte-maenner-reden-7021\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-echte-maenner-reden-7021\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung bei Männern in Krisen und bei Gewalterfahrungen. Auch telefonische Beratung und Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://skm-herford.de/beratung/jungen-und-maennerberatung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://skm-herford.de/beratung/jungen-und-maennerberatung/</a>\n  </div>\n </div>\n</div>";
