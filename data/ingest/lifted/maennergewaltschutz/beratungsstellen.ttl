                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Wolgast</small>\n  <br>\n  Beratungsstelle für Betroffene häuslicher Gewalt Wolgast</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Kreisdiakonisches Werk Greifswald e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Breite Str. 6c</span>\n   <br>\n   <span itemprop=\"postalCode\">17438</span><span itemprop=\"addressLocality\">Wolgast</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03836/%2023%2077%20630\" itemprop=\"telephone\">03836/ 23 77 630</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8995 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8995\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-fuer-betroffene-haeuslicher-gewalt-wolgast-8995\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-fuer-betroffene-haeuslicher-gewalt-wolgast-8995\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://kdw-greifswald.de/beratung-und-hilfe-bei-problemen/gewalt-opfer-beratung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://kdw-greifswald.de/beratung-und-hilfe-bei-problemen/gewalt-opfer-beratung/</a>\n  </div>\n </div>\n</div>";
