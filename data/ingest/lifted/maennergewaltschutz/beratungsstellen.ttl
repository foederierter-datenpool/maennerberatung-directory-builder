                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Lüneburg</small>\n  <br>\n  Opferhilfebüro Lüneburg</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Stiftung Opferhilfe Niedersachsen</span>\n   <br>\n   <span itemprop=\"streetAddress\">Bei der St. Lambertikirche 8</span>\n   <br>\n   <span itemprop=\"postalCode\">21335</span><span itemprop=\"addressLocality\">Lüneburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:poststellelueneburg@opferhilfe.niedersachsen.de\" itemprop=\"email\">poststellelueneburg@opferhilfe.niedersachsen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:04131/%20727%2019%20-10\" itemprop=\"telephone\">04131/ 727 19 -10</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12416 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12416\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-opferhilfebuero-lueneburg-12416\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-opferhilfebuero-lueneburg-12416\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung von Opfern von Gewalt. Auch Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.opferhilfe.niedersachsen.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.opferhilfe.niedersachsen.de/</a>\n  </div>\n </div>\n</div>";
