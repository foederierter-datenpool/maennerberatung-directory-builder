                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Darmstadt</small>\n  <br>\n  Männerschutzwohnung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Flexible Jugendhilfe e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Grafenstraße 27</span>\n   <br>\n   <span itemprop=\"postalCode\">64283</span><span itemprop=\"addressLocality\">Darmstadt</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">2</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:info@flexiblejugendhilfe.de\" itemprop=\"email\">info@flexiblejugendhilfe.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:06151%20–%2039%20466%2010\" itemprop=\"telephone\">06151 – 39 466 10</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12685 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12685\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerschutzwohnung-12685\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerschutzwohnung-12685\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von häuslicher Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.flexiblejugendhilfe.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.flexiblejugendhilfe.de/</a>\n  </div>\n </div>\n</div>";
