                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in München</small>\n  <br>\n  Münchner Informationszentrum für Männer e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Münchner Informationszentrum für Männer e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Feldmochingerstr. 6</span>\n   <br>\n   <span itemprop=\"postalCode\">80992</span><span itemprop=\"addressLocality\">München</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:089%20/%20543%2095%2056\" itemprop=\"telephone\">089 / 543 95 56</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6954 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6954\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-muenchner-informationszentrum-fuer-maenner-e-v-6954\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-muenchner-informationszentrum-fuer-maenner-e-v-6954\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung und Angebote für Männer, die von Gewalt betroffen sind.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.maennerzentrum.de/angebot/#betroffen\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.maennerzentrum.de/angebot/#betroffen</a>\n  </div>\n </div>\n</div>";
