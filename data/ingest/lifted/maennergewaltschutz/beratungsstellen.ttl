                                                                                                          "\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container position-relative transition\n\t\t filtered-plz-33604\t\t filtered-freie-plaetze-z \t\t filtered-angebotstyp-2\t\tpost_name-beratungsstelle-hafen-e-v-11576\t";
