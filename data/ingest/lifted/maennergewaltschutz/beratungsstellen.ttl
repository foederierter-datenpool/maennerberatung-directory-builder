                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Pasewalk</small>\n  <br>\n  Beratungsstelle für Betroffene von häuslicher Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Deutsches Rotes Kreuz Kreisverband Uecker-Randow e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Oskar-Picht-Straße 1</span>\n   <br>\n   <span itemprop=\"postalCode\">17309</span><span itemprop=\"addressLocality\">Pasewalk</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03973%20/%202%2004%2099%2075\" itemprop=\"telephone\">03973 / 2 04 99 75</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8595 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8595\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-fuer-betroffene-von-haeuslicher-gewalt-8595\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-fuer-betroffene-von-haeuslicher-gewalt-8595\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.drk-uer.de/home/haeusliche-gewalt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.drk-uer.de/home/haeusliche-gewalt/</a>\n  </div>\n </div>\n</div>";
