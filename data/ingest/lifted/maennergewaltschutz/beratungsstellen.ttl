                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Warendorf</small>\n  <br>\n  Freiraum</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Warendorf e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Kirchstraße 5</span>\n   <br>\n   <span itemprop=\"postalCode\">48231</span><span itemprop=\"addressLocality\">Warendorf</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">4</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0170%20330%2043%2093\" itemprop=\"telephone\">0170 330 43 93</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7356 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7356\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-freiraum-7356\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-freiraum-7356\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von Gewalt bedrohten und betroffenen Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://skm-warendorf.de/fachbereiche/krisen-und-gewaltberatung/gewaltschutz-fuer-maenner/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://skm-warendorf.de/fachbereiche/krisen-und-gewaltberatung/gewaltschutz-fuer-maenner/</a>\n  </div>\n </div>\n</div>";
