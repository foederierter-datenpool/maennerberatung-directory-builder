                                                                                                          "\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container position-relative transition\n\t\t filtered-plz-72764\t\t filtered-freie-plaetze-z \t\t filtered-angebotstyp-2\t\tpost_name-beratungs-und-interventionsstelle-8123\t";
                                                                                                  <http://www.w3.org/1999/xhtml#id>
                                                                                                          "mse-beratungs-und-interventionsstelle-8123";
                                                                                                  <http://www.w3.org/1999/xhtml#itemscope>
                                                                                                          "";
                                                                                                  <http://www.w3.org/1999/xhtml#itemtype>
                                                                                                          "https://schema.org/LocalBusiness";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Reutlingen</small>\n  <br>\n  Beratungs- und Interventionsstelle</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Diakonieverband Reutlingen</span>\n   <br>\n   <span itemprop=\"streetAddress\">Planie 17</span>\n   <br>\n   <span itemprop=\"postalCode\">72764</span><span itemprop=\"addressLocality\">Reutlingen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:07121-94860\" itemprop=\"telephone\">07121-94860</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8123 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8123\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungs-und-interventionsstelle-8123\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungs-und-interventionsstelle-8123\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Bei uns werden Sie im Fall einer Ehe- oder Partnerschaftskrise, bei der körperliche oder seelische Gewalt geschieht, schnell beraten – auch zuhause. Dieses Angebot ist offen für alle Menschen, unabhängig von Alter, Geschlecht, Nationalität, Religion, Beruf und Einkommen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://diakonie-reutlingen.de/rat-und-hilfe/beratung/diakonieverband-reutlingen-beratung-bei-haeuslicher-gewalt\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://diakonie-reutlingen.de/rat-und-hilfe/beratung/diakonieverband-reutlingen-beratung-bei-haeuslicher-gewalt</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Reutlingen Beratungs- und Interventionsstelle Adresse d. Beratungsstelle Diakonieverband Reutlingen Planie 17 72764 Reutlingen Telefon 07121-94860 Mehr erfahren Bei uns werden Sie im Fall einer Ehe- oder Partnerschaftskrise, bei der körperliche oder seelische Gewalt geschieht, schnell beraten – auch zuhause. Dieses Angebot ist offen für alle Menschen, unabhängig von Alter, Geschlecht, Nationalität, Religion, Beruf und Einkommen. Internet https://diakonie-reutlingen.de/rat-und-hilfe/beratung/diakonieverband-reutlingen-beratung-bei-haeuslicher-gewalt"
                                                                                                ];
