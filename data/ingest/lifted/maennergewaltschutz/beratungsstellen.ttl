                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Stralsund</small>\n  <br>\n  M.I.S.S. Fachberatungsstelle gegen sexualisierte Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">fair - gewaltfrei und selbstbestimmt e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Frankendamm 5</span>\n   <br>\n   <span itemprop=\"postalCode\">18439</span><span itemprop=\"addressLocality\">Stralsund</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:kontakt@miss-beratungsstelle.de\" itemprop=\"email\">kontakt@miss-beratungsstelle.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03831%20667%2093%2063\" itemprop=\"telephone\">03831 667 93 63</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9061 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9061\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-m-i-s-s-fachberatungsstelle-gegen-sexualisierte-gewalt-9061\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-m-i-s-s-fachberatungsstelle-gegen-sexualisierte-gewalt-9061\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://miss-beratungsstelle.de/angebote/index.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://miss-beratungsstelle.de/angebote/index.html</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Stralsund M.I.S.S. Fachberatungsstelle gegen sexualisierte Gewalt Adresse d. Beratungsstelle fair - gewaltfrei und selbstbestimmt e. V. Frankendamm 5 18439 Stralsund E-Mail kontakt@miss-beratungsstelle.de Telefon 03831 667 93 63 Mehr erfahren Beratung für Betroffene von sexualisierter Gewalt. Internet https://miss-beratungsstelle.de/angebote/index.html"
