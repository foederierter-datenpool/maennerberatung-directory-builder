                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Lingen</small>\n  <br>\n  Opferhilfebüro Osnabrück/Zweigstelle Lingen</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Stiftung Opferhilfe Niedersachsen</span>\n   <br>\n   <span itemprop=\"streetAddress\">Kivelingstr. 5</span>\n   <br>\n   <span itemprop=\"postalCode\">49808</span><span itemprop=\"addressLocality\">Lingen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:Poststelleosnabrueck@opferhilfe.niedersachsen.de\" itemprop=\"email\">Poststelleosnabrueck@opferhilfe.niedersachsen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0591-96695416\" itemprop=\"telephone\">0591-96695416</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12415 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12415\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-opferhilfebuero-osnabrueck-zweigstelle-lingen-12415\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-opferhilfebuero-osnabrueck-zweigs