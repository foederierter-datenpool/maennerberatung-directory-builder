                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Kreisverband Schwerin-Parchim e.V.</span>\n  <br>\n  <span itemprop=\"streetAddress\">Rudolf-Breitscheid-Straße 27</span>\n  <br>\n  <span itemprop=\"postalCode\">23936</span><span itemprop=\"addressLocality\">Grevesmühlen</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:03881%20-%2075%2085%2064\" itemprop=\"telephone\">03881 - 75 85 64</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8598 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8598\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-fuer-betroffene-von-haeuslicher-gewalt-grevesmuehlen-8598\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
