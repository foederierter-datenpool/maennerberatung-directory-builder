                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Stiftung Opferhilfe Niedersachsen</span>\n  <br>\n  <span itemprop=\"streetAddress\">Münzstraße 17</span>\n  <br>\n  <span itemprop=\"postalCode\">38100</span><span itemprop=\"addressLocality\">Braunschweig</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">E-Mail</div>\n <div class=\"col-xs-8\">\n  <a href=\"mailto:PostststelleBraunschweig@Opferhilfe.Niedersachsen.de\" itemprop=\"email\">PostststelleBraunschweig@Opferhilfe.Niedersachsen.de</a>\n </div>\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:0531/488%201072\" itemprop=\"telephone\">0531/488 1072</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12408 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12408\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-opferhilfebuero-braunschweig-12408\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
