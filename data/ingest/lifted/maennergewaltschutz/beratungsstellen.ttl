                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Parchim</small>\n  <br>\n  Beratungsstelle für Betroffene häuslicher Gewalt Parchim</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Kreisverband Ludwigslust e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Ziegenmarkt 4 - 7</span>\n   <br>\n   <span itemprop=\"postalCode\">19370</span><span itemprop=\"addressLocality\">Parchim</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:beratung-haeusliche-gewalt@awo-ludwigslust.de\" itemprop=\"email\">beratung-haeusliche-gewalt@awo-ludwigslust.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:+49%203871%20265977\" itemprop=\"telephone\">+49 3871 265977</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9063 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9063\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-fuer-betroffene-haeuslicher-gewalt-parchim-9063\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-fuer-betroffene-haeuslicher-gewalt-parchim-9063\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.awo-ludwigslust.de/hilfe-und-beratung/beratungsstelle-fuer-opfer-haeuslicher-gewalt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.awo-ludwigslust.de/hilfe-und-beratung/beratungsstelle-fuer-opfer-haeuslicher-gewalt/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Parchim Beratungsstelle für Betroffene häuslicher Gewalt Parchim Adresse d. Beratungsstelle AWO Kreisverband Ludwigslust e.V. Ziegenmarkt 4 - 7 19370 Parchim E-Mail beratung-haeusliche-gewalt@awo-ludwigslust.de Telefon +49 3871 265977 Mehr erfahren Beratung für Betroffene von häuslicher Gewalt. Internet https://www.awo-ludwigslust.de/hilfe-und-beratung/beratungsstelle-fuer-opfer-haeuslicher-gewalt/"
