                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Hamburg</small>\n  <br>\n  Psychosoziale Beratung für schwule, bisexuelle und queere Männer</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Magnus Hirschfeld Zentrum</span>\n   <br>\n   <span itemprop=\"streetAddress\">Borgweg 8</span>\n   <br>\n   <span itemprop=\"postalCode\">22303</span><span itemprop=\"addressLocality\">Hamburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:schwulenberatung@mhc-hamburg.de\" itemprop=\"email\">schwulenberatung@mhc-hamburg.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:040-279%2000%2069\" itemprop=\"telephone\">040-279 00 69</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12147 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12147\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-psychosoziale-beratung-fuer-schwule-bisexuelle-und-queere-maenner-12147\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-psychosoziale-beratung-fuer-schwule-bisexuelle-und-queere-maenner-12147\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratungsangebot für schwule, bisexuelle und queere Männer in allen Lebenslagen u.a. auch Gewalterfahrungen und Diskriminierung.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.mhc-hh.de\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.mhc-hh.de</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Hamburg Psychosoziale Beratung für schwule, bisexuelle und queere Männer Adresse d. Beratungsstelle Magnus Hirschfeld Zentrum Borgweg 8 22303 Hamburg E-Mail schwulenberatung@mhc-hamburg.de Telefon 040-279 00 69 Mehr erfahren Beratungsangebot für schwule, bisexuelle und queere Männer in allen Lebenslagen u.a. auch Gewalterfahrungen und Diskriminierung. Internet https://www.mhc-hh.de"
                                                                                                ];
