                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Berlin</small>\n  <br>\n  Tauwetter e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Tauwetter e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Gneisenaustr. 2a</span>\n   <br>\n   <span itemprop=\"postalCode\">10961</span><span itemprop=\"addressLocality\">Berlin</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:030%20-%20693%2080%2007\" itemprop=\"telephone\">030 - 693 80 07</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8992 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8992\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-tauwetter-e-v-8992\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-tauwetter-e-v-8992\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Anlaufstelle, für Männer*, die in Kindheit und Jugend sexualisierter Gewalt ausgesetzt waren.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://tauwetter.de/beratung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://tauwetter.de/beratung/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
