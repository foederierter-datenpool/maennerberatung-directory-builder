                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Heidelberg</small>\n  <br>\n  Männer Notruf Heidelberg</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">fairmann gUG</span>\n   <br>\n   <span itemprop=\"streetAddress\">Parkstraße 15</span>\n   <br>\n   <span itemprop=\"postalCode\">69126</span><span itemprop=\"addressLocality\">Heidelberg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:06221%20-%20651%2067%2067\" itemprop=\"telephone\">06221 - 651 67 67</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7441 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7441\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maenner-notruf-heidelberg-7441\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maenner-notruf-heidelberg-7441\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für von Gewalt betroffenen Männern.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://maennernotruf.org/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://maennernotruf.org/</a>\n  </div>\n </div>\n</div>";
