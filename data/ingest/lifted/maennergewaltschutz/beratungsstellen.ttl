                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Träger </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Rheydt e.V.</span>\n  <br>\n  <span itemprop=\"streetAddress\">Waisenhausstr. 22</span>\n  <br>\n  <span itemprop=\"postalCode\">41236</span><span itemprop=\"addressLocality\">Mönchengladbach-Rheydt</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">Plätze</div>\n <div class=\"col-xs-8\">4</div>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:02166/130%2097%2033\" itemprop=\"telephone\">02166/130 97 33</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7016 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7016\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-freiraum-7016\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
