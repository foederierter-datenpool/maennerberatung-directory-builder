                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Leipzig</small>\n  <br>\n  Männersprechzeit</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Opferhilfe Sachsen e.V. Leipzig</span>\n   <br>\n   <span itemprop=\"streetAddress\">Kochstraße 1</span>\n   <br>\n   <span itemprop=\"postalCode\">04275</span><span itemprop=\"addressLocality\">Leipzig</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0341%20/%2022%2054%20318\" itemprop=\"telephone\">0341 / 22 54 318</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7717 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7717\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennersprechzeit-7717\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennersprechzeit-7717\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Jungen &amp; Männer, die von Gewalt betroffen sind.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.opferhilfe-sachsen.de/kontakt/leipzig/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.opferhilfe-sachsen.de/kontakt/leipzig/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Leipzig Männersprechzeit Adresse d. Beratungsstelle Opferhilfe Sachsen e.V. Leipzig Kochstraße 1 04275 Leipzig Telefon 0341 / 22 54 318 Mehr erfahren Beratung für Jungen & Männer, die von Gewalt betroffen sind. Internet https://www.opferhilfe-sachsen.de/kontakt/leipzig/"
                                                                                                ];
