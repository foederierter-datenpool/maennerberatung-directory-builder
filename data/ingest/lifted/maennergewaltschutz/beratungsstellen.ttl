                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Riesa</small>\n  <br>\n  Beratungs- und Interventionsstelle gegen häusliche Gewalt und Stalking</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SkF e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Kurt-Schlosser-Straße 22</span>\n   <br>\n   <span itemprop=\"postalCode\">01591</span><span itemprop=\"addressLocality\">Riesa</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0351%20–%207955%202205\" itemprop=\"telephone\">0351 – 7955 2205</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8799 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8799\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungs-und-interventionsstelle-gegen-haeusliche-gewalt-und-stalking-8799\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungs-und-interventionsstelle-gegen-haeusliche-gewalt-und-stalking-8799\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Unterstützung für von häuslicher Gewalt und Stalking betroffenener Menschen im Landkreis Meißen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://frauenhaus-skf-radebeul.de/beratungs-interventionsstelle/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://frauenhaus-skf-radebeul.de/beratungs-interventionsstelle/</a>\n  </div>\n </div>\n</div>";
