                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Rostock</small>\n  <br>\n  Fachberatungsstelle gegen sexualisierte Gewalt Rostock</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">STARK MACHEN e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Ernst-Haeckel-Str. 1</span>\n   <br>\n   <span itemprop=\"postalCode\">18059</span><span itemprop=\"addressLocality\">Rostock</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:fachberatungsstelle@stark-machen.de\" itemprop=\"email\">fachberatungsstelle@stark-machen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0381%20/%20440%2032%2090\" itemprop=\"telephone\">0381 / 440 32 90</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9053 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9053\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-fachberatungsstelle-gegen-sexualisierte-gewalt-rostock-9053\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-fachberatungsstelle-gegen-sexualisierte-gewalt-rostock-9053\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung und Unterstützung für Betroffene sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.stark-machen.de/kontakt-fachberatungsstelle\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.stark-machen.de/kontakt-fachberatungsstelle</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Rostock Fachberatungsstelle gegen sexualisierte Gewalt Rostock Adresse d. Beratungsstelle STARK MACHEN e.V. Ernst-Haeckel-Str. 1 18059 Rostock E-Mail fachberatungsstelle@stark-machen.de Telefon 0381 / 440 32 90 Mehr erfahren Beratung und Unterstützung für Betroffene sexualisierter Gewalt. Internet https://www.stark-machen.de/kontakt-fachberatungsstelle"
                                                                                                ];
