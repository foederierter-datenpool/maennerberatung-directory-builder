                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Halle (Saale)</small>\n  <br>\n  Interventionsstelle „Häusliche Gewalt &amp; Stalking“ Halle</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Regionalverband Halle-Merseburg e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Trakehner Straße 47</span>\n   <br>\n   <span itemprop=\"postalCode\">06124</span><span itemprop=\"addressLocality\">Halle (Saale)</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0345%20–%206867907.\" itemprop=\"telephone\">0345 – 6867907.</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7049 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7049\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-interventionsstelle-haeusliche-gewalt-stalking-halle-7049\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-interventionsstelle-haeusliche-gewalt-stalking-halle-7049\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von häuslicher Gewalt und Stalking.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.awo-halle-merseburg.de/angebote/beratung-und-unterstuetzung/interventionsstelle-bei-haeuslicher-gewaltstalking/angebote-interventionsstelle/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.awo-halle-merseburg.de/angebote/beratung-und-unterstuetzung/interventionsstelle-bei-haeuslicher-gewaltstalking/angebote-interventionsstelle/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
