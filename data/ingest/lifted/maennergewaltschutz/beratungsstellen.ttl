                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Hannover</small>\n  <br>\n  Opferhilfebüro Hannover</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Stiftung Opferhilfe Niedersachsen</span>\n   <br>\n   <span itemprop=\"streetAddress\">Weinstr. 20</span>\n   <br>\n   <span itemprop=\"postalCode\">30171</span><span itemprop=\"addressLocality\">Hannover</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:PoststelleHannover@opferhilfe.Niedersachsen.de\" itemprop=\"email\">PoststelleHannover@opferhilfe.Niedersachsen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0511%20/%20347%20-%201012\" itemprop=\"telephone\">0511 / 347 - 1012</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12412 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12412\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-opferhilfebuero-hannover-12412\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-opferhilfebuero-hannover-12412\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung von Opfern von Gewalt. Auch Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.opferhilfe.niedersachsen.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.opferhilfe.niedersachsen.de/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Hannover Opferhilfebüro Hannover Adresse d. Beratungsstelle Stiftung Opferhilfe Niedersachsen Weinstr. 20 30171 Hannover E-Mail PoststelleHannover@opferhilfe.Niedersachsen.de Telefon 0511 / 347 - 1012 Mehr erfahren Beratung von Opfern von Gewalt. Auch Onlineberatung möglich. Internet https://www.opferhilfe.niedersachsen.de/"
                                                                                                ];
