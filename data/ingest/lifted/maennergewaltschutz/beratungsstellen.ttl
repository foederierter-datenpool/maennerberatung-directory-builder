                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Hannover</small>\n  <br>\n  Männerbüro Hannover e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Männerbüro Hannover e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Ilse-ter-Meer-Weg 7</span>\n   <br>\n   <span itemprop=\"postalCode\">30449</span><span itemprop=\"addressLocality\">Hannover</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0511%20123%20589%20-%200\" itemprop=\"telephone\">0511 123 589 - 0</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6964 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6964\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerbuero-hannover-e-v-6964\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerbuero-hannover-e-v-6964\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Das Beratungsangebot richtet sich an Männer, die im häuslichen Kontext Opfer von Gewalthandlungen geworden sind. Auch telefonische Beratung möglich.</p>\n </div>\n <!-- url -->\n <div clas