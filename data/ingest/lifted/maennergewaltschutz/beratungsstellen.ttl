                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Nürnberg</small>\n  <br>\n  Beratungsstelle Häusliche Gewalt gegen Männer</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Institut für Soziale und Kulturelle Arbeit (ISKA) gemeinnützige GmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Gostenhofer Hauptstr. 63</span>\n   <br>\n   <span itemprop=\"postalCode\">90443</span><span itemprop=\"addressLocality\">Nürnberg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:(09%2011)%2027%2029%2098%2020\" itemprop=\"telephone\">(09 11) 27 29 98 20</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6955 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6955\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-haeusliche-gewalt-gegen-maenner-6955\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-haeusliche-gewalt-gegen-maenner-6955\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für von häuslicher Gewalt betroffenen Männern.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.iska-nuernberg.de/bhgm/beratungnue.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.iska-nuernberg.de/bhgm/beratungnue.html</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
