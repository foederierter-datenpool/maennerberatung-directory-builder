oggle content -->\n    <div class=\"item-content toggle-content\" id=\"mse-content-lsbti-krisenwohnung-9774\">\n     <div class=\"\" itemprop=\"description\">\n      <p class=\"\">Die LSBTIQ*-Schutzwohnung bietet eine anonyme, temporäre Unterkunft für volljährige Personen, die von Gewalt aufgrund ihrer sexuellen und/oder geschlechtlichen Identität bedroht sind, z.B. häusliche Gewalt und Zwangsverheiratung.</p>\n     </div>\n     <!-- url -->\n     <div class=\"row\">\n      <div class=\"col-xs-4\">Internet</div>\n      <div class=\"col-xs-8 item-link\">\n       <a href=\"https://awo-schutzwohnung.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://awo-schutzwohnung.de/</a>\n      </div>\n     </div>\n    </div>\n   </div>\n   <div style=\"display:none\" class=\"wpv-addon-maps-marker js-wpv-addon-maps-marker js-wpv-addon-maps-marker-marker-9774 js-wpv-addon-maps-markerfor-map-bs\" data-marker=\"marker-9774\" data-markertitle=\"LSBTI*-Krisenwohnung\" data-markerfor=\"map-bs\" data-markerlat=\"52.514745\" data-markerlon=\"13.474462\" data-markericon=\"https://www.maennergewaltschutz.de/files/2023/08/marker-icon-grey.png\" data-markericonhover=\"\" data-streetview=\"no\" data-fromview=\"\">\n    <div class=\"map-info-window left\">\n     <h4><small>Träger</small>\n      <br>\n      LSBTI*-Krisenwohnung</h4>\n     <address>Arbeiterwohlfahrt Kreisverband Berlin Spree-Wuhle e. V.\n      <br>\n      Rigaer Straße 55b\n      <br>\n      10247 Berlin</address>\n     <p>Telefon: <a href=\"tel:0176-16048496\">0176-16048496</a>\n      <br>\n      E-Mail: <a href=\"mailto:erstkontakt@queere-schutzwohnung.de\">erstkontakt@queere-schutzwohnung.de</a></p>\n     <a href=\"https://awo-schutzwohnung.de/\" class=\"button\" target=\"_blank\" rel=\"nofollow\" title=\"LSBTI*-Krisenwohnung\">zur Internetseite</a>\n     <br>\n    </div>\n   </div>\n   <!-- Entry -->\n   <div id=\"mse-gewaltschutz-fuer-maenner-9823\" class=\"\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container po