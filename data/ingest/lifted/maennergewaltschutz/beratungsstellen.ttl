                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>geschlechtsunabhängige Schutzwohnungen</small> <small>in Berlin</small>\n  <br>\n  LSBTI*-Krisenwohnung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Arbeiterwohlfahrt Kreisverband Berlin Spree-Wuhle e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Rigaer Straße 55b</span>\n   <br>\n   <span itemprop=\"postalCode\">10247</span><span itemprop=\"addressLocality\">Berlin</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">5</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:erstkontakt@queere-schutzwohnung.de\" itemprop=\"email\">erstkontakt@queere-schutzwohnung.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0176-16048496\" itemprop=\"telephone\">0176-16048496</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9774 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9774\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-lsbti-krisenwohnung-9774\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-lsbti-krisenwohnung-9774\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Die LSBTIQ*-Schutzwohnung bietet eine anonyme, temporäre Unterkunft für volljährige Personen, die von Gewalt aufgrund ihrer sexuellen und/oder geschlechtlichen Identität bedroht sind, z.B. häusliche Gewalt und Zwangsverheiratung.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://awo-schutzwohnung.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://awo-schutzwohnung.de/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "geschlechtsunabhängige Schutzwohnungen in Berlin LSBTI*-Krisenwohnung Adresse d. Träger Arbeiterwohlfahrt Kreisverband Berlin Spree-Wuhle e. V. Rigaer Straße 55b 10247 Berlin Plätze 5 E-Mail erstkontakt@queere-schutzwohnung.de Telefon 0176-16048496 Mehr erfahren Die LSBTIQ*-Schutzwohnung bietet eine anonyme, temporäre Unterkunft für volljährige Personen, die von Gewalt aufgrund ihrer sexuellen und/oder geschlechtlichen Identität bedroht sind, z.B. häusliche Gewalt und Zwangsverheiratung. Internet https://awo-schutzwohnung.de/"
