                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Stendal</small>\n  <br>\n  DRK Beratungs- und Interventionsstelle Miß-Mut</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">DRK-Kreisverband Östliche Altmark e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Bruchstr. 1</span>\n   <br>\n   <span itemprop=\"postalCode\">39576</span><span itemprop=\"addressLocality\">Stendal</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:miss-mut@drk-stendal.de\" itemprop=\"email\">miss-mut@drk-stendal.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03931%20|%2021%2002%2021\" itemprop=\"telephone\">03931 | 21 02 21</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9156 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9156\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-drk-beratungs-und-interventionsstelle-miss-mut-9156\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-drk-beratungs-und-interventionsstelle-miss-mut-9156\">\n <div class=\"\" itemprop=\"description\"></div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.drk-stendal.de/angebote/beratungs-und-interventionsstelle-miss-mut/ueber-uns.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.drk-stendal.de/angebote/beratungs-und-interventionsstelle-miss-mut/ueber-uns.html</a>\n  </div>\n </div>\n</div>";
