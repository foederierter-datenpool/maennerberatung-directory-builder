                                                                                                          "https://schema.org/LocalBusiness";
                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>geschlechtsunabhängige Schutzwohnungen</small> <small>in Magdeburg</small>\n  <br>\n  Vera – Fachstelle gegen Frauenhandel, Zwangsverheiratung und ehrbezogene Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Landesverband Sachsen-Anhalt e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Seepark 7</span>\n   <br>\n   <span itemprop=\"postalCode\">39116</span><span itemprop=\"addressLocality\">Magdeburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">1</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:vera.schutzwohnung@awo-sachsenanhalt.de\" itemprop=\"email\">vera.schutzwohnung@awo-sachsenanhalt.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0391%2099977868\" itemprop=\"telephone\">0391 99977868</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-10569 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-10569\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-vera-fachstelle-gegen-frauenhandel-zwangsverheiratung-und-ehrbezogene-gewalt-10569\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-vera-fachstelle-gegen-frauenhandel-zwangsverheiratung-und-ehrbezogene-gewalt-10569\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Die AWO Fachstelle Vera bietet anonyme Schutzwohnungen für hochgefährdete von Zwangsverheiratung und ehrbezogener Gewalt betroffene Frauen* und Paare mit Kindern an.\n   <br>\n   Die Mitarbeiterinnen der Schutzwohnungen beraten, begleiten und unterstützen unter anderem bei der psychischen Stabilisierung, der Anonymisierung und der Erarbeitung einer Zukunftsperspektive.\n   <br>\n   Die Gewährleistung der Sicherheit und des Schutzes haben höchste Priorität. Aufgrund dessen unterliegt der Aufenthalt in den Schutzwohnungen hohen Sicherheitsvorkehrungen und verpflichtenden Maßnahmen zur Wahrung der Anonymität.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.awo-sachsenanhalt.de/fachstelle-vera\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.awo-sachsenanhalt.de/fachstelle-vera</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "geschlechtsunabhängige Schutzwohnungen in Magdeburg Vera – Fachstelle gegen Frauenhandel, Zwangsverheiratung und ehrbezogene Gewalt Adresse d. Träger AWO Landesverband Sachsen-Anhalt e.V. Seepark 7 39116 Magdeburg Plätze 1 E-Mail vera.schutzwohnung@awo-sachsenanhalt.de Telefon 0391 99977868 Mehr erfahren Die AWO Fachstelle Vera bietet anonyme Schutzwohnungen für hochgefährdete von Zwangsverheiratung und ehrbezogener Gewalt betroffene Frauen* und Paare mit Kindern an. Die Mitarbeiterinnen der Schutzwohnungen beraten, begleiten und unterstützen unter anderem bei der psychischen Stabilisierung, der Anonymisierung und der Erarbeitung einer Zukunftsperspektive. Die Gewährleistung der Sicherheit und des Schutzes haben höchste Priorität. Aufgrund dessen unterliegt der Aufenthalt in den Schutzwohnungen hohen Sicherheitsvorkehrungen und verpflichtenden Maßnahmen zur Wahrung der Anonymität. Internet https://www.awo-sachsenanhalt.de/fachstelle-vera"
                                                                                                ];
