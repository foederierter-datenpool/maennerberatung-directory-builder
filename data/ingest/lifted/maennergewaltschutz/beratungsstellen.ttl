                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>geschlechtsunabhängige Schutzwohnungen</small> <small>in Plauen</small>\n  <br>\n  Spezialisierte Gewaltschutzeinrichtung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Weissenberg e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Neundorfer Str. 155</span>\n   <br>\n   <span itemprop=\"postalCode\">08523</span><span itemprop=\"addressLocality\">Plauen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">3</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0152-25267210\" itemprop=\"telephone\">0152-25267210</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-4399 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-4399\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-spezialisierte-gewaltschutzeinrichtung-4399\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-spezialisierte-gewaltschutzeinrichtung-4399\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von häusliche Gewalt betroffene Personen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://schutzwohnung.de/inhalte/schutzwohnung/_inhalt/maennerschutzwohnung/maennerschutzwohnung\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://schutzwohnung.de/inhalte/schutzwohnung/_inhalt/maennerschutzwohnung/maennerschutzwohnung</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "geschlechtsunabhängige Schutzwohnungen in Plauen Spezialisierte Gewaltschutzeinrichtung Adresse d. Träger Weissenberg e.V. Neundorfer Str. 155 08523 Plauen Plätze 3 Telefon 0152-25267210 Mehr erfahren Schutzwohnung für von häusliche Gewalt betroffene Personen. Internet https://schutzwohnung.de/inhalte/schutzwohnung/_inhalt/maennerschutzwohnung/maennerschutzwohnung"
