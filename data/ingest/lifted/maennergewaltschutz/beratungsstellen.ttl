igger map -->\n    <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12672 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12672\"></button>\n    <!-- toggle button (triggers hidden button above via js) -->\n    <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-tin-schutzunterkunft-12672\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n   </div>\n   <!-- toggle content -->\n   <div class=\"item-content toggle-content\" id=\"mse-content-tin-schutzunterkunft-12672\">\n    <div class=\"\" itemprop=\"description\">\n     <p class=\"\">Die TIN*-Schutzunterkunft ist ein Projekt der Frauen*hilfe München. Sie bietet trans*, intergeschlechtlichen und nicht-binären Personen* Schutz, Unterstützung und die Möglichkeit, sich aus einer gewaltvollen Lebenssituation zu lösen.</p>\n    </div>\n    <!-- url -->\n    <div class=\"row\">\n     <div class=\"col-xs-4\">Internet</div>\n     <div class=\"col-xs-8 item-link\">\n      <a href=\"https://www.tin-muenchen.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.tin-muenchen.de/</a>\n     </div>\n    </div>\n   </div>\n  </div>\n  <div style=\"display:none\" class=\"wpv-addon-maps-marker js-wpv-addon-maps-marker js-wpv-addon-maps-marker-marker-12672 js-wpv-addon-maps-markerfor-map-bs\" data-marker=\"marker-12672\" data-markertitle=\"TIN* Schutzunterkunft\" data-markerfor=\"map-bs\" data-markerlat=\"48.102205\" data-markerlon=\"11.64386\" data-markericon=\"https://www.maennergewaltschutz.de/files/2023/08/marker-icon-grey.png\" data-markericonhover=\"\" data-streetview=\"no\" data-fromview=\"\">\n   <div class=\"map-info-window left\">\n    <h4><small>Träger</small>\n     <br>\n     TIN* Schutzunterkunft</h4>\n    <address>Frauenhilfe München gemeinnützige GmbH\n     <br>\n     Charles-de-Gaulle-Str. 4\n     <br>\n     81737 München</address>\n    <p>Telefon: <a href=\"tel:089