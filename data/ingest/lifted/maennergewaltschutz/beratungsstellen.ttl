                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Siegburg</small>\n  <br>\n  Echte Männer reden</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Rhein-Sieg-Kreis e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Bahnhofstraße 27</span>\n   <br>\n   <span itemprop=\"postalCode\">53721</span><span itemprop=\"addressLocality\">Siegburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:02241%20177841\" itemprop=\"telephone\">02241 177841</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7010 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7010\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-echte-maenner-reden-7010\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-echte-maenner-reden-7010\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung bei Männern in Krisen und bei Gewalterfahrungen. Auch telefonische Beratung und Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://caritas.erzbistum-koeln.de/rheinsieg-skm/unsere-hilfen/Beratung-fuer-Maenner-und-Jungen/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://caritas.erzbistum-koeln.de/rheinsieg-skm/unsere-hilfen/Beratung-fuer-Maenner-und-Jungen/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Siegburg Echte Männer reden Adresse d. Beratungsstelle SKM Rhein-Sieg-Kreis e.V. Bahnhofstraße 27 53721 Siegburg Telefon 02241 177841 Mehr erfahren Beratung bei Männern in Krisen und bei Gewalterfahrungen. Auch telefonische Beratung und Onlineberatung möglich. Internet https://caritas.erzbistum-koeln.de/rheinsieg-skm/unsere-hilfen/Beratung-fuer-Maenner-und-Jungen/"
