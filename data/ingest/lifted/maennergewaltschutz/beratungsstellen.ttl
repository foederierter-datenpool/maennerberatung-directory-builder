                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Träger </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">VSGB e.V.</span>\n  <br>\n  <span itemprop=\"streetAddress\">Teutoburger Str. 106</span>\n  <br>\n  <span itemprop=\"postalCode\">33607</span><span itemprop=\"addressLocality\">Bielefeld</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">Plätze</div>\n <div class=\"col-xs-8\">4</div>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">E-Mail</div>\n <div class=\"col-xs-8\">\n  <a href=\"mailto:mse@man-o-mann.de\" itemprop=\"email\">mse@man-o-mann.de</a>\n </div>\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:01522.8256243;%2001525.1764336\" itemprop=\"telephone\">01522.8256243; 01525.1764336</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7744 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7744\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-man-o-mann-maennerberatung-7744\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
                                                                                                                      "Adresse d. Träger VSGB e.V. Teutoburger Str. 106 33607 Bielefeld Plätze 4 E-Mail mse@man-o-mann.de Telefon 01522.8256243; 01525.1764336 Mehr erfahren"
                                                                                                            ];
