                                                              rdf:_2    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                          rdf:_1    "Sie können telefonisch oder per eMail Kontakt aufnehmen. Die Sucheregebnisse unter der Karte umfassen auch Beratungsstellen für Männer, die von sexualisierter Gewalt betroffen sind.";
                                                                          <https://html.spec.whatwg.org/#innerHTML>
                                                                                  "Sie können telefonisch oder per eMail Kontakt aufnehmen. Die Sucheregebnisse unter der Karte umfassen auch Beratungsstellen für Männer, die von sexualisierter Gewalt betroffen sind.";
                                                                          <https://html.spec.whatwg.org/#innerText>
                                                                                  "Sie können telefonisch oder per eMail Kontakt aufnehmen. Die Sucheregebnisse unter der Karte umfassen auch Beratungsstellen für Männer, die von sexualisierter Gewalt betroffen sind."
                                                                        ];
                                                              rdf:_3    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
