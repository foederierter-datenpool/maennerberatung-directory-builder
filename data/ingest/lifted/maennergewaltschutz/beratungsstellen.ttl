                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Saarbrücken</small>\n  <br>\n  Beratungs- und Interventionsstelle für Opfer häuslicher Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Sozialdienst katholischer Frauen Saarland e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Richard-Wagner-Str. 17</span>\n   <br>\n   <span itemprop=\"postalCode\">66111</span><span itemprop=\"addressLocality\">Saarbrücken</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0681%20/%2093%2062%2059%20–%200\" itemprop=\"telephone\">0681 / 93 62 59 – 0</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8612 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8612\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungs-und-interventionsstelle-fuer-opfer-haeuslicher-gewalt-8612\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungs-und-interventionsstelle-fuer-opfer-haeuslicher-gewalt-8612\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Die Beratungs- und Interventionsstelle für Opfer häuslicher Gewalt bietet saarlandweit Kurzzeit- und Krisenberatung für Opfer häuslicher Gewalt an.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.skf-saarbruecken.de/taetigkeitsbereiche/beratungs-und-interventionsstelle-fuer-opfer-haeuslicher-gewalt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.skf-saarbruecken.de/taetigkeitsbereiche/beratungs-und-interventionsstelle-fuer-opfer-haeuslicher-gewalt/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
