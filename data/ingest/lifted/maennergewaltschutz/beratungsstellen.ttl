                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Münster/Westf.</small>\n  <br>\n  Zartbitter Münster e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Zartbitter Münster e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Hammer Straße 220</span>\n   <br>\n   <span itemprop=\"postalCode\">48153</span><span itemprop=\"addressLocality\">Münster/Westf.</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:+49%20251%204140555\" itemprop=\"telephone\">+49 251 4140555</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8991 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8991\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-zartbitter-muenster-e-v-8991\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-zartbitter-muenster-e-v-8991\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Menschen, die sexualisierte Gewalt erlebt haben.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.zartbitter-muenster.de/beratung\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.zartbitter-muenster.de/beratung</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
