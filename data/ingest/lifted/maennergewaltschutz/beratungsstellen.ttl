                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"streetAddress\">Bahnhofstraße 16</span>\n  <br>\n  <span itemprop=\"postalCode\">17489</span><span itemprop=\"addressLocality\">Greifswald</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">E-Mail</div>\n <div class=\"col-xs-8\">\n  <a href=\"mailto:anonym@caritas-vorpommern.de\" itemprop=\"email\">anonym@caritas-vorpommern.de</a>\n </div>\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:+49%203834%2079%2083-199\" itemprop=\"telephone\">+49 3834 79 83-199</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9060 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9060\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-fachberatungsstelle-gegen-sexualisierte-gewalt-greifswald-9060\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
