                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Freiburg</small>\n  <br>\n  Fachstelle gegen sexuellen Missbrauch an Mädchen und Jungen</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Wendepunkt e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Talstraße 4</span>\n   <br>\n   <span itemprop=\"postalCode\">79102</span><span itemprop=\"addressLocality\">Freiburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:(0761)%20707%2011%2091\" itemprop=\"telephone\">(0761) 707 11 91</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9007 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9007\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-fachstelle-gegen-sexuellen-missbrauch-an-maedchen-und-jungen-9007\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-fachstelle-gegen-sexuellen-missbrauch-an-maedchen-und-jungen-9007\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.wendepunkt-freiburg.de/content/main/fuer-frauen-maenner/beratung-begleitung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.wendepunkt-freiburg.de/content/main/fuer-frauen-maenner/beratung-begleitung/</a>\n  </div>\n </div>\n</div>";
