                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Bautzen</small>\n  <br>\n  Interventionsstelle gegen häusliche Gewalt Ostsachsen</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Frauenschutzhaus Bautzen e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Lessingstraße 4</span>\n   <br>\n   <span itemprop=\"postalCode\">02625</span><span itemprop=\"addressLocality\">Bautzen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0%2035%2091%2027%2058%2024\" itemprop=\"telephone\">0 35 91 27 58 24</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8792 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8792\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-interventionsstelle-gegen-haeusliche-gewalt-ostsachsen-8792\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-interventionsstelle-gegen-haeusliche-gewalt-ostsachsen-8792\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Das Beratungsangebot richtet sich an alle Menschen, die im Landkreis Bautzen leben und von häuslicher Gewalt oder Stalking betroffen sind – unabhängig von Geschlecht, sexueller Orientierung, Alter, Nationalität, Aufenthaltsstatus oder Weltanschauung.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://interventionsstelle-ostsachsen.de/interventionsstelle/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://interventionsstelle-ostsachsen.de/interventionsstelle/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Bautzen Interventionsstelle gegen häusliche Gewalt Ostsachsen Adresse d. Beratungsstelle Frauenschutzhaus Bautzen e.V. Lessingstraße 4 02625 Bautzen Telefon 0 35 91 27 58 24 Mehr erfahren Das Beratungsangebot richtet sich an alle Menschen, die im Landkreis Bautzen leben und von häuslicher Gewalt oder Stalking betroffen sind – unabhängig von Geschlecht, sexueller Orientierung, Alter, Nationalität, Aufenthaltsstatus oder Weltanschauung. Internet https://interventionsstelle-ostsachsen.de/interventionsstelle/"
                                                                                                ];
