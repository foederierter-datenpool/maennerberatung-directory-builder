                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Dresden</small>\n  <br>\n  D.I.K. Dresdner Interventions- und Koordinierungsstelle zur Bekämpfung häuslicher Gewalt</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Frauenschutzhaus Dresden e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Laurinstrasse 6</span>\n   <br>\n   <span itemprop=\"postalCode\">01067</span><span itemprop=\"addressLocality\">Dresden</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0351/%208%20567%20210\" itemprop=\"telephone\">0351/ 8 567 210</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8795 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8795\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-d-i-k-dresdner-interventions-und-koordinierungsstelle-zur-bekaempfung-haeuslicher-gewalt-8795\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-d-i-k-dresdner-interventions-und-koordinierungsstelle-zur-bekaempfung-haeuslicher-gewalt-8795\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Das Angebot richtet sich an von häuslicher Gewalt betroffene Frauen und Männer, Freunde, Angehörige und professionelle HelferInnen, die Betroffene unterstützen wollen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.fsh-dresden.de/beratung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.fsh-dresden.de/beratung/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Dresden D.I.K. Dresdner Interventions- und Koordinierungsstelle zur Bekämpfung häuslicher Gewalt Adresse d. Beratungsstelle Frauenschutzhaus Dresden e.V. Laurinstrasse 6 01067 Dresden Telefon 0351/ 8 567 210 Mehr erfahren Das Angebot richtet sich an von häuslicher Gewalt betroffene Frauen und Männer, Freunde, Angehörige und professionelle HelferInnen, die Betroffene unterstützen wollen. Internet https://www.fsh-dresden.de/beratung/"
                                                                                                ];
