                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Flensburg</small>\n  <br>\n  Männerberatung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">pro familia Flensburg</span>\n   <br>\n   <span itemprop=\"streetAddress\">Marienstraße 29-31</span>\n   <br>\n   <span itemprop=\"postalCode\">24937</span><span itemprop=\"addressLocality\">Flensburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:04%2061%20–%2090%2092%20642\" itemprop=\"telephone\">04 61 – 90 92 642</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6958 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6958\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerberatung-6958\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerberatung-6958\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Männer, die sexuelle und häusliche Gewalt erlebt haben. Auch telefonische Beratung und Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.profamilia.de/angebote-vor-ort/schleswig-holstein/beratungsstelle-flensburg/maennerberatung\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.profamilia.de/angebote-vor-ort/schleswig-holstein/beratungsstelle-flensburg/maennerberatung</a>\n  </div>\n </div>\n</div>";
