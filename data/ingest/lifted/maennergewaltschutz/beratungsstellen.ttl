                                      <https://html.spec.whatwg.org/#innerHTML>
                                              "<div class=\"service-container clearfix\">\n <div class=\"container-fluid clearfix\">\n  <div class=\"row\">\n   <div class=\"col-xs-12 col-sm-6 col-md-7 newsletter-container center\">\n    <h3 class=\"likeHeadline\">Newsletter bestellen</h3>\n    <div class=\"tnp tnp-subscription \">\n     <form method=\"post\" action=\"https://www.maennergewaltschutz.de/?na=s\">\n      <input type=\"hidden\" name=\"nlang\" value=\"de\">\n      <div class=\"tnp-field tnp-field-email\">\n       <label for=\"tnp-1\">E-Mail</label><input class=\"tnp-email\" type=\"email\" name=\"ne\" id=\"tnp-1\" value=\"\" placeholder=\"\" required>\n      </div>\n      <div class=\"tnp-field tnp-lists\">\n       <div class=\"tnp-field tnp-field-checkbox tnp-field-list\">\n        <label for=\"nl3\"><input type=\"checkbox\" id=\"nl3\" name=\"nl[]\" value=\"6\"> Pressemitteilungen</label>\n       </div>\n       <div class=\"tnp-field tnp-field-checkbox tnp-field-list\">\n        <label for=\"nl4\"><input type=\"checkbox\" id=\"nl4\" name=\"nl[]\" value=\"7\"> regelmäßige News aus der Männer*gewaltschutzarbeit</label>\n       </div>\n       <div class=\"tnp-field tnp-field-checkbox tnp-field-list\">\n        <label for=\"nl5\"><input type=\"checkbox\" id=\"nl5\" name=\"nl[]\" value=\"8\"> Veranstaltungshinweise</label>\n       </div>\n      </div>\n      <div class=\"tnp-field tnp-privacy-field\">\n       <label><input type=\"checkbox\" name=\"ny\" required class=\"tnp-privacy\"> <a target=\"_blank\" href=\"https://www.maennergewaltschutz.de/service/datenschutz/\">Ich habe die Datenschutzbestimmungen gelesen, verstanden und akzeptiere sie.</a></label>\n      </div>\n      <div class=\"tnp-field tnp-field-button\" style=\"text-align: left\">\n       <input class=\"tnp-submit\" type=\"submit\" value=\"Anmelden\" style=\"\">\n      </div>\n     </form>\n    </div>\n   </div>\n   <div class=\"col-md-1\"></div>\n   <div class=\"col-xs-12 col-sm-6 col-md-4 newsletter-container center\">\n    <p><a href=\"https://www.gemeinsam-gegen-sexismus.de/\" target=\"_blank\" rel=\"noopener\"><img loading=\"lazy\" decoding=\"async\" class=\"alignleft wp-image-9302\" src=\"https://www.maennergewaltschutz.de/files/2023/09/logo_eaf_ggs_rgb_schwarz350.png\" alt=\"\" width=\"200\" height=\"109\"></a></p>\n    <br>\n   </div>\n  </div>\n  <div class=\"row\">\n   <div class=\"col-xs-12 col-sm-6 col-md-7 center\"></div>\n   <div class=\"col-md-1\"></div>\n   <div class=\"col-xs-12 col-sm-6 col-md-4 center\">\n    <p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-12074\" src=\"https://www.maennergewaltschutz.de/files/2025/09/BMBFSFJ_de_v1_farbig-1-400x216.png\" alt=\"\" width=\"220\" height=\"119\" srcset=\"https://www.maennergewaltschutz.de/files/2025/09/BMBFSFJ_de_v1_farbig-1-400x216.png 400w, https://www.maennergewaltschutz.de/files/2025/09/BMBFSFJ_de_v1_farbig-1-1280x690.png 1280w, https://www.maennergewaltschutz.de/files/2025/09/BMBFSFJ_de_v1_farbig-1-1536x828.png 1536w, https://www.maennergewaltschutz.de/files/2025/09/BMBFSFJ_de_v1_farbig-1-2048x1104.png 2048w\" sizes=\"auto, (max-width: 220px) 100vw, 220px\"></p>\n    <br>\n   </div>\n  </div>\n </div>\n</div>\n<div class=\"copy-container clearfix\">\n <div class=\"container-fluid clearfix\">\n  <div class=\"row\">\n   <div class=\"col-xs-12 col-sm-6\">© 2026 Männergewaltschutz</div>\n   <div class=\"col-xs-12 col-sm-6 social-container right\">\n    <a target=\"_blank\" href=\"https://www.facebook.com/BFKMaenner\"><i class=\"fa fa-facebook-square fa-fw\"></i></a><a target=\"_blank\" href=\"https://www.tiktok.com/@maennergewaltschutz\"><i class=\"fa fa-tiktok fa-fw\"></i></a> <a target=\"_blank\" href=\"https://www.threads.net/@maennergewaltschutz\"><i class=\"fa fa-threads fa-fw\"></i></a> <a target=\"_blank\" href=\"https://bsky.app/profile/gewaltschutz.bsky.social\"><i class=\"fa fa-bluesky fa-fw\"></i></a> <a target=\"_blank\" href=\"https://www.youtube.com/channel/UCc1MuClh-NtQvbav480NURw\"><i class=\"fa fa-youtube-square fa-fw\"></i></a> <a target=\"_blank\" href=\"https://twitter.com/gewaltschutz\"><i class=\"fa fa-x fa-fw\"></i></a> <a target=\"_blank\" href=\"https://www.instagram.com/maennergewaltschutz/\"><i class=\"fa fa-instagram fa-fw\"></i></a>\n   </div>\n  </div>\n  <div class=\"row\">\n   <nav class=\"col-xs-12 navigation-container center\">\n    <ul class=\"navigation\">\n     <li class=\"page_item page-item-65\"><a href=\"https://www.maennergewaltschutz.de/\">Startseite</a></li>\n     <li class=\"page_item page-item-32\"><a href=\"https://www.maennergewaltschutz.de/service/kontakt/\">Kontakt</a></li>\n     <li class=\"page_item page-item-36\"><a href=\"https://www.maennergewaltschutz.de/service/impressum/\">Impressum</a></li>\n     <li class=\"page_item page-item-34\"><a href=\"https://www.maennergewaltschutz.de/service/datenschutz/\">Datenschutz</a></li>\n     <li class=\"page_item page-item-1939\"><a href=\"https://www.maennergewaltschutz.de/service/geschaeftsbedingungen/\">Geschäftsbedingungen für Veranstaltungen und Fortbildungen</a></li>\n    </ul>\n   </nav>\n  </div>\n </div>\n</div>";
