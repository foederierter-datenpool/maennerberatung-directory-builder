                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Leipzig</small>\n  <br>\n  Männerberatung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">lemann e.V. Leipzig</span>\n   <br>\n   <span itemprop=\"streetAddress\">Bernhard-Göring-Straße 152,</span>\n   <br>\n   <span itemprop=\"postalCode\">04277</span><span itemprop=\"addressLocality\">Leipzig</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0341-3065%20280\" itemprop=\"telephone\">0341-3065 280</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7716 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7716\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerberatung-7716\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerberatung-7716\">\n <div class=\"\" itemprop=\"description\"></div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://lemann-netzwerk.de/maennerberatung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://lemann-netzwerk.de/maennerberatung/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Leipzig Männerberatung Adresse d. Beratungsstelle lemann e.V. Leipzig Bernhard-Göring-Straße 152, 04277 Leipzig Telefon 0341-3065 280 Mehr erfahren Internet https://lemann-netzwerk.de/maennerberatung/"
