                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Nürnberg</small>\n  <br>\n  Jungenbüro Nürnberg</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Schlupfwinkel e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Allersberger Straße 129</span>\n   <br>\n   <span itemprop=\"postalCode\">90461</span><span itemprop=\"addressLocality\">Nürnberg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:info@jungenbuero-nuernberg.de\" itemprop=\"email\">info@jungenbuero-nuernberg.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0911%20528%2014751\" itemprop=\"telephone\">0911 528 14751</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9018 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9018\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-jungenbuero-nuernberg-9018\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-jungenbuero-nuernberg-9018\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für von gewaltbetroffene Jungen und junge Männer. Auch Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://jungenbuero-nuernberg.de/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://jungenbuero-nuernberg.de/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Nürnberg Jungenbüro Nürnberg Adresse d. Beratungsstelle Schlupfwinkel e.V. Allersberger Straße 129 90461 Nürnberg E-Mail info@jungenbuero-nuernberg.de Telefon 0911 528 14751 Mehr erfahren Beratung für von gewaltbetroffene Jungen und junge Männer. Auch Onlineberatung möglich. Internet https://jungenbuero-nuernberg.de/"
