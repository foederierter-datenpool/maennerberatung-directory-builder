                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>geschlechtsunabhängige Schutzwohnungen</small> <small>in Bergen auf Rügen</small>\n  <br>\n  Schutzwohnung des KJFH Rügen e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Kinder,- Jugend- und Familienhilfe Rügen e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Goedeke-Micheel-Hof 1</span>\n   <br>\n   <span itemprop=\"postalCode\">18528</span><span itemprop=\"addressLocality\">Bergen auf Rügen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">1</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:nachricht@kjfh-ruegen.de\" itemprop=\"email\">nachricht@kjfh-ruegen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03838-201793\" itemprop=\"telephone\">03838-201793</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9194 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9194\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-schutzwohnung-des-kjfh-ruegen-e-v-9194\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-schutzwohnung-des-kjfh-ruegen-e-v-9194\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzplatz für Erwachsene aller Geschlechter mit bis zu 4 Kindern verfügbar.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.jugendhilfe-ruegen.de/ankerlicht\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.jugendhilfe-ruegen.de/ankerlicht</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "geschlechtsunabhängige Schutzwohnungen in Bergen auf Rügen Schutzwohnung des KJFH Rügen e.V. Adresse d. Träger Kinder,- Jugend- und Familienhilfe Rügen e.V. Goedeke-Micheel-Hof 1 18528 Bergen auf Rügen Plätze 1 E-Mail nachricht@kjfh-ruegen.de Telefon 03838-201793 Mehr erfahren Schutzplatz für Erwachsene aller Geschlechter mit bis zu 4 Kindern verfügbar. Internet https://www.jugendhilfe-ruegen.de/ankerlicht"
