                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Schwerin</small>\n  <br>\n  Interventionsstelle gegen häusliche Gewalt und Stalking</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Kreisverband Schwerin-Parchim e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Platz der Jugend 8</span>\n   <br>\n   <span itemprop=\"postalCode\">19053</span><span itemprop=\"addressLocality\">Schwerin</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0385%20-%2052%2019%2005%2041\" itemprop=\"telephone\">0385 - 52 19 05 41</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8600 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8600\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-interventionsstelle-gegen-haeusliche-gewalt-und-stalking-8600\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-interventionsstelle-gegen-haeusliche-gewalt-und-stalking-8600\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Die Interventionsstelle richtet sich mit ihrem Beratungsangebot an Betroffene von häuslicher Gewalt unabhängig von Geschlecht und Herkunft.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.awo-schwerin.de/fachbereiche/beratung-erziehung-lebensbewaeltigung/schutz-und-kriesendienste/interventionsstelle-gegen-haeusliche-gewalt-und-stalking-mit-kinder-und-jugendberatung\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.awo-schwerin.de/fachbereiche/beratung-erziehung-lebensbewaeltigung/schutz-und-kriesendienste/interventionsstelle-gegen-haeusliche-gewalt-und-stalking-mit-kinder-und-jugendberatung</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Schwerin Interventionsstelle gegen häusliche Gewalt und Stalking Adresse d. Beratungsstelle AWO Kreisverband Schwerin-Parchim e.V. Platz der Jugend 8 19053 Schwerin Telefon 0385 - 52 19 05 41 Mehr erfahren Die Interventionsstelle richtet sich mit ihrem Beratungsangebot an Betroffene von häuslicher Gewalt unabhängig von Geschlecht und Herkunft. Internet https://www.awo-schwerin.de/fachbereiche/beratung-erziehung-lebensbewaeltigung/schutz-und-kriesendienste/interventionsstelle-gegen-haeusliche-gewalt-und-stalking-mit-kinder-und-jugendberatung"
                                                                                                ];
