                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Wolfsburg</small>\n  <br>\n  Gewaltberatungsstelle Wolfsburg</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Dialog e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Goethestraße 59</span>\n   <br>\n   <span itemprop=\"postalCode\">38440</span><span itemprop=\"addressLocality\">Wolfsburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:05361%2089123%2000\" itemprop=\"telephone\">05361 89123 00</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7146 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7146\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-gewaltberatungsstelle-wolfsburg-7146\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-gewaltberatungsstelle-wolfsburg-7146\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung auch für Männer bei Gewalt in der Partnerschaft.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.dialog-wolfsburg.de/beratungsstelle/erwachsene/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.dialog-wolfsburg.de/beratungsstelle/erwachsene/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Wolfsburg Gewaltberatungsstelle Wolfsburg Adresse d. Beratungsstelle Dialog e.V. Goethestraße 59 38440 Wolfsburg Telefon 05361 89123 00 Mehr erfahren Beratung auch für Männer bei Gewalt in der Partnerschaft. Internet https://www.dialog-wolfsburg.de/beratungsstelle/erwachsene/"
