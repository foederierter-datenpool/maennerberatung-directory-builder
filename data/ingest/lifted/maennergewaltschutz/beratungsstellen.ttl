                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Düsseldorf</small>\n  <br>\n  Freiraum</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM gGmbH Düsseldorf</span>\n   <br>\n   <span itemprop=\"streetAddress\">Sternstr. 71-73</span>\n   <br>\n   <span itemprop=\"postalCode\">40479</span><span itemprop=\"addressLocality\">Düsseldorf</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">4</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0163%20777%203%20111\" itemprop=\"telephone\">0163 777 3 111</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-4486 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-4486\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-freiraum-4486\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-freiraum-4486\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.skmd.de/ambulante-dienste/gewaltschutz-maenner/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.skmd.de/ambulante-dienste/gewaltschutz-maenner/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Düsseldorf Freiraum Adresse d. Träger SKM gGmbH Düsseldorf Sternstr. 71-73 40479 Düsseldorf Plätze 4 Telefon 0163 777 3 111 Mehr erfahren Schutzwohnung für von Gewalt betroffene Männer. Internet https://www.skmd.de/ambulante-dienste/gewaltschutz-maenner/"
                                                                                                ];
