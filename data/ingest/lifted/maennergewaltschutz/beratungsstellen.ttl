                                                                                                                      "<div class=\"row\">\n <div class=\"col-xs-4\">\n  Adresse\n  <br>\n  <small> d. Beratungsstelle </small>\n </div>\n <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Beratung und Prävention e.V.</span>\n  <br>\n  <span itemprop=\"streetAddress\">Casselmannstr. 15</span>\n  <br>\n  <span itemprop=\"postalCode\">95444</span><span itemprop=\"addressLocality\">Bayreuth</span>\n  <br></address>\n</div>\n<div class=\"row\">\n <div class=\"col-xs-4\">E-Mail</div>\n <div class=\"col-xs-8\">\n  <a href=\"mailto:info@avalon-bayreuth.de\" itemprop=\"email\">info@avalon-bayreuth.de</a>\n </div>\n <div class=\"col-xs-4\">Telefon</div>\n <div class=\"col-xs-8\">\n  <a href=\"tel:+49%20921%20512525\" itemprop=\"telephone\">+49 921 512525</a>\n </div>\n</div>\n<!-- hidden button to trigger map -->\n<button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9017 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9017\"></button>\n<!-- toggle button (triggers hidden button above via js) -->\n<button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-avalon-fachberatungsstelle-gegen-sexualisierte-gewalt-9017\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>";
                                                                                                              <https://html.spec.whatwg.org/#innerText>
