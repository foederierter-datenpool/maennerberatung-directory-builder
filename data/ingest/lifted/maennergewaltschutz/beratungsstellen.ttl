                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Schwarzenberg</small>\n  <br>\n  IKOS Erzgebirge</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Erzgebirge gGmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Straße der Einheit 57</span>\n   <br>\n   <span itemprop=\"postalCode\">08340</span><span itemprop=\"addressLocality\">Schwarzenberg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:03774%208199958\" itemprop=\"telephone\">03774 8199958</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8808 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8808\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-ikos-erzgebirge-8808\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-ikos-erzgebirge-8808\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Proaktive Beratung von Gewalt betroffenen Menschen nach Krisenintervention</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"ht