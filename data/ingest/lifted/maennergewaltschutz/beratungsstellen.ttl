                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Weilheim i.OB</small>\n  <br>\n  Netz gegen sexuelle Gewalt Beratungsstelle Weilheim &amp; Oberland</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Netz gegen sexuelle Gewalt e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Lohgasse 3</span>\n   <br>\n   <span itemprop=\"postalCode\">82362</span><span itemprop=\"addressLocality\">Weilheim i.OB</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:info@beratungsstelle-netz.de\" itemprop=\"email\">info@beratungsstelle-netz.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0881%20927922-94\" itemprop=\"telephone\">0881 927922-94</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9015 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9015\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-netz-gegen-sexuelle-gewalt-beratungsstelle-weilheim-oberland-9015\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-netz-gegen-sexuelle-gewalt-beratungsstelle-weilheim-oberland-9015\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.beratungsstelle-netz.de/de/erwachsene.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.beratungsstelle-netz.de/de/erwachsene.html</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
