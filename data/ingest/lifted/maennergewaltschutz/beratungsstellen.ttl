                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Krefeld</small>\n  <br>\n  Echte Männer reden</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Krefeld</span>\n   <br>\n   <span itemprop=\"streetAddress\">Hubertusstr. 97</span>\n   <br>\n   <span itemprop=\"postalCode\">47798</span><span itemprop=\"addressLocality\">Krefeld</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:02151/%208412-26\" itemprop=\"telephone\">02151/ 8412-26</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7022 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7022\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-echte-maenner-reden-7022\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-echte-maenner-reden-7022\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung bei Männern in Krisen und bei Gewalterfahrungen. Auch telefonische Beratung und Onlineberatung möglich.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://skm-krefeld.de/hilfen-angebote/maennerarbeit/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://skm-krefeld.de/hilfen-angebote/maennerarbeit/</a>\n  </div>\n </div>\n</div>";
