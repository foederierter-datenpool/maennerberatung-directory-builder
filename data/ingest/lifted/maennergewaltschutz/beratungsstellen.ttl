                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Berlin</small>\n  <br>\n  MANEO</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Mann-O-Meter e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Bülowstraße 106</span>\n   <br>\n   <span itemprop=\"postalCode\">10783</span><span itemprop=\"addressLocality\">Berlin</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:opferhilfe@maneo.de\" itemprop=\"email\">opferhilfe@maneo.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:030-216%2033%2036\" itemprop=\"telephone\">030-216 33 36</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8586 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8586\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maneo-8586\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maneo-8586\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Maneo hilft schwulen und bisexuellen Jugendlichen und Männern, die von schwulenfeindlicher Gewalt und Diskriminierung betroffen sind – egal ob als Opfer, Tatzeugen oder Lebenspartner der Betroffenen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.maneo.de/maneo-arbeit/opferhilfe/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.maneo.de/maneo-arbeit/opferhilfe/</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Berlin MANEO Adresse d. Beratungsstelle Mann-O-Meter e.V. Bülowstraße 106 10783 Berlin E-Mail opferhilfe@maneo.de Telefon 030-216 33 36 Mehr erfahren Maneo hilft schwulen und bisexuellen Jugendlichen und Männern, die von schwulenfeindlicher Gewalt und Diskriminierung betroffen sind – egal ob als Opfer, Tatzeugen oder Lebenspartner der Betroffenen. Internet https://www.maneo.de/maneo-arbeit/opferhilfe/"
                                                                                                ];
