                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Bremen</small>\n  <br>\n  Stalking-KIT</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Täter-Opfer-Ausgleich Bremen e. V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Am Wall 193</span>\n   <br>\n   <span itemprop=\"postalCode\">28195</span><span itemprop=\"addressLocality\">Bremen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0421-79282890\" itemprop=\"telephone\">0421-79282890</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8594 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8594\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-stalking-kit-8594\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-stalking-kit-8594\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Krisen-Interventions-Team bei Stalking und häuslicher Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://toa-bremen.de/angebote/stalking-kit\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://toa-bremen.de/angebote/stalking-kit</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
