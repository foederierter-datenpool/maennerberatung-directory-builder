                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Oldenburg</small>\n  <br>\n  MännerSache</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Männerwohnhilfe e.V. Oldenburg</span>\n   <br>\n   <span itemprop=\"streetAddress\">Donnerschweer Straße 10</span>\n   <br>\n   <span itemprop=\"postalCode\">26123</span><span itemprop=\"addressLocality\">Oldenburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0176%2021%20444%20373\" itemprop=\"telephone\">0176 21 444 373</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6957 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6957\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennersache-6957\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennersache-6957\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung von Mann zu Mann, zu verschiedensten Lebenssituationen und Gewalterfahrungen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n 