                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Hamburg</small>\n  <br>\n  i.bera</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">verikom gGmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Norderreihe 61</span>\n   <br>\n   <span itemprop=\"postalCode\">22767</span><span itemprop=\"addressLocality\">Hamburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:040%20350%2017%2072%2026\" itemprop=\"telephone\">040 350 17 72 26</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8582 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8582\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-i-bera-8582\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-i-bera-8582\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Berät Menschen mit Migrationshintergrund, die in ihrer Beziehung oder Familie Gewalt erleben oder die von einer Zwangsheirat betroffen sind.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item