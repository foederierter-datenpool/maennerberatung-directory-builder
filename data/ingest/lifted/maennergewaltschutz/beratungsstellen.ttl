                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Mainz</small>\n  <br>\n  Beratungsstelle SAFE!</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Opfer-Täterhilfe e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Erthalstr. 2</span>\n   <br>\n   <span itemprop=\"postalCode\">55118</span><span itemprop=\"addressLocality\">Mainz</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:06131%20-%202877711\" itemprop=\"telephone\">06131 - 2877711</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-6842 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-6842\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-safe-6842\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-safe-6842\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für männliche Gewaltopfer in engen sozialen Beziehungen.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.outh.de/angebote/safe.html#content-contact\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.outh.de/angebote/safe.html#content-contact</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Beratungsstelle in Mainz Beratungsstelle SAFE! Adresse d. Beratungsstelle Opfer-Täterhilfe e.V. Erthalstr. 2 55118 Mainz Telefon 06131 - 2877711 Mehr erfahren Beratung für männliche Gewaltopfer in engen sozialen Beziehungen. Internet https://www.outh.de/angebote/safe.html#content-contact"
                                                                                                ];
