                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Stralsund</small>\n  <br>\n  BeLa Vorpommern</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">STARK MACHEN e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Jungfernstieg 14</span>\n   <br>\n   <span itemprop=\"postalCode\">18437</span><span itemprop=\"addressLocality\">Stralsund</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0176%2074%2070%2083%2035\" itemprop=\"telephone\">0176 74 70 83 35</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8597 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8597\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-bela-vorpommern-8597\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-bela-vorpommern-8597\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung und Unterstützung bei der Bewältigung aktueller oder zurückliegender Gewalterfahrungen in Partnerschaft und familiärem Umfeld.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.stark-machen.de/das-team-vorpommern/kontakt-vorpommern\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.stark-machen.de/das-team-vorpommern/kontakt-vorpommern</a>\n  </div>\n </div>\n</div>";
