                                                                                                                          rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                                                      rdf:_1    "Das Beratungsangebot richtet sich an alle Menschen, die im Landkreis Bautzen leben und von häuslicher Gewalt oder Stalking betroffen sind – unabhängig von Geschlecht, sexueller Orientierung, Alter, Nationalität, Aufenthaltsstatus oder Weltanschauung.";
                                                                                                                                      <http://www.w3.org/1999/xhtml#class>
                                                                                                                                              "";
                                                                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                                              "Das Beratungsangebot richtet sich an alle Menschen, die im Landkreis Bautzen leben und von häuslicher Gewalt oder Stalking betroffen sind – unabhängig von Geschlecht, sexueller Orientierung, Alter, Nationalität, Aufenthaltsstatus oder Weltanschauung.";
                                                                                                                                      <https://html.spec.whatwg.org/#innerText>
                                                                                                                                              "Das Beratungsangebot richtet sich an alle Menschen, die im Landkreis Bautzen leben und von häuslicher Gewalt oder Stalking betroffen sind – unabhängig von Geschlecht, sexueller Orientierung, Alter, Nationalität, Aufenthaltsstatus oder Weltanschauung."
                                                                                                                                    ];
                                                                                                                          <http://www.w3.org/1999/xhtml#class>
                                                                                                                                  "";
                                                                                                                          <http://www.w3.org/1999/xhtml#itemprop>
                                                                                                                                  "description";
                                                                                                                          <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                                  "<p class=\"\">Das Beratungsangebot richtet sich an alle Menschen, die im Landkreis Bautzen leben und von häuslicher Gewalt oder Stalking betroffen sind – unabhängig von Geschlecht, sexueller Orientierung, Alter, Nationalität, Aufenthaltsstatus oder Weltanschauung.</p>";
                                                                                                                          <https://html.spec.whatwg.org/#innerText>
                                                                                                                                  "Das Beratungsangebot richtet sich an alle Menschen, die im Landkreis Bautzen leben und von häuslicher Gewalt oder Stalking betroffen sind – unabhängig von Geschlecht, sexueller Orientierung, Alter, Nationalität, Aufenthaltsstatus oder Weltanschauung."
