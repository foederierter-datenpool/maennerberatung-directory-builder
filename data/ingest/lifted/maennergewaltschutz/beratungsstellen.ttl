                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Bruchsal</small>\n  <br>\n  Beratungsstelle Libelle</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SopHiE gGmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Prinz-Wilhelm-Straße 3</span>\n   <br>\n   <span itemprop=\"postalCode\">76646</span><span itemprop=\"addressLocality\">Bruchsal</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:07251%20-%207130%20-323\" itemprop=\"telephone\">07251 - 7130 -323</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9000 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9000\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-libelle-9000\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-libelle-9000\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratungsstelle für Menschen, die Häusliche Gewalt erleben.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.sophie-ggmbh.de/beratungsstelle/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.sophie-ggmbh.de/beratungsstelle/</a>\n  </div>\n </div>\n</div>";
