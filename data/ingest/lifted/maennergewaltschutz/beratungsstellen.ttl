                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Würzburg</small>\n  <br>\n  Beratungsstelle Häusliche Gewalt gegen Männer Unterfranken</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Institut für Soziale und Kulturelle Arbeit (ISKA) gemeinnützige GmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Friedrich-Ebert-Ring 27A</span>\n   <br>\n   <span itemprop=\"postalCode\">97070</span><span itemprop=\"addressLocality\">Würzburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:bhgm-unterfranken@iska-nuernberg.de\" itemprop=\"email\">bhgm-unterfranken@iska-nuernberg.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:(09%2031)%2079%2062%2057%2049\" itemprop=\"telephone\">(09 31) 79 62 57 49</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7040 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7040\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-beratungsstelle-haeusliche-gewalt-gegen-maenner-unterfranken-7040\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-beratungsstelle-haeusliche-gewalt-gegen-maenner-unterfranken-7040\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für von häuslicher Gewalt betroffenen Männern.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.iska-nuernberg.de/bhgmu/index.html\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.iska-nuernberg.de/bhgmu/index.html</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
