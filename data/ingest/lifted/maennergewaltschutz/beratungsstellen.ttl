                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Dresden</small>\n  <br>\n  Männerschutzwohnung Dresden</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Männernetzwerk Dresden e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Schwepnitzer Str. 10</span>\n   <br>\n   <span itemprop=\"postalCode\">01097</span><span itemprop=\"addressLocality\">Dresden</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">4</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0351-32345422\" itemprop=\"telephone\">0351-32345422</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-4371 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-4371\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerschutzwohnung-dresden-4371\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerschutzwohnung-dresden-4371\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von häuslicher Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://mnw-dd.de/schutzwohnung\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://mnw-dd.de/schutzwohnung</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Dresden Männerschutzwohnung Dresden Adresse d. Träger Männernetzwerk Dresden e.V. Schwepnitzer Str. 10 01097 Dresden Plätze 4 Telefon 0351-32345422 Mehr erfahren Schutzwohnung für von häuslicher Gewalt betroffene Männer. Internet https://mnw-dd.de/schutzwohnung"
                                                                                                ];
