                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Waiblingen</small>\n  <br>\n  Flügel</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">pro familia Waiblingen e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Alter Postplatz 17</span>\n   <br>\n   <span itemprop=\"postalCode\">71332</span><span itemprop=\"addressLocality\">Waiblingen</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:info@fluegel-waiblingen.de\" itemprop=\"email\">info@fluegel-waiblingen.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:07151%20–%20982248940\" itemprop=\"telephone\">07151 – 982248940</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-9012 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-9012\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-fluegel-9012\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-fluegel-9012\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Betroffene von sexualisierter Gewalt.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://fluegel-waiblingen.de/beratung-fuer-maenner-bei-sexualisierter-gewalt/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://fluegel-waiblingen.de/beratung-fuer-maenner-bei-sexualisierter-gewalt/</a>\n  </div>\n </div>\n</div>";
