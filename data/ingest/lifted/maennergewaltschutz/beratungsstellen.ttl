                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Hamburg</small>\n  <br>\n  Alivio</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Lawaetz wohnen&amp;leben gGmbH</span>\n   <br>\n   <span itemprop=\"streetAddress\">Amandastr. 60</span>\n   <br>\n   <span itemprop=\"postalCode\">20357</span><span itemprop=\"addressLocality\">Hamburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">3</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">E-Mail</div>\n  <div class=\"col-xs-8\">\n   <a href=\"mailto:fiebig@lawaetz-ggmbh.de\" itemprop=\"email\">fiebig@lawaetz-ggmbh.de</a>\n  </div>\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:040%20334%2065%2090%2010\" itemprop=\"telephone\">040 334 65 90 10</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-12146 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-12146\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-alivio-12146\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-alivio-12146\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für Männer und nicht-binäre Menschen.\n   <br>\n   <br>\n   Kontakt über eine der folgenden Clearing-Stellen:\n   <br>\n   - Opferhilfe Hamburg (040-381993 | mail@opferhilfe-hamburg.de)\n   <br>\n   - basis prevent (040 / 39 84 26 62 | basis-praevent@basisundwoge.de\n   <br>\n   - Lale (040- 57 30 93 020 | lale@ikbev.de)\n   <br>\n   - i.bera (040 350 17 72 26)\n   <br>\n   - MHC – Magnus Hirschfeld Centrum (040-279 00 69 | schwulenberatung@mhc-hamburg.de)</p>\n </div>\n <!-- url -->\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Hamburg Alivio Adresse d. Träger Lawaetz wohnen&leben gGmbH Amandastr. 60 20357 Hamburg Plätze 3 E-Mail fiebig@lawaetz-ggmbh.de Telefon 040 334 65 90 10 Mehr erfahren Schutzwohnung für Männer und nicht-binäre Menschen. Kontakt über eine der folgenden Clearing-Stellen: - Opferhilfe Hamburg (040-381993 | mail@opferhilfe-hamburg.de) - basis prevent (040 / 39 84 26 62 | basis-praevent@basisundwoge.de - Lale (040- 57 30 93 020 | lale@ikbev.de) - i.bera (040 350 17 72 26) - MHC – Magnus Hirschfeld Centrum (040-279 00 69 | schwulenberatung@mhc-hamburg.de)"
