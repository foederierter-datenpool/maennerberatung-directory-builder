class=\"col-xs-4\">Telefon</div>\n    <div class=\"col-xs-8\">\n     <a href=\"tel:0391%2099977868\" itemprop=\"telephone\">0391 99977868</a>\n    </div>\n   </div>\n   <!-- hidden button to trigger map -->\n   <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-10569 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-10569\"></button>\n   <!-- toggle button (triggers hidden button above via js) -->\n   <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-vera-fachstelle-gegen-frauenhandel-zwangsverheiratung-und-ehrbezogene-gewalt-10569\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n  </div>\n  <!-- toggle content -->\n  <div class=\"item-content toggle-content\" id=\"mse-content-vera-fachstelle-gegen-frauenhandel-zwangsverheiratung-und-ehrbezogene-gewalt-10569\">\n   <div class=\"\" itemprop=\"description\">\n    <p class=\"\">Die AWO Fachstelle Vera bietet anonyme Schutzwohnungen für hochgefährdete von Zwangsverheiratung und ehrbezogener Gewalt betroffene Frauen* und Paare mit Kindern an.\n     <br>\n     Die Mitarbeiterinnen der Schutzwohnungen beraten, begleiten und unterstützen unter anderem bei der psychischen Stabilisierung, der Anonymisierung und der Erarbeitung einer Zukunftsperspektive.\n     <br>\n     Die Gewährleistung der Sicherheit und des Schutzes haben höchste Priorität. Aufgrund dessen unterliegt der Aufenthalt in den Schutzwohnungen hohen Sicherheitsvorkehrungen und verpflichtenden Maßnahmen zur Wahrung der Anonymität.</p>\n   </div>\n   <!-- url -->\n   <div class=\"row\">\n    <div class=\"col-xs-4\">Internet</div>\n    <div class=\"col-xs-8 item-link\">\n     <a href=\"https://www.awo-sachsenanhalt.de/fachstelle-vera\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.awo-sachsenanhalt.de/fachstelle-vera</a>\n    </div>\n   </div>\n  </div>\n </div>\n <div style=\"display:none\" class=\"wpv-addon-maps-marker js-wpv-addon-maps-marker js-wpv-addon-maps-marker-marker-10569 js-wpv-addon-maps-markerfor-map-bs\" data-marker=\"marker-10569\" data-markertitle=\"Vera – Fachstelle gegen Frauenhandel, Zwangsverheiratung und ehrbezogene Gewalt\" data-markerfor=\"map-bs\" data-markerlat=\"52.103913\" data-markerlon=\"11.5905\" data-markericon=\"https://www.maennergewaltschutz.de/files/2023/08/marker-icon-grey.png\" data-markericonhover=\"\" data-streetview=\"no\" data-fromview=\"\">\n  <div class=\"map-info-window left\">\n   <h4><small>Träger</small>\n    <br>\n    Vera – Fachstelle gegen Frauenhandel, Zwangsverheiratung und ehrbezogene Gewalt</h4>\n   <address>AWO Landesverband Sachsen-Anhalt e.V.\n    <br>\n    Seepark 7\n    <br>\n    39116 Magdeburg</address>\n   <p>Telefon: <a href=\"tel:0391%2099977868\">0391 99977868</a>\n    <br>\n    E-Mail: <a href=\"mailto:vera.schutzwohnung@awo-sachsenanhalt.de\">vera.schutzwohnung@awo-sachsenanhalt.de</a></p>\n   <a href=\"https://www.awo-sachsenanhalt.de/fachstelle-vera\" class=\"button\" target=\"_blank\" rel=\"nofollow\" title=\"Vera – Fachstelle gegen Frauenhandel, Zwangsverheiratung und ehrbezogene Gewalt\">zur Internetseite</a>\n   <br>\n  </div>\n </div>\n <!-- Entry -->\n <div id=\"mse-gewaltschutzambulanz-bremen-11322\" class=\"\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container position-relative transition\n\t\t filtered-plz-28205\t\t filtered-freie-plaetze-z \t\t filtered-angebotstyp-2\t\tpost_name-gewaltschutzambulanz-bremen-11322\t\" itemscope itemtype=\"https://schema.org/LocalBusiness\">\n  <!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n  <!-- header -->\n  <header class=\"item-header\">\n   <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Bremen</small>\n    <br>\n    Gewaltschutzambulanz Bremen</h3>\n  </header>\n  <!-- content -->\n  <div class=\"item-content\">\n   <div class=\"row\">\n    <div class=\"col-xs-4\">\n     Adresse\n     <br>\n     <small> d. Beratungsstelle </small>\n    </div>\n    <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Klinikum Bremen-Mitte</span>\n     <br>\n     <span itemprop=\"streetAddress\">St.-Jürgen-Straße 1</span>\n     <br>\n     <span itemprop=\"postalCode\">28205</span><span itemprop=\"addressLocality\">Bremen</span>\n     <br></address>\n   </div>\n   <div class=\"row\">\n    <div class=\"col-xs-4\">E-Mail</div>\n    <div class=\"col-xs-8\">\n     <a href=\"mailto:gewaltschutzambulanz@gesundheitnord.de\" itemprop=\"email\">gewaltschutzambulanz@gesundheitnord.de</a>\n    </div>\n    <div class=\"col-xs-4\">Telefon</div>\n    <div class=\"col-xs-8\">\n     <a href=\"tel:(0421)%20497%2073920\" itemprop=\"telephone\">(0421) 497 73920</a>\n    </div>\n   </div>\n   <!-- hidden button to trigger map -->\n   <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-11322 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-11322\"></button>\n   <!-- toggle button (triggers hidden button above via js) -->\n   <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-gewaltschutzambulanz-bremen-11322\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n  </div>\n  <!-- toggle content -->\n  <div class=\"item-content toggle-content\" id=\"mse-content-gewaltschutzambulanz-bremen-11322\">\n   <div class=\"\" itemprop=\"description\">\n    <p class=\"\">Die Gewaltschutzambulanz ist eine Anlaufstelle für alle Betroffenen von Gewalt in Bremen und Bremerhaven, unabhängig von Geschlecht und Alter. Sie arbeitet bei Bedarf eng mit dem Eltern-Kind-Zentrum Prof. Hess und der Gynäkologie am Klinikum Bremen-Mitte zusammen.</p>\n   </div>\n   <!-- url -->\n   <div class=\"row\">\n    <div class=\"col-xs-4\">Internet</div>\n    <div class=\"col-xs-8 item-link\">\n     <a href=\"https://www.gesu