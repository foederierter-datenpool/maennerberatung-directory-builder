                                                                                                  <https://html.spec.whatwg.org/#innerHTML>
                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Männerschutzwohnung</small> <small>in Oldenburg</small>\n  <br>\n  Männer-Wohn-Hilfe e.V.</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Träger </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">Männer-Wohn-Hilfe e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Achterdiek 30a</span>\n   <br>\n   <span itemprop=\"postalCode\">26131</span><span itemprop=\"addressLocality\">Oldenburg</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Plätze</div>\n  <div class=\"col-xs-8\">2</div>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:0162%2087%2083%20013\" itemprop=\"telephone\">0162 87 83 013</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-4370 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-4370\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maenner-wohn-hilfe-e-v-4370\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maenner-wohn-hilfe-e-v-4370\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Schutzwohnung für von häuslicher Gewalt betroffene Männer.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.maennerwohnhilfe.de\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.maennerwohnhilfe.de</a>\n  </div>\n </div>\n</div>";
                                                                                                  <https://html.spec.whatwg.org/#innerText>
                                                                                                          "Männerschutzwohnung in Oldenburg Männer-Wohn-Hilfe e.V. Adresse d. Träger Männer-Wohn-Hilfe e.V. Achterdiek 30a 26131 Oldenburg Plätze 2 Telefon 0162 87 83 013 Mehr erfahren Schutzwohnung für von häuslicher Gewalt betroffene Männer. Internet https://www.maennerwohnhilfe.de"
                                                                                                ];
