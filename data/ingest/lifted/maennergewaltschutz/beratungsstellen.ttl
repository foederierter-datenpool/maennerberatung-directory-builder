                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Eschwege</small>\n  <br>\n  Männerberatung</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">AWO Werra-Meißner e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">An den Anlagen 8</span>\n   <br>\n   <span itemprop=\"postalCode\">37269</span><span itemprop=\"addressLocality\">Eschwege</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:05651%203076%20­%2020\" itemprop=\"telephone\">05651 3076 ­ 20</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-7051 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-7051\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-maennerberatung-7051\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-maennerberatung-7051\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Männer bei Gewalt in der Partnerschaft.</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-link\">\n   <a href=\"https://www.awo-werra-meissner.de/angebot/beratungsstelle-fuer-schwangerschaft-familie-sexualitaet/maennerberatung/\" target=\"_blank\" rel=\"nofollow\" itemprop=\"url\">https://www.awo-werra-meissner.de/angebot/beratungsstelle-fuer-schwangerschaft-familie-sexualitaet/maennerberatung/</a>\n  </div>\n </div>\n</div>";
