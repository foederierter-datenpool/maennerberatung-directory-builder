                                                                                                  <http://www.w3.org/1999/xhtml#class>
                                                                                                          "\n\t\tactive\n\t\tcol-xs-12 col-sm-6 item-container position-relative transition\n\t\t filtered-plz-21682\t\t filtered-freie-plaetze-z \t\t filtered-angebotstyp-2\t\tpost_name-opferhilfebuero-stade-12420\t";
                                                                                                  <http://www.w3.org/1999/xhtml#id>
                                                                                                          "mse-opferhilfebuero-stade-12420";
