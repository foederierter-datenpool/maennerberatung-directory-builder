                                                                                                          "<!-- <figure class=\"item-image\">\n\t\t\t</figure> -->\n<!-- header -->\n<header class=\"item-header\">\n <h3 class=\"item-headline\" itemprop=\"name\"><small>Beratungsstelle</small> <small>in Mönchengladbach-Rheydt</small>\n  <br>\n  Echte Männer reden</h3>\n</header>\n<!-- content -->\n<div class=\"item-content\">\n <div class=\"row\">\n  <div class=\"col-xs-4\">\n   Adresse\n   <br>\n   <small> d. Beratungsstelle </small>\n  </div>\n  <address class=\"col-xs-8\" itemprop=\"address\" itemscope itemtype=\"https://schema.org/PostalAddress\"><span itemprop=\"parentOrganization\">SKM Rheydt e.V.</span>\n   <br>\n   <span itemprop=\"streetAddress\">Waisenhausstr. 22</span>\n   <br>\n   <span itemprop=\"postalCode\">41236</span><span itemprop=\"addressLocality\">Mönchengladbach-Rheydt</span>\n   <br></address>\n </div>\n <div class=\"row\">\n  <div class=\"col-xs-4\">Telefon</div>\n  <div class=\"col-xs-8\">\n   <a href=\"tel:02166%20/%2013%2009%20730\" itemprop=\"telephone\">02166 / 13 09 730</a>\n  </div>\n </div>\n <!-- hidden button to trigger map -->\n <button class=\"js-wpv-addon-maps-focus-map js-toolset-maps-open-infowindow-map-map-bs-marker-marker-8615 d-none\" aria-hidden=\"true\" data-map=\"map-bs\" data-marker=\"marker-8615\"></button>\n <!-- toggle button (triggers hidden button above via js) -->\n <button type=\"button\" class=\"toggle-button small\" data-toggle=\"#mse-content-echte-maenner-reden-8615\"><span class=\"fa fa-arrow-down\" aria-hidden=\"true\"></span> Mehr erfahren</button>\n</div>\n<!-- toggle content -->\n<div class=\"item-content toggle-content\" id=\"mse-content-echte-maenner-reden-8615\">\n <div class=\"\" itemprop=\"description\">\n  <p class=\"\">Beratung für Männer und Jungen in Krisen und bei Gewalttätigkeit</p>\n </div>\n <!-- url -->\n <div class=\"row\">\n  <div class=\"col-xs-4\">Internet</div>\n  <div class=\"col-xs-8 item-