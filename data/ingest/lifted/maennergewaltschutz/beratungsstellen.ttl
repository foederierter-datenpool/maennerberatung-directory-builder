                                                                                                                          rdf:_1    [ rdf:type  <http://www.w3.org/1999/xhtml#p>;
                                                                                                                                      rdf:_1    "Bei uns werden Sie im Fall einer Ehe- oder Partnerschaftskrise, bei der körperliche oder seelische Gewalt geschieht, schnell beraten – auch zuhause. Dieses Angebot ist offen für alle Menschen, unabhängig von Alter, Geschlecht, Nationalität, Religion, Beruf und Einkommen.";
                                                                                                                                      <http://www.w3.org/1999/xhtml#class>
                                                                                                                                              "";
                                                                                                                                      <https://html.spec.whatwg.org/#innerHTML>
                                                                                                                                              "Bei uns werden Sie im Fall einer Ehe- oder Partnerschaftskrise, bei der körperliche oder seelische Gewalt geschieht, schnell beraten – auch zuhause. Dieses Angebot ist offen für alle Menschen, unabhängig von Alter, Geschlecht, Nationalität, Religion, Beruf und Einkommen.";
                                                                                                                                      <https://html.spec.whatwg.org/#innerText>
                                                                                                                                              "Bei uns werden Sie im Fall einer Ehe- oder Partnerschaftskrise, bei der körperliche oder seelische Gewalt geschieht, schnell beraten – auch zuhause. Dieses Angebot ist offen für alle Menschen, unabhängig von Alter, Geschlecht, Nationalität, Religion, Beruf und Einkommen."
                                                                                                                                    ];
