          [ xyz:adresse         "Freiligrathwall 28, 59494 Soest, Germany";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Gesprächskreis / Selbsthilfegruppe";
            xyz:beschreibung    "<p class=\"Text\" style=\"line-height: 110%;\"><span style=\"font-size: 12.0pt; line-height: 110%;\">Mein Name ist Walter Dülberg, </span><span style=\"font-size: 12.0pt; line-height: 110%;\">ich bin Supervisor DGSv, zertifizierter Mediator und Handwerksmeister, und arbeite als Supervisor/ Coach und Konfliktklärer in freier Praxis in Soest. </span><span style=\"font-size: 12.0pt; line-height: 110%;\">Meine Schwerpunkte in der Jungen-und Männerberatung sind Übergänge ins, im und nach dem Berufsleben, Lebenswirklichkeiten nach Scheidung, Krankheit, Arbeitslosigkeit, in der Rente und Konfliktbearbeitung in Beruf und Familie.</span></p>\r\n<p class=\"Text\" style=\"line-height: 110%;\"><span style=\"font-size: 12.0pt; line-height: 110%;\">Als Coach und Männerberater arbeite ich unter anderem mit handwerklichen Settings, in meiner Schmiede in Soest und auf Borkum. An der Werkbank lässt sich wunderbar auf Augenhöhe miteinander reden, Pläne schmieden und Herausforderungen angehen.</span></p>";
            xyz:bundeslaender   "Nordrhein-Westfalen";
            xyz:email           "post@hellersand.de";
            xyz:id              "266";
            xyz:land            "Deutschland";
            xyz:name            "Schmiedefeuer Beratung und Werkstatt";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-schmiedefeuer-beratung-und-werkstatt/";
            xyz:telefon         "+49 2921 3193390";
            xyz:traeger         "Walter Dülberg";
            xyz:website         "https://www.schmiedefeuer.eu"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_360>
          [ xyz:adresse         "Wilhelm-Bode-Straße 33, 38106 Braunschweig";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Psychologische Beratung";
            xyz:beschreibung    "Mein Angebot richtet sich an Männer, die sich selbst, ihrem Leben und anderen mit Achtsamkeit und Liebe begegnen wollen. Ich biete eine männersensible gestaltfundierte Einzelbegleitung an. Diese hat das Ziel, sich selbst besser kennen zu lernen und die Bewusstheit für sich und die Umwelt zu weiten, um mehr Handlungsfreiheit im Leben und in Beziehungen zu erlangen.\r\n\r\nEin besonderes Augenmerk liegt auf folgenden Themen:\r\n<ul>\r\n \t<li>Selbstfürsorge und Achtsamkeit</li>\r\n \t<li>Veränderung und Orientierung in Krisen- und Übergangszeiten</li>\r\n \t<li>Zugang zu und Ausdruck von Gefühlen und Bedürfnissen</li>\r\n \t<li>Gestaltung von und Kontakt in zwischenmenschlichen Beziehungen</li>\r\n \t<li>Partnerschaft, Sexualität und Trennung</li>\r\n \t<li>Abhängigkeit und Autonomie / Nähe und Distanz</li>\r\n \t<li>Umgang mit Wut, Trauer, Schuld, Scham, Einsamkeit etc.</li>\r\n \t<li>Männlichkeitsstereotype und -rollenbilder</li>\r\n \t<li>Introversion, Schüchternheit, Sensibilität</li>\r\n \t<li>Aufwachsen mit psychisch erkrankten Eltern</li>\r\n</ul>\r\nGemeinsam schauen wir, was Ihr individuelles Anliegen ist und wie ich Sie dabei begleiten kann.";
            xyz:bundeslaender   "Niedersachsen";
            xyz:email           "gestaltberatung-lawrenz@posteo.de";
            xyz:id              "6197";
            xyz:land            "Deutschland";
            xyz:name            "Gestaltberatung Lawrenz";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/gestaltberatung-lawrenz/";
            xyz:telefon         "+49 1776421876";
            xyz:traeger         "";
            xyz:website         "https://gestaltberatung-lawrenz.jimdosite.com"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_361>
