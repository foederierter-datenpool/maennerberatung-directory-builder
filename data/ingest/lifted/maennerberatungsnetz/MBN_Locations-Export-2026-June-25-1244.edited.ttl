          [ xyz:adresse         "Trautenaustraße 5, 10717 Berlin";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Online-/ Telefonberatung|Psychologische Beratung";
            xyz:beschreibung    "<p data-start=\"0\" data-end=\"419\"><strong data-start=\"0\" data-end=\"33\">Deutsch </strong>Zigmal e.V. bietet vertrauliche und kostenlose Einzelgespräche für Männer mit Hans, systemischem Berater mit Heilpraktikererlaubnis. Im Pangea Haus finden sie in Kooperation mit <em data-start=\"608\" data-end=\"628\">Systemik im Dialog</em> statt, das den Raum stellt. Die Gespräche bieten einen geschützten Rahmen für Klärung, Reflexion und Orientierung – live an jedem 2. Dienstag im Monat, oder flexibel online.</p>\r\n<p data-start=\"0\" data-end=\"419\"><strong data-start=\"0\" data-end=\"33\">English </strong>Zigmal e.V. offers confidential and free of charge one-to-one sessions for men, led by Hans, a systemic counsellor licensed for psychotherapy. When held at Pangea Haus, the sessions take place in cooperation with <em data-start=\"230\" data-end=\"250\">Systemik im Dialog</em>, which provides the space. They offer a safe setting for personal clarity, reflection, and orientation — in person on the second Tuesday of the month, or for flexible online appointments.</p>";
            xyz:bundeslaender   "Berlin";
            xyz:email           "request@zigmal.org";
            xyz:id              "11648";
            xyz:land            "Deutschland";
            xyz:name            "Men's counselling | Einzelgespräche für Männer";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/mens-counselling-einzelgespraeche-fuer-maenner/";
            xyz:telefon         "";
            xyz:traeger         "Zigmal e.V. in Zusammenarbeit mit Systemik im Dialog";
            xyz:website         "https://zigmal.org/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_401>
          [ xyz:adresse         "Kastanienallee 35, 14471 Potsdam";
            xyz:beratungsarten  "Einzelberatung|Online-/ Telefonberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "<p data-start=\"742\" data-end=\"1119\">Ich begleite Männer und Väter, die sich nach mehr Leichtigkeit, Nähe und innerer Klarheit sehnen. In meiner Arbeit geht es darum, Emotionen zu verstehen, Beziehungen bewusst zu gestalten und eigene Ressourcen zu aktivieren. So entwickeln Sie ein neues Selbstverständnis – voller Stärke, Verbundenheit und Ruhe – und gewinnen damit neue Qualität in Beziehung, Familie und Leben.</p>";
            xyz:bundeslaender   "Brandenburg";
            xyz:email           "info@reboot-potsdam.de";
            xyz:id              "11786";
            xyz:land            "Deutschland";
            xyz:name            "Reboot Potsdam";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/reboot-potsdam/";
            xyz:telefon         "4915777348752";
            xyz:traeger         "Jana Gose";
            xyz:website         "https://reboot-potsdam.de/coaching-fuer-maenner/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_402>
          [ xyz:adresse         "Bahrenfelder Straße 255, 22765 Hamburg";
            xyz:beratungsarten  "Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Psychologische Beratung|Treff";
            xyz:beschreibung    "<p class=\"font_8 wixui-rich-text__text\">Hand aufs Herz: Männer sind ebenso Leidtragende des Patriarchats wie Frauen. Denn eigentlich sind sie ganz schön arm dran trotz all der beruflichen oder politischen Macht, der Statussymbole, Privilegien und des Geldes. Auf der einen Seite verprassen sie ihre Energie oft unbewusst in kurzfristiger Befriedigung, Ablenkung und Machtillusion. Auf der anderen Seite haben sie gelernt, dass sie besser keinen Zugang zu ihrem weichen Kern haben sollten und damit fehlt ihnen ein Teil ihrer Menschlichkeit und eine lebenswichtige Energiequelle. Der Preis ist hoch, denn anstatt öfter mal loszulassen und sich anzulehnen, wählen viele den Suizid, entwickeln eine Depression oder Suchterkrankung.​​​</p>\r\n<p class=\"font_8 wixui-rich-text__text\">In Verbindung mit dem eigenen Herzen, dem eigenen Körper und der eigenen Wahrheit kultiviere ich mit dir deine eigene Form von Männlichkeit, damit du endlich das Ruder deines Lebens ergreifen kannst.</p>";
            xyz:bundeslaender   "Hamburg";
            xyz:email           "praxis@sebastian-hofer.de";
            xyz:id              "12481";
            xyz:land            "Deutschland";
            xyz:name            "Mann Sein in Balance - Körperpsychotherapie und Männergruppe";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/mann-sein-in-balance-koerperpsychotherapie-und-maennergruppe/";
            xyz:telefon         "‭+49 15141342080‬";
            xyz:traeger         "Praxis für körperorientierte Psychotherapie | Sebastian Hofer";
            xyz:website         "https://www.sebastian-hofer.de/maennerarbeit"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_403>
          [ xyz:adresse         "Am Kornhof 6, 34355 Staufenberg";
            xyz:beratungsarten  "Täterberatung";
            xyz:beschreibung    "Seit 2022 biete ich ambulante deliktorientierte Psychotherapie für Sexualstraftäter im Einzelsetting an, insbesondere im Bereich des Besitzes, der Weitergabe und Verbreitung von Kinderpornografie bzw. Jugendpornografie, Exhibitionismus, Voyeurismus und anderer Sexualstraftaten ohne Körperkontakt. Dabei kommen wissenschaftlich evaluierte Behandlungsprogramme zum Einsatz wie das Göttinger Programm zur Prävention von Kindesmissbrauch, das Berliner Dissexualitätsprogramm oder das Behandlungsprogramm für Sexualstraftäter (BPS-III).";
            xyz:bundeslaender   "Niedersachsen";
