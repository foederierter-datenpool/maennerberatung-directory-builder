          [ xyz:adresse         "Herzogstraße 1A, 60528 Frankfurt am Main, Germany";
            xyz:beratungsarten  "Gesprächskreis / Selbsthilfegruppe|Rechtsberatung";
            xyz:beschreibung    "Für Eltern in Trennungs -und Scheidungssituationen bieten wir umfangreiche Hilfen an: u.a. Coaching, Rechtsberatung, Gesprächsgruppen, Fortbildungen. Ein besonderes Anliegen ist uns das interdisziplinäre Gespräch mit Familiengerichten, Jugendämtern, Sachverständigen und Rechtsanwälten. Hauptanliegen des Vereins ist die Aufrechterhaltung der Beziehung der Kinder zu beiden Eltern nach einer Trennung, indem er sich für das Recht der Kinder auf Vater und Mutter als unentziehbares und unverzichtbares Grund- und Menschenrecht einsetzt.\r\n\r\n&nbsp;";
            xyz:bundeslaender   "Hessen";
            xyz:email           "buero.frankfurt@f-vafk.de";
            xyz:id              "256";
            xyz:land            "Deutschland";
            xyz:name            "Väteraufbruch für Kinder e.V., Kreisverein Frankfurt";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-vaeteraufbruch-fuer-kinder-e-v-kreisverein-frankfurt/";
            xyz:telefon         "+49 69 94419286";
            xyz:traeger         "";
            xyz:website         "https://www.frankfurt.vaeteraufbruch.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_270>
          [ xyz:adresse         "Perlacher Straße 36, 81539 München, Deutschland";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "BALDPAPA ist ein digitales Angebot zur Geburtsvorbereitung von Männern und werdenden Vätern - von einem Mann und selbst dreifachen Vater. Bei BALDPAPA erfährst du, was auf dich zukommt und was du tun kannst, damit dir ein guter als Start als Vater gelingt. BALDPAPA bietet an: Live-Webinare, den Podcast \"Gelassen Vater werden mit Frank\", einen Blog mit vielen Infos rund um die Geburt und einen kostenlosen Newsletter.";
