          [ xyz:adresse         "Bülowstraße 106, 10783 Berlin, Germany";
            xyz:beratungsarten  "Einzelberatung|Online-/ Telefonberatung|Partner- / Gruppenberatung|Psychologische Beratung|Rechtsberatung";
            xyz:beschreibung    "Bei Mann-O-Meter stehen kompetente, geschulte Laienberater sowie professionelle Psychologen und psychologische Berater für Gespräche zur Verfügung bei Fragen zu schwuler Gesundheit, HIV/Aids und anderen sexuell übertragbaren Infektionen und für psychosoziale Beratung. Sollten wir mal nicht weiterhelfen können, geben wir gern Auskunft über andere Hilfsangebote und Selbsthilfegruppen in Berlin.";
            xyz:bundeslaender   "Berlin";
            xyz:email           "info@mann-o-meter.de";
            xyz:id              "278";
            xyz:land            "Deutschland";
            xyz:name            "Mann-O-Meter e.V. - Berlins schwuler Checkpoint";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-mann-o-meter-e-v-berlins-schwuler-checkpoint/";
            xyz:telefon         "+49 30 2168008";
            xyz:traeger         "";
            xyz:website         "https://www.mann-o-meter.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_46>
          [ xyz:adresse         "Bülowstraße 107, 10783 Berlin, Germany";
            xyz:beratungsarten  "Einzelberatung|Online-/ Telefonberatung|Opferberatung|Psychologische Beratung";
            xyz:beschreibung    "Maneo - schwules Überfalltelefon und Opferhilfe! Maneo hilft schwulen und bisexuellen Männern, die von schwulenfeindlicher Gewalt und Diskriminierung betroffen sind – egal ob als Opfer, Tatzeugen oder Lebenspartner der Betroffenen.\r\n\r\nWir beraten und begleiten in schwierigen Situationen. Wir beraten über Möglichkeiten einer Anzeigenerstattung, über das Strafverfahren, und überlegen auch mögliche Alternativen dazu. Wir vermitteln Kontakt zu erfahrenen Rechtsanwälten, zu Ärzten und weiterhelfenden Einrichtungen. Wir begleiten Betroffene zur Polizei und zu Gerichtsverhandlungen.";
            xyz:bundeslaender   "Berlin";
            xyz:email           "maneo@maneo.de";
            xyz:id              "279";
            xyz:land            "Deutschland";
            xyz:name            "MANEO - das schwule Anti-Gewalt-Projekt in Berlin";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-maneo-das-schwule-anti-gewalt-projekt-in-berlin/";
            xyz:telefon         "+49 30 2163336";
            xyz:traeger         "Mann-O-Meter e.V. - Berlins schwuler Checkpoint";
            xyz:website         "https://www.maneo.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_47>
          [ xyz:adresse         "Schanzenstraße 75, 20359 Hamburg, Germany";
            xyz:beratungsarten  "Einzelberatung|Psychologische Beratung";
            xyz:beschreibung    "PAG – Perspektive Arbeit und Gesundheit fördert die Gestaltung gesunder Arbeitsbedingungen in Hamburg. Die Anlaufstelle für Beschäftigte und Betriebe berät Beschäftigte in belastenden Arbeitssituationen und unterstützt betriebliche Akteurinnen und Akteure, die für gesundheitsgerechte Bedingungen im Betrieb (mit)verantwortlich sind.\r\n\r\nUnser Beratungsangebot ist kostenfrei und vertraulich.\r\n\r\nIm persönlichen Gespräch helfen wir Ihnen, Ihre persönliche oder betriebliche Situation zu klären und geben Orientierung für die nächsten Schritte. Bei Bedarf vermitteln wir an andere kompetente Stellen.\r\n\r\nUnsere Berater*innen sind erfahrene Fachkräfte mit psychologischem sowie sozialwissenschaftlichem Hintergrund und verfügen über langjährige Beratungserfahrungen.";
            xyz:bundeslaender   "Hamburg";
            xyz:email           "info@pag-hamburg.org";
            xyz:id              "280";
            xyz:land            "Deutschland";
            xyz:name            "Anlaufstelle Perspektive Arbeit & Gesundheit (PAG)";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-anlaufstelle-perspektive-arbeit-gesundheit-pag/";
            xyz:telefon         "+49 40 4392807";
            xyz:traeger         "Arbeit & Gesundheit e.V.";
            xyz:website         "https://www.pag-hamburg.org"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_48>
