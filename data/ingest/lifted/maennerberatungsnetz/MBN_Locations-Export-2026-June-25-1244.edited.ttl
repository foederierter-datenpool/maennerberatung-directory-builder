            xyz:telefon         "56131749116";
            xyz:traeger         "";
            xyz:website         "https://fax-kassel.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_329>
          [ xyz:adresse         "Wilhelmstraße 138, 10963 Berlin, Deutschland";
            xyz:beratungsarten  "Online-/ Telefonberatung";
            xyz:beschreibung    "Wie geht es dir? Frag uns alles, was du über dein Leben als schwuler Mann wissen willst - zu Freundschaft, Partnerschaft, Einsamkeit, Sex, Drogen oder zu Dingen, die dir Angst machen; wie du dich vor HIV und Geschlechtskrankheiten schützen kannst oder ob du dich infiziert haben könntest.\r\nHier arbeiten schwule/queere Männer, die sich auskennen mit Sex und Gesundheit. Sie beraten kostenlos und anonym zwischen 17 und 20 Uhr täglich.\r\nUnsere Berater sind speziell geschulte und erfahrene Mitarbeiter aus Beratungseinrichtungen und Aidshilfen in Deutschland, Österreich und der Schweiz.";
            xyz:bundeslaender   "";
            xyz:email           "klaus.purkart@dah.aidshilfe.de";
            xyz:id              "597";
            xyz:land            "Deutschland";
