            xyz:traeger         "sMUTje / Therapiehilfe gGmbH";
            xyz:website         "https://www.smutje-hh.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_399>
          [ xyz:adresse         "Zur Lengder Burg 7, 37130 Gleichen";
            xyz:beratungsarten  "Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Online-/ Telefonberatung";
            xyz:beschreibung    "<strong>Männerberatung &amp; Männerkreis</strong>\r\n\r\nIch biete geschlechterreflektierte Beratung für Männer in Krisen- und Übergangssituationen sowie bei Fragen zu Identität, Beziehung und Lebensgestaltung an. Meine Haltung ist ressourcenorientiert, wertschätzend und darauf ausgerichtet, Selbstreflexion und Eigenverantwortung zu fördern.\r\n\r\nErgänzend dazu leite ich einen offenen Männerkreis, der Raum für ehrlichen Austausch, gegenseitige Unterstützung und persönliche Entwicklung bietet.";
            xyz:bundeslaender   "Niedersachsen";
            xyz:email           "Info@akompano-coaching.de";
            xyz:id              "11323";
            xyz:land            "Deutschland";
            xyz:name            "Akompano Coaching und Wegbegleitung";
