          [ xyz:adresse         "Johannisstraße 24, 49074 Osnabrück, Germany";
            xyz:beratungsarten  "Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Online-/ Telefonberatung|Opferberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "<p class=\"font_8\">Die Anforderungen an Männer sind heute vielfältig und komplex, ob in der Partnerschaft, in der Familie, als Vater oder als Single. Männer sollen verständnisvoll, stark und „männlich“ sein. Sie sollen die Familie ernähren und aktiv am Familienleben teilnehmen. Sie sollen als liebevolle und fürsorgliche Väter ihren Erziehungsteil leisten und gleichzeitig beruflich erfolgreich sein.</p>\r\n<p class=\"font_8\">Bei diesen hohen Anforderungen ist es durchaus keine Seltenheit, dass Männer überfordert sind und nicht für alles sofort eine Lösung parat haben. Probleme und Krisen können die Folge sein, die zu Belastungen führen; für den Mann selbst, aber auch für die Familien, Freunde und Kollegen.</p>\r\n<p class=\"font_8\">Wir möchten Männer ermutigen, über die eigenen Herausforderungen zu reden. Wir möchten sie bei Veränderungsprozessen unterstützen, präventiv oder in einer (sich anbahnenden) Lebenskrise. Männer entwickeln für sich angemessene Perspektiven und Lösungen.</p>\r\nTermine nach Vereinbarung.";
            xyz:bundeslaender   "Niedersachsen";
            xyz:email           "maennerberatung@skm-osnabrueck.de";
            xyz:id              "476";
            xyz:land            "Deutschland";
            xyz:name            "Männerberatung des SKM - Kath. Verein für soziale Dienste in Osnabrück e.V.";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-maennerberatung-des-skm-kath-verein-fuer-soziale-dienste-in-osnabrueck-e-v/";
            xyz:telefon         "+49 541 20511397";
            xyz:traeger         "";
            xyz:website         "https://www.skm-osnabrueck.de/maennerberatung"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_223>
