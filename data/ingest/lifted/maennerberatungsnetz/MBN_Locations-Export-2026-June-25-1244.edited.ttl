          [ xyz:adresse         "Brandenburger Straße 69, 14467 Potsdam";
            xyz:beratungsarten  "Einzelberatung|Online-/ Telefonberatung|Opferberatung|Partner- / Gruppenberatung|Täterberatung";
            xyz:beschreibung    "<ul>\r\n \t<li style=\"text-align: left;\">Beratung zu sexualisierter Gewalt gegen Kinder, Jugendliche, Erwachsene</li>\r\n \t<li style=\"text-align: left;\">Jungen* und Männer* als Betroffene sexualisierter Gewalt</li>\r\n \t<li style=\"text-align: left;\">Peergewalt</li>\r\n \t<li style=\"text-align: left;\">Arbeit mit sexuell grenzverletzenden Kindern und Jugendlichen</li>\r\n \t<li style=\"text-align: left;\">Beziehungsberatung</li>\r\n \t<li style=\"text-align: left;\">Mediation von Beziehungen, Familien, Gruppen</li>\r\n \t<li style=\"text-align: left;\">Sexualpädagogik und Sexualberatung</li>\r\n \t<li style=\"text-align: left;\">Fortbildungen für Fachkräfte und Teams</li>\r\n \t<li style=\"text-align: left;\">Begleitung von Organisationen bei der Entwicklung von\r\nKinderschutzkonzepte</li>\r\n \t<li style=\"text-align: left;\">Fokus auf den ländlichen Raum</li>\r\n \t<li style=\"text-align: left;\">Betroffenenorientiert, Traumapädagogisch und Fallspezifisch</li>\r\n \t<li style=\"text-align: left;\">Social Justice und radical Diversity, Transformative Mediation</li>\r\n \t<li style=\"text-align: left;\">Online Beratung, Ambulante Beratung</li>\r\n</ul>";
            xyz:bundeslaender   "Berlin|Brandenburg";
            xyz:email           "wechsel.wirkung@posteo.de";
            xyz:id              "15351";
            xyz:land            "Deutschland";
            xyz:name            "Wechsel.Wirkung";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/wechsel-wirkung/";
