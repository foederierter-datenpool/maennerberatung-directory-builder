          [ xyz:adresse         "August-Bebel-Straße 10 07743 Jena";
            xyz:beratungsarten  "Einzelberatung|Opferberatung|Partner- / Gruppenberatung|Psychologische Beratung";
            xyz:beschreibung    "Das Thüringer Projekt A4 bietet Männern, die in ihrer Lebensgemeinschaft körperliche oder emotionale Gewalt erfahren, professionelle Unterstützung. Wir beraten auch Männer, die Opfer von Stalking geworden sind. Ziel ist es, Männern Hilfe zum Schutz oder zur Minderung häuslicher Gewalt anzubieten. Neben unserem Beratungsangebot leisten wir Aufklärungs- und Sensibilisierungsarbeit in Thüringen und informieren zum Thema Gewalt gegen Männer in engen sozialen Beziehungen. Wir sind ein qualifiziertes Fachteam aus psychologischen und (sozial- )pädagogischen Berufen. Unser Beratungsangebot bekennt sich zur gegenseitigen Achtung von Männern und Frauen.\r\nDas Projekt A4 ist ein Angebot des Vereins „Vereint gegen Gewalt e.V.“ und wird gefördert vom Freistaat Thüringen.";
            xyz:bundeslaender   "Thüringen";
            xyz:email           "beratung@maennerberatung-thueringen.de";
            xyz:id              "422";
            xyz:land            "Deutschland";
            xyz:name            "Projekt A4 / Männerberatungsstelle";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-projekt-a4-maennerberatungsstelle/";
            xyz:telefon         "+49 151 288 156 18";
            xyz:traeger         "Vereint gegen Gewalt e.V.";
            xyz:website         "https://www.maennerberatung-thueringen.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_174>
          [ xyz:adresse         "Dorfstraße 14, 99438 Bad Berka";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "Ich helfe Vätern in Krisen &amp; Trennung, neue Orientierung und neue Handlungsmöglichkeiten zu entwickeln. Deutschlandweit online / per Telefon / Skype und lokal in Thüringen. Dabei unterstütze ich vor allem Männer, die merken, dass wirkliche Veränderung bei einem selbst anfangen muss. Ich benutze pragmatische Ansätze der systemischen Beratung, der Transaktionsanalyse, klassischem Coachings. Videokursangebote ermöglichen erste Hilfestellungen, längerfristige Coachings wirkliche Veränderungschancen.";
            xyz:bundeslaender   "Thüringen";
            xyz:email           "info@vaterverantwortung.de";
            xyz:id              "423";
            xyz:land            "Deutschland";
            xyz:name            "Väter in Verantwortung";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-vaeter-in-verantwortung/";
            xyz:telefon         "+49 174 3137797";
            xyz:traeger         "Carsten Vonnoh, Online-Coach für Väter";
            xyz:website         "https://carstenvonnoh.de/"
          ];
