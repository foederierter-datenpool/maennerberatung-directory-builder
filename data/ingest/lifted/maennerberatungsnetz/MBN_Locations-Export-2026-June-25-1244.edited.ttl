          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_153>
          [ xyz:adresse         "Loschwitzer Str. 21, 01309 Dresden, Germany";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "Ich biete Beratungsgespräche für Männer an, die sich an Wendepunkten, Übergängen und Krisensituationen befinden. Der Blick wird genauso auf die Verletzlichkeiten, Schamgefühle, Ängste gerichtet, wie auf die eigenen Stärken, Erfahrungen und auf völlig neue Sichtweisen. Die Männergruppe schafft Möglichkeiten, seine eigenen Themen im geschützten Rahmen mit anderen Männern auszutauschen. Mein thematischer Schwerpunkt sind TRENNUNGEN, meine Haltung ist wertschätzend und meine fachliche Expertise systemisch.";
            xyz:bundeslaender   "Sachsen";
            xyz:email           "jens.geithner@mannufaktur-dresden.de";
            xyz:id              "399";
            xyz:land            "Deutschland";
            xyz:name            "MANNufaktur Dresden";
