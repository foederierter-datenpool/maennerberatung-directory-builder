            xyz:telefon         "+49 (0) 2261 3028611";
            xyz:traeger         "";
            xyz:website         "https://www.psychotherapie-matthias-stinn.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_302>
          [ xyz:adresse         "Winsstraße 32, Berlin, Deutschland";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Online-/ Telefonberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "Als systemischer Berater arbeite ich mit Einzelpersonen, Paaren und Familien. Den Menschen, die Ihren Weg zu mir finden, begegne ich mit Wertschätzung, Offenheit und Wärme. Gemeinsam finden wir neue Perspektiven und Lösungswege.\r\n\r\n​Ich möchte einen Raum schaffen, in dem Du mit klarem Blick und mutigen Schritten auf Dein Leben schauen kannst. Dabei orientiere ich mich stets an Deinem Tempo und Deinen Grenzen. Du entscheidest, wohin Du gehen möchtest, ich unterstütze dabei eine Orientierung zu finden. Dabei sind mir Augenhöhe und eine wertschätzende Haltung besonders wichtig. Ich verstehe mich als Begleiter und Impulsgeber.\r\n\r\nIch begleite Dich auf Deinem Weg der Veränderung.";
            xyz:bundeslaender   "Berlin";
            xyz:email           "beratung.kircheis@gmail.com";
            xyz:id              "566";
            xyz:land            "Deutschland";
            xyz:name            "Systemische Therapie & Beratung Toni Kircheis";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-systemische-therapie-beratung-toni-kircheis/";
            xyz:telefon         "";
            xyz:traeger         "";
            xyz:website         "https://www.toni-kircheis.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_303>
