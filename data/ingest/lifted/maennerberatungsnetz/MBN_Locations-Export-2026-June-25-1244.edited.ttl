          [ xyz:adresse         "Lavesstraße 3, 30159 Hannover, Germany";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Opferberatung|Psychologische Beratung|Täterberatung";
            xyz:beschreibung    "Die Beratungsarbeit versteht sich als männerorientiert. Sie zeichnet sich durch Parteilichkeit im geschlechterbezogenen Sinne aus. Männer* erhalten eine mitmännliche Unterstützung. Ziel ist, dass Männer* selbsttätig Kriterien dafür erarbeiten, wie sie ihre persönliche Verantwortung im Leben übernehmen (lernen). Eine „Männerkompetenz“ äußert sich in einer männergemäßen und kritisch-solidarischen (An-)Sprache. Wir verstehen uns klientenzentriert als Zuhörer und Begleiter von nicht verstandenen und verdrängten Aspekten eigener Wirklichkeiten.";
            xyz:bundeslaender   "Niedersachsen";
            xyz:email           "beratung@mannigfaltig.de";
            xyz:id              "470";
            xyz:land            "Deutschland";
            xyz:name            "Institut für Jungen- und Männerarbeit, Anlauf- und Beratungsstelle für jungen und Männer";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-institut-fuer-jungen-und-maennerarbeit-anlauf-und-beratungsstelle-fuer-jungen-und-maenner/";
            xyz:telefon         "+49 511 2100010";
            xyz:traeger         "mannigfaltig e.V.";
            xyz:website         "https://www.mannigfaltig.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_218>
          [ xyz:adresse         "Bäringerstraße 24-25, 38640 Goslar, Germany";
            xyz:beratungsarten  "Gesprächskreis / Selbsthilfegruppe|Partner- / Gruppenberatung|Treff";
            xyz:beschreibung    "\"Wir sind eine Gruppe Männer, die an einer komplexen posttraumatischen Belastungsstörung leiden. Wir verstehen uns als Selbsthilfegruppe. Die Gruppe trifft sich in verschiedenen Orten in Deutschland, meistens treffen wir uns in Goslar.\r\nDesweiteren setzt sich die Gruppe auf kommunaler, Landes- und auf Bundesebene für eine geschlechtsspezifische Traumabehandlung für Männer ein. Jeder Mann, der an einer komplexen posttraumatischen Belastungsstörung leidet, ist herzlich willkommen. Uns ist es egal welche Herkunft, Hautfarbe, Religion und sexuelle Identität der Betroffene hat.\"";
            xyz:bundeslaender   "Niedersachsen";
            xyz:email           "info@ptbs-maennergruppe.de";
            xyz:id              "472";
            xyz:land            "Deutschland";
            xyz:name            "PTBS Männergruppe";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-ptbs-maennergruppe/";
            xyz:telefon         "+49 152 37394479";
            xyz:traeger         "";
            xyz:website         "https://www.ptbs-maennergruppe.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_219>
