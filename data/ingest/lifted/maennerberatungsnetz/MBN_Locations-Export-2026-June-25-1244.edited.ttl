          [ xyz:adresse         "Schultesstraße 5, 97421 Schweinfurt, Germany";
            xyz:beratungsarten  "Partner- / Gruppenberatung|Täterberatung";
            xyz:beschreibung    "Wir bieten Männern, die gewalttätig geworden sind, in einer geschlossenen Gruppe von 4 -6 Männern, die Möglichkeit, in 8 x 2, 5 Stunden Wege der wirkungsvollen Stressreduzierung zu finden und ihre Selbstwahrnehmung zu verbessern. Alle Gruppenteilnehmer bringen das Thema \"häusliche Gewalt\" als ihr Problem ein und tauschen sich über ihre Erfahrungen und die schon genutzten Möglichkeiten aus, die eigene Aggression zu steuern.\r\nDie Kosten betragen 120 Euro und können in zwei Raten gezahlt werden.";
            xyz:bundeslaender   "Bayern";
            xyz:email           "info@maenner-contra-gewalt.de";
            xyz:id              "232";
            xyz:land            "Deutschland";
            xyz:name            "Beratung für Männer, die gewalttätig geworden sind - in Gruppen, Notfallberatung am Telefon";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-beratung-fuer-maenner-die-gewalttaetig-geworden-sind-in-gruppen-notfallberatung-am-telefon/";
            xyz:telefon         "+49 176 696540443";
            xyz:traeger         "Verein für Männer contra Gewalt e.V.";
            xyz:website         "https://www.maenner-contra-gewalt.de"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_80>
          [ xyz:adresse         "Karl-Marx-Allee 128, 10243 Berlin, Germany";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Partner- / Gruppenberatung";
            xyz:beschreibung    "Mit meinem Angebot biete ich schwulen und bisexuellen Männern eine Anlaufstelle rund um Themen wie Selbstvertrauen. Hemmungen, ungelebte Phantasien, spätes Coming Out, Schwierigkeiten in der Partnerschaft, Einsamkeit und entspannten Umgang mit ihrer Sexualität.\r\n\r\nIch lebe selbst seit über dreißig Jahren offen schwul und in meinen Coachings gibt es zum einen keine Tabuthemen und zum anderen kannst Du vollkommen offen reden und Dich so ausdrücken, wie Du das auch sonst tust.\r\n\r\nIch arbeite unter anderem mit Hypnose und NLP sowie diversen Gesprächstechniken. Coachings können sowohl im üblichen Setting als auch bei einem Spaziergang im Grünen oder Online stattfinden.";
            xyz:bundeslaender   "Berlin";
            xyz:email           "info@trieb-und-traum.berlin";
            xyz:id              "319";
            xyz:land            "Deutschland";
            xyz:name            "Coaching für schwule und bisexuelle Männer";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-coaching-fuer-schwule-und-bisexuelle-maenner/";
            xyz:telefon         "+49 163 6990703";
            xyz:traeger         "Trieb und Traum Thomas Uhrig";
            xyz:website         "https://www.trieb-und-traum.berlin"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_81>
