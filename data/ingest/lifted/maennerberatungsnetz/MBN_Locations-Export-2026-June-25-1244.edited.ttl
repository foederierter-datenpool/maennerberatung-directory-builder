          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_108>
          [ xyz:adresse         "Salbauerstraße 7, 81241 München, Germany";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "Anima ist eine systemische Praxis, die sich speziell an Männer* und Jungen* richtet, die Antworten auf drängende Lebensfragen haben.\r\n\r\nDabei geht es in der Arbeitsweise darum, auf Augenhöhe Ihr Anliegen zu klären, indem auf Ihre aktuelle Lebenssituation eingegangen wird. Auch der Blick in die Vergangenheit kann hilfreich sein, um Fragen der Gegenwart zu klären - wenn Sie das Wünschen.\r\nBitte beachten Sie, dass es sich um eine freie Praxis handelt, d.h. die Kosten müssen Sie selbst voll tragen.";
            xyz:bundeslaender   "Bayern";
            xyz:email           "anima@dominik-kling.de";
            xyz:id              "349";
            xyz:land            "Deutschland";
            xyz:name            "Selbstzahlerpraxis - Systemische Beratung";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-selbstzahlerpraxis-systemische-beratung/";
            xyz:telefon         "+49 176 83297386";
            xyz:traeger         "Anima-Systemische Praxis";
            xyz:website         "https://dominik-kling.de/maennerberatung/"
          ];
