          [ xyz:adresse         "Wilhelmstraße 52, 53879 Euskirchen, Deutschland";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung";
            xyz:beschreibung    "<div class=\"row \">\r\n<div class=\"col-xs-12\">\r\n<div class=\"ap ap-section \">\r\n<div class=\"text ap-plain\">\r\n\r\nWerdende Väter erleben eine Schwangerschaft anders als Frauen. Oft beschäftigen sie völlig andere Themen über die sie sich austauschen möchten.\r\n\r\n<strong>Wir sind für Sie da, wenn</strong>\r\n<ul>\r\n \t<li>Sie Vater werden und Fragen haben zu Schwangerschaft, Vaterschaft und Elternschaft.</li>\r\n \t<li>Sie die finanzielle Absicherung der Familie beschäftigt und Sie Informationen brauchen zu Kindergeld, Elterngeld, Elternzeit und anderen Leistungen.</li>\r\n \t<li>Sie im Falle einer Trennung Fragen haben, z.B. zum Umgang mit Ihrem Kind, dem Sorgerecht oder Unterhaltszahlungen.</li>\r\n \t<li>partnerschaftliche Konflikte entstanden sind und Sie als (werdende) Eltern gemeinsam mit dem Väterberater und einer Beraterin Lösungsmöglichkeiten besprechen möchten.</li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\nThemen: Vaterschaft, Geburt, Partnerschaft, Krisen, Trennung, Scheidung, gemeinsame Elternschaft u.v.m.";
            xyz:bundeslaender   "Nordrhein-Westfalen";
            xyz:email           "thomas.stihl@caritas-eu.de";
            xyz:id              "549";
            xyz:land            "Deutschland";
            xyz:name            "Esperanza Schwangerschaftsberatung /  Väterberatung";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-esperanza-schwangerschaftsberatung-vaeterberatung/";
            xyz:telefon         "0177 9565310";
            xyz:traeger         "Caritasverband Euskirchen";
            xyz:website         "https://caritas.erzbistum-koeln.de/euskirchen_cv/unsere-hilfen/kinder-jugend-familie/esperanza-hilfen-fuer-schwangere-familien/"
          ];
