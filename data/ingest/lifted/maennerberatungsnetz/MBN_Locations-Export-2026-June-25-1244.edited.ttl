            xyz:permalink       "https://maennerberatungsnetz.de/beratung/opferhilfebuero-hildesheim/";
            xyz:telefon         "495121968348";
            xyz:traeger         "Stiftung Opferhilfe Niedersachsen";
            xyz:website         "https://www.opferhilfe.niedersachsen.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_413>
