            xyz:telefon         "4954123907";
            xyz:traeger         "pro familia Landesverband Niedersachsen e.V.";
            xyz:website         "https://www.profamilia.de/angebote-vor-ort/niedersachsen/osnabrueck/beratungsangebot/maennerberatung"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_412>
          [ xyz:adresse         "Kaiserstraße 60, 31134 Hildesheim";
            xyz:beratungsarten  "Einzelberatung|Online-/ Telefonberatung|Opferberatung";
            xyz:beschreibung    "Die Stiftung Opferhilfe Niedersachsen unterstützt alle Opfer von Straftaten und deren Angehörige unabhängig von Alter, Geschlecht oder Herkunft, sofern sie in Niedersachsen leben oder die Tat dort stattgefunden hat. Das Angebot umfasst persönliche Beratung sowie die Möglichkeit einer vertraulichen und niedrigschwelligen Online-Beratung. Die Inanspruchnahme ist kostenlos, vertraulich und auf Wunsch anonym. Eine Kontaktaufnahme ist telefonisch möglich. Die Büros sind von Montag bis Freitag erreichbar. Termine werden nach telefonischer Anfrage individuell vergeben. Eine Strafanzeige ist nicht erforderlich, um die Beratung in Anspruch zu nehmen.";
            xyz:bundeslaender   "Niedersachsen";
            xyz:email           "poststellehildesheim@opferhilfe.niedersachsen.de";
            xyz:id              "14662";
