          [ xyz:adresse         "Friedrich-Ebert-Straße 53, 47799 Krefeld, Germany";
            xyz:beratungsarten  "Gesprächskreis / Selbsthilfegruppe|Treff";
            xyz:beschreibung    "Unser Angebot richtet sich an alle Väter, die Lust auf einen Austausch haben, Probleme in einer geschützten Umgebung mit anderen Vätern besprechen wollen und neue Ideen für Ihren Familienalltag suchen. Natürlich sprechen wir auch über Vereinbarkeit von Familie &amp; Beruf und leiten Unterstützung ein, wenn Väter in einer akuten Krise stecken! Mit dem Väter-Treff bieten wir einen sicheren und vertrauensvollen Ort zum Austausch unter Vätern an. Gemeinsam sorgen wir für Entlastung und finden neue Lösungsansätze. Das Angebot ist kostenlos und findet in den Räumen des Kinderschutzbund Krefeld e.V. statt.";
            xyz:bundeslaender   "Nordrhein-Westfalen";
            xyz:email           "post@vaterwelten.de";
            xyz:id              "381";
            xyz:land            "Deutschland";
            xyz:name            "Väter-Treff";
