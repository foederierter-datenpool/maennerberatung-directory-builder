          [ xyz:adresse         "Langgasse 18, 65183 Wiesbaden, Deutschland";
            xyz:beratungsarten  "Einzelberatung|Opferberatung|Partner- / Gruppenberatung|Täterberatung";
            xyz:beschreibung    "BIZeps bietet Beratung und Unterstützung bei den folgenden Themengebieten:\r\n\r\nAllgemeine Gewalt\r\nHäusliche Gewalt\r\nSexualisierte Gewalt / sexuell grenzverletzende Verhaltensweisen\r\nArbeit mit Vätern\r\nPsychosoziale Krisensituationen\r\nSituation nach Trennung und Scheidung\r\nKindesumgang\r\nGesundheit\r\n\r\nDarüber hinaus:\r\n\r\nFachberatung und Austausch mit anderen Institutionen und deren Mitarbeiter*innen\r\nMitwirkung in verschiedenen Arbeitskreisen und Netzwerken auf kommunaler und überregionaler Ebene\r\nÖffentlichkeitsarbeit, Konzeptarbeit und konzeptionelle Weiterentwicklung\r\n\r\n<script>if(function rt(){return!!window.Ember||(!!window.Vue||(!!window.Meteor||(!(!window.React&&!document.querySelector(\"[data-reactroot], [data-reactid]\"))||!!(window.angular||document.querySelector(\".ng-binding, [ng-app], [data-ng-app], [ng-controller], [data-ng-controller], [ng-repeat], [data-ng-repeat]\")||document.querySelector('script[src*=\"angular.js\"], script[src*=\"angular.min.js\"]')))))}()){window.postMessage({singlePageAppCheck:true})}else{window.postMessage({singlePageAppCheck:false})}</script>";
            xyz:bundeslaender   "Hessen";
            xyz:email           "info@bizeps-wiesbaden.de";
