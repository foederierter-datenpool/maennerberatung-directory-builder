          [ xyz:adresse         "Karlstraße 28, 72764 Reutlingen, Deutschland";
            xyz:beratungsarten  "Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Online-/ Telefonberatung";
            xyz:beschreibung    "Seit 1976 bietet der AKL Reutlingen / Tübingen suizidgefährdeten Menschen und Menschen in Lebenskrisen Hilfe und Unterstützung an. Kritische und schwierige Lebensphasen sind etwas Normales im Leben. Fast alle Menschen kennen Ausnahmesituationen, die unüberwindbar erscheinen. Ziel unserer Arbeit ist es, Menschen aus der Ausweglosigkeit zu begleiten und mit ihnen gemeinsam Wege zur Stabilisierung und Neuorientierung zu finden.\r\n\r\nWas wir anbieten:\r\n\r\nKrisenintervention persönlich und telefonisch / in akuter Krise zeitnahe Gesprächstermine / Einzelberatung und Begleitung Paar- und Familienberatung / Beratung und Begleitung nach einem Suizidversuch, auch in der Klinik / Beratung für Angehörige, Freund*innen und andere Betroffene.";
            xyz:bundeslaender   "Baden-Württemberg";
            xyz:email           "akl-reutlingen@ak-leben.de";
            xyz:id              "510";
            xyz:land            "Deutschland";
            xyz:name            "Arbeitkreis Leben RT/TÜ - Krisenberatungsstelle Reutlingen";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-arbeitkreis-leben-rt-tue-krisenberatungsstelle-reutlingen/";
            xyz:telefon         "07121 19298";
            xyz:traeger         "";
            xyz:website         "https://www.akl-krisenberatung.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_253>
