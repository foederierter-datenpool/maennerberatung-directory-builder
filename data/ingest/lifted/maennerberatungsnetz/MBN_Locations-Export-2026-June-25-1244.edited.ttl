          [ xyz:adresse         "Dieringhauser Str. 55, 51645 Gummersbach, Deutschland";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Psychologische Beratung";
            xyz:beschreibung    "In meiner Praxis biete ich ambulante Psychotherapie für Menschen ab 18 Jahren an. Ich habe meinen Behandlungsschwerpunkt auf männerspezifische Psychotherapie gelegt. Ebenso habe ich mich auf die Beratung in Bezug auf die Themen „männliche Rollenbilder“ und „männliche Identität“ spezialisiert. Auf <a href=\"https://www.psychotherapie-matthias-stinn.de\">www.psychotherapie-matthias-stinn.de</a> finden Sie ausführliche Informationen bezüglich des Behandlungsschwerpunkts, zu meiner Person sowie meiner Haltung.";
            xyz:bundeslaender   "Nordrhein-Westfalen";
            xyz:email           "psychotherapie.matthias.stinn@gmail.com";
            xyz:id              "564";
            xyz:land            "Deutschland";
            xyz:name            "Psychotherapeutische Praxis Matthias Stinn";
