          [ xyz:adresse         "Sandweg 114, 50827 Köln, Germany";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Psychologische Beratung";
            xyz:beschreibung    "Die Auswirkungen einer Partnerkrise oder einer Trennung können für Eltern und Kinder sehr belastend sein. Viele Väter fühlen sich hilflos, wütend oder verzweifelt und haben Sorge, dass der Kontakt zum Kind abbrechen könnte. In einer solchen Situation kann dir eine Beratung dabei helfen, die neue Situation besser zu bewältigen. Häufig geht es um die Klärung folgender Fragen:\r\nWie kann ich nach der Trennung meine elterliche Verantwortung wahrnehmen? Wie kann ich die Kommunikation mit der Mutter verbessern? Wie lässt sich die Umgangs- und Wohnsituation gestalten? Wie kann ich meine berufliche und persönliche Zukunft organisieren? In einer Coaching-Gruppe stärken sich Väter gegenseitig.\r\nKeine telefonische Beratung. Anmeldung nur per Online-Formular.";
            xyz:bundeslaender   "Nordrhein-Westfalen";
            xyz:email           "kontakt@koelnervaeter.de";
            xyz:id              "304";
            xyz:land            "Deutschland";
            xyz:name            "Väter in Köln e. V.";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-vaeter-in-koeln-e-v/";
            xyz:telefon         "+49 221 5101405";
            xyz:traeger         "Väter in Köln e. V.";
            xyz:website         "https://www.koelnervaeter.de"
          ];
