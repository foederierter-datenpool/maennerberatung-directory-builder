          [ xyz:adresse         "Metzer Straße 18, Stadtbezirk 1 40476 Düsseldorf, Germany";
            xyz:beratungsarten  "Einzelberatung|Partner- / Gruppenberatung";
            xyz:beschreibung    "Die esperanza Väterberatung bietet seit 2001 Beratung von Mann zu Mann für werdende und junge Väter, begleitet in Konflikt- und Krisensituationen, gibt Informationen zu rechtlichen Fragen, z.B. Elternzeit/Elterngeld, elterliche Sorge, Unterhalt und sozialrechtlichen Hilfen. Angeboten werden: Onlineberatung, Paargespräche, Kontakte zu Familienbildung und Väterinitiativen, eigene Väter-Kinder-Wochenenden, hey papa! für ganz junge Väter. Die Väterberatung kann bis zum 3. Lebensjahr des jüngsten Kindes in Anspruch genommen werden, ist kostenlos, unterliegt der Schweigepflicht und kann unabhängig von Religion oder Konfession genutzt werden.";
            xyz:bundeslaender   "Nordrhein-Westfalen";
            xyz:email           "esperanza@skfm-duesseldorf.de";
            xyz:id              "374";
            xyz:land            "Deutschland";
            xyz:name            "esperanza Väterberatung Düsseldorf";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-esperanza-vaeterberatung-duesseldorf/";
            xyz:telefon         "+49 211 4696240";
            xyz:traeger         "Sozialdienst katholischer Frauen und Männer Düsseldorf e.V.";
            xyz:website         "https://www.skfm-duesseldorf.de/de/esperanza-schwangerschaftsberatung/"
          ];
