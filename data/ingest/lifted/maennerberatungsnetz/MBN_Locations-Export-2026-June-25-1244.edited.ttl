          [ xyz:adresse         "Am Bürgerheim 7, 95030 Hof";
            xyz:beratungsarten  "Einzelberatung|Online-/ Telefonberatung";
            xyz:beschreibung    "Das Projekt Männer*Beratung Oberfranken ist ein Projekt des Vereins Schutzhöhle e.V. und richtet sich an Männer*, die in Ihrer Kindheit und Jugend sexualisierte Gewalt erfahren haben.\r\n\r\nWir bieten Betroffenen*, deren Angehörigen und Menschen aus dem sozialen Nahfeld betroffener Männer*, sowie Fachkräften aus dem Raum Oberfranken unsere Unterstützung und Beratung an.";
            xyz:bundeslaender   "Bayern";
            xyz:email           "info@maennerberatung-oberfranken.de";
            xyz:id              "1846";
            xyz:land            "Deutschland";
            xyz:name            "Männer*Beratung Oberfranken";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/maennerberatung-oberfranken/";
            xyz:telefon         "+49 92817798682";
            xyz:traeger         "Schutzhöhle e.V.";
            xyz:website         "https://www.xn--mnnerberatung-oberfranken-lec.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_341>
          [ xyz:adresse         "Bachenstr. 34, 79241 Ihringen";
            xyz:beratungsarten  "Einzelberatung|Opferberatung|Partner- / Gruppenberatung|Täterberatung";
            xyz:beschreibung    "„<strong>Männer haben keine Probleme – sie haben Lösungen</strong>.“ Aber: kein Mensch kann immer stark sein. Wer das von sich und Anderen erwartet, produziert fortlaufend Schwäche.\r\n\r\nIm Leben jedes Menschen kommt es zu Brüchen. Krankheit, Tod, Trennung, Wechsel der Arbeitsstelle oder des Wohnorts sind nur einige Beispiele. Die Frage ist: Wie gehen wir damit um? Brechen wir ein oder brechen wir auf?\r\n\r\n​Ich lade alle Männer ein, immer wieder aufzubrechen. Dabei biete ich meine Unterstützung an.";
            xyz:bundeslaender   "Baden-Württemberg";
            xyz:email           "info@jonas-muth.com";
            xyz:id              "1858";
            xyz:land            "Deutschland";
            xyz:name            "Beratung und Coaching- Muth(h) für Männer";
