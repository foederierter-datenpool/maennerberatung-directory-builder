          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_346>
          [ xyz:adresse         "Meckenheimer-Allee 67 - 69, 53115 Bonn";
            xyz:beratungsarten  "Einzelberatung|Gesprächskreis / Selbsthilfegruppe|Partner- / Gruppenberatung|Psychologische Beratung";
            xyz:beschreibung    "Angebote für Männer, die nach Austausch, Unterstützung und persönlicher Entfaltung suchen oder an bisherige Erfahrungen anknüpfen wollen.\r\nZu uns kommen Männer aller Altersstufen und Berufe. Neugierige oder skeptische Männer ebenso wie solche, die sich in akuten Krisen oder anderen stark herausfordernden Lebensphasen wiederfinden.\r\nSchau' Dich gerne um und wenn Du Fragen hast, melde Dich gerne bei uns.\r\n\r\n<strong>„Es ist unser Anliegen, den lebendigen Kontakt von Männern untereinander zu ermöglichen, zu fördern und zu vertiefen, auf das wir uns selbst und andere erkennen und begreifen.“</strong>\r\n\r\nMichael Krah &amp; Jörg Müller";
            xyz:bundeslaender   "Nordrhein-Westfalen";
            xyz:email           "info@maennerforum-bonn.de";
            xyz:id              "2367";
            xyz:land            "Deutschland";
            xyz:name            "Männerforum Bonn";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/maennerforum-bonn/";
            xyz:telefon         "+49 22850446280";
            xyz:traeger         "Michael Krah";
            xyz:website         "https://www.maennerforum-bonn.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_347>
          [ xyz:adresse         "Rudolf-Breitscheid-Str. 53, 14482 Potsdam";
            xyz:beratungsarten  "Coaching / Mentoring|Einzelberatung|Online-/ Telefonberatung|Psychologische Beratung";
            xyz:beschreibung    "In Einzelsitzungen biete ich Männern und Vätern in Zeiten von Übergängen, Krisen und Neuausrichtung die Möglichkeit der psychotherapeutischen oder beraterischen Begleitung. In Zusammenarbeit mit dem Netzwerk „Gesunde Kinder“ und dem Geburtshaus Apfelbaum gibt es von mir moderierte Angebote für Männer zum kostenlosen Austausch.\r\n\r\n“Die Väter- Gesprächswerkstatt“ bietet Raum um über Grenzen, Nähe, Respekt und Beziehungsgestaltung in den Austausch zu kommen. Gemeinsam können Idee entstehen, wie Vaterschaft gelingen kann. Väter aus allen Beziehungs- und Familienkonzepten sind willkommen.";
            xyz:bundeslaender   "Brandenburg";
            xyz:email           "info@christianwengler.de";
            xyz:id              "2433";
            xyz:land            "Deutschland";
            xyz:name            "Beratung und Psychotherapie für Männer und Väter";
            xyz:permalink       "https://maennerberatungsnetz.de/beratung/beratung-und-psychotherapie-fuer-maenner-und-vaeter/";
            xyz:telefon         "+49 17663302141";
            xyz:traeger         "Christian Wengler -  Praxis für Osteopathie und Psychotherapie";
            xyz:website         "https://www.christianwengler.de/"
          ];
  <http://www.w3.org/1999/02/22-rdf-syntax-ns#_348>
          [ xyz:adresse         "Goldhelg 20, 36341 Lauterbauch";
            xyz:beratungsarten  "Einzelberatung|Online-/ Telefonberatung|Opferberatung";
            xyz:beschreibung    "Wir sind eine Fachberatungsstelle für Menschen, die von körperlicher, seelischer, sexuelle Gewalt oder Stalking durch ihre Partner*innen/ Expartner*innen oder andere Personen in ihrem häuslichen Umfeld betroffen sind. Unser Angebot ist vertraulich, kostenfrei und auf Wunsch anonym.";
